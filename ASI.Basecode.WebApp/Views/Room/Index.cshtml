@*PWEDE NA NI IDELETE*@

@*



@model IEnumerable<ASI.Basecode.Services.ServiceModels.RoomViewModel>

@{
    ViewData["Title"] = "Admin Home Page";
}
<link rel="stylesheet" href="~/css/admin.css" />
<div class="outer-container">
    <div class="main-content">
        <div class="mytabs">

            <input type="radio" id="tabRoom" name="mytabs" onchange="loadTabContent('Room')" @((ViewData["ActiveTab"] as string == "Room") ? "checked" : "")>
            <label for="tabRoom">Room</label>

            <div class="tab" id="tabRoomContent">
                <h2>Room</h2>
                <div class="floor-buttons">
                    <button onclick="showRoomDetails('10th Floor')">
                        <i class='bx bxs-group'></i>
                        <span>10th Floor</span>
                    </button>
                    <button onclick="showRoomDetails('11th Floor')">
                        <i class='bx bxs-group'></i>
                        <span>11th Floor</span>
                    </button>
                    <button onclick="showRoomDetails('14th Floor')">
                        <i class='bx bxs-group'></i>
                        <span>14th Floor</span>
                    </button>
                </div>

                <div class="table-data">
                    <div class="order">
                        <div class="head">
                            <h3>Room Details</h3>

                            <div class="add-room">
                                <a href="@Url.Action("CreateRoom", "Admin")" class="btn btn-success">
                                    <i class='bx bx-plus'></i>
                                </a>
                            </div>
                            <div class="refresh">
                                <button class="btn btn-secondary btn-sm" onclick="refreshRoomDetails()">
                                    <i class='bx bx-refresh'></i>
                                </button>
                            </div>

                        </div>

                        <div class="scroll-container">
                            <table>
                                <thead>
                                    <tr>
                                        <th>
                                            @Html.DisplayNameFor(model => model.Id)
                                        </th>
                                        <th>
                                            @Html.DisplayNameFor(model => model.Name)
                                        </th>
                                        <th>
                                            @Html.DisplayNameFor(model => model.Type)
                                        </th>
                                        <th>
                                            @Html.DisplayNameFor(model => model.Capacity)
                                        </th>
                                        <th>
                                            @Html.DisplayNameFor(model => model.Location)
                                        </th>
                                        <th>
                                            @Html.DisplayNameFor(model => model.Facilities)
                                        </th>
                                        <th></th>
                                    </tr>
                                </thead>
                            </table>
                            <div class="table-scroll">
                                <table>
                                    <tbody id="room-details-body">
                                        @foreach (var item in Model)
                                        {
                                            <tr>
                                                <td>@Html.DisplayFor(modelItem => item.Id)</td>
                                                <td>@Html.DisplayFor(modelItem => item.Name)</td>
                                                <td>@Html.DisplayFor(modelItem => item.Type)</td>
                                                <td>@Html.DisplayFor(modelItem => item.Capacity)</td>
                                                <td>@Html.DisplayFor(modelItem => item.Location)</td>
                                                <td>@Html.DisplayFor(modelItem => item.Facilities)</td>
                                                <td>
                                                    @Html.ActionLink("Edit", "Edit", "Room", new { Id = item.Id }, new { @class = "btn btn-primary btn-sm" })
                                                    @Html.ActionLink("Details", "Details", "Room", new { Id = item.Id }, new { @class = "btn btn-info btn-sm" })
                                                    <button class="btn btn-danger btn-sm" onclick="showDeleteModal(@item.Id)">Delete</button>
                                                </td>
                                            </tr>
                                        }

                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<style>
    body {
    margin: 0;
    font-family: Arial, sans-serif;
    width: 100%;
    height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
    background-color: #000;
}

.outer-container {
    box-sizing: border-box;
    background-color: var(--light);
    padding: 10px;
    border-radius: 15px;
    display: flex;
    flex-direction: column-reverse;
    flex-direction: column;
    width: calc(100% - 215px);
    height: calc(100%-40px);
    top: 20px;
    right: 20px;
    bottom: 20px;
    margin-left: 100px;
    position: fixed;
    z-index: 0;
}


.main-content {
    height: 85vh;
    background-color: #185D62;
    padding: 20px;
    color: #fff;
    border-radius: 10px;
    width: 100%;
    box-sizing: border-box;
    flex-grow: 1;
}

.main-content nav {
    position: relative;
    height: 100px;
    width: calc(100%-300px);
    padding-left: 20px;
    padding-right: 20px;
}

/*ROOM nga styles*/
.mytabs {
    display: flex;
    flex-wrap: wrap;
    padding: 25px;
    background-color: transparent;
    display: flex;
    justify-content: left;
    margin-bottom: 20px;
    padding: 0px;
}

.mytabs input[type="radio"] {
    display: none;
}

.mytabs label {
    padding: 15px;
    background: #185D62;
    font-weight: bold;
    border-bottom: 2px solid #1BC7D2;
    width: 100px;
    text-align: center;
    cursor: pointer;
}

.mytabs .tab {
    width: 100%;
    padding: 20px;
    background: #185D62;
    order: 1;
    display: none;
}

.mytabs .tab h2 {
    font-size: 3em;
}

.mytabs input[type='radio']:checked + label + .tab {
    display: block;
}

.mytabs input[type="radio"]:checked + label {
    background: #1BC7D2;
}

.table-data {
    display: flex;
    flex-wrap: wrap;
    grid-gap: 24px;
    margin-top: 24px;
    width: 100%;
    color: var(--dark);
}

.table-data > div {
    border-radius: 20px;
    background: var(--light);
    padding: 10px;
    overflow-x: auto;
}

.table-data .head {
    display: flex;
    align-items: center;
    grid-gap: 0px;
    background-color: transparent;
    margin-bottom: 20px;
}

.add-room .refresh i {
    background-color: transparent;
}

.table-data .head h3 {
    margin-right: auto;
    font-size: 24px;
    font-weight: 600;
    padding: 10px;
}

.refresh {
    display: flex;
    justify-content: flex-end;
    padding-right: 10px;
}

.add-room {
    display: flex;
    justify-content: flex-end;
    padding-right: 10px;
}

    .add-room .btn-success {
        background-color: transparent;
        border: none;
        color: inherit; 
    }

.refresh .btn-secondary {
    background-color: transparent;
    border: none;
    color: inherit; 
}

.table-data .order {
    flex-grow: 1;
    flex-basis: 500px;
}

.scroll-container {
    max-height: 60vh; /* Set the maximum height for the scrollable area */
    overflow-y: auto;
    scrollbar-width: none;
    /* Hide scrollbar for IE, Edge, and Chrome */
    -ms-overflow-style: none;
}
/* Hide scrollbar for Chrome */
.scroll-container::-webkit-scrollbar {
    display: none;
}
        .table-scroll {
    max-height: 60vh; /* Adjust the maximum height as needed */
    overflow-y: auto;
}

.table-data .order table {
    width: 100%;
    border-collapse: collapse;
    background-color: white;
}

    .table-data .order table th,
    .table-data .order table td {
        padding: 12px 15px; /* Adjust padding as needed */
    }

    .table-data .order table th {
        font-size: 13px;
        text-align: left;
        border-bottom: 1px solid var(--grey);
    }

    .table-data .order table tr {
        line-height: 1.0; /* Adjust line-height for better row spacing */
        padding: 12px 15px;
    }

        .table-data .order table tr:hover {
            background: var(--grey);
        }


</style>*@