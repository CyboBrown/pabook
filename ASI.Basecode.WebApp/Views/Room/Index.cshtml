@model IEnumerable<ASI.Basecode.Services.ServiceModels.RoomViewModel>
﻿
@{
    ViewData["Title"] = "Rooms";
}

<h1>Rooms</h1>


<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Id)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Type)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Capacity)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Location)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Facilities)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Id)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Type)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Capacity)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Location)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Facilities)
                </td>
                
            </tr>
        }
    </tbody>
</table>

@*
<h1>Rooms</h1>
@{
    ViewData["Title"] = "Room Management";
}

<meta name="viewport" content="width=device-width, initial-scale=1.0">
<div class="outer-container">
    <div class="main-content">
        <div class="head-title">
            <div class="left">
                <h1>Room Management</h1>
            </div>
        </div>

        <div class="floor-buttons">
            <button onclick="showRoomDetails('floor10')">
                <i class='bx bxs-group'></i>
                <span>10th Floor</span>
            </button>
            <button onclick="showRoomDetails('floor11')">
                <i class='bx bxs-group'></i>
                <span>11th Floor</span>
            </button>
            <button onclick="showRoomDetails('floor14')">
                <i class='bx bxs-group'></i>
                <span>14th Floor</span>
            </button>

        </div>

        <div class="table-data">
            <div class="order">
                <div class="head">
                    <h3>Room Details</h3>

                    <div class="add-room">
                        <a href="@Url.Action("Create", "Room")" class="btn btn-success">
                            <i class='bx bx-plus'></i> Add
                        </a>
                    </div>

                    <div class="view-room">
                        <button id="detailsButton" class="btn btn-info btn-sm">
                            <i class='bx bx-info-circle'></i> Details
                        </button>
                    </div>
                    <div class="edit-room">
                        <button id="editButton" class="btn btn-warning btn-sm">
                            <i class='bx bx-edit'></i> Edit
                        </button>
                    </div>

                    <div class="delete-room">
                        
                            <button id="deleteButton" class="btn btn-danger btn-sm" onclick="showDeleteModal()">Delete</button>
                           
                    </div>

                    <button class="btn btn-secondary btn-sm" onclick="refreshPage()">
                        <i class='bx bx-refresh'></i> Refresh
                    </button>
                </div>
                <table>
                    <thead>
                        <tr>
                            <th>Select</th>
                            <th>ID</th>
                            <th>Type</th>                           
                            <th>Name</th>
                            <th>Location</th>
                            <th>Capacity</th>
                        </tr>
                    </thead>
                    <tbody id="room-details-body">
                        @foreach (var room in Model)
                        {
                            <tr>
                                <td>
                                    <input type="radio" name="selectedRoom" value="@room.Id" />
                                </td>
                                <td>@room.Id</td>
                                <td>@room.Type</td>
                                <td>@room.Name</td>
                                <td>@room.Location</td>
                                <td>@room.Capacity</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" role="dialog" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">Cancel Reservation?</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                Are you sure you want to cancel this one?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">No</button>
                <button type="button" class="btn btn-danger" onclick="confirmDelete()">Yes</button>
            </div>
        </div>
    </div>
</div>

<form id="deleteForm" asp-action="PostDelete" method="post" style="display:none;">
    <input type="hidden" id="RoomIdToDelete" name="RoomId" value="" />
</form>



@section Scripts {
   <script>
        toastr.options = {
            positionClass: "toast-top-center",
            timeOut: 5000,
            closeButton: true,
            progressBar: true
        };

        var successMessage = '@TempData["SuccessMessage"]';
        var addedRoom = '@TempData["AddedRoom"]';
        var successDeletion = '@TempData["SuccessDeletion"]';

        if (successMessage) {
            toastr.success(successMessage);
        }
        if (addedRoom) {
            toastr.success(addedRoom);
        }
        if (successDeletion) {
            toastr.success(successDeletion);
        }

        document.getElementById('detailsButton').addEventListener('click', function () {
            var selected = document.querySelector('input[name="selectedRoom"]:checked');
            if (selected) {
                var roomId = selected.value;
                window.location.href = '@Url.Action("Details", "Room")' + '?RoomId=' + roomId;
            } else {
                alert('Please select a room.');
            }
        });

        document.getElementById('editButton').addEventListener('click', function () {
            var selected = document.querySelector('input[name="selectedRoom"]:checked');
            if (selected) {
                var roomId = selected.value;
                window.location.href = '@Url.Action("Edit", "Room")' + '?RoomId=' + roomId;
            } else {
                alert('Please select a room.');
            }
        });

        function showDeleteModal() {
            var selected = document.querySelector('input[name="selectedRoom"]:checked');
            if (selected) {
                var roomId = selected.value;
                document.getElementById('RoomIdToDelete').value = roomId;
                $('#deleteModal').modal('show');
            } else {
                alert('Please select a room.');
            }
        }


        function confirmDelete() {
            document.getElementById('deleteForm').submit();
        }


        function refreshPage() {
            location.reload();
        }
   </script>
}


<style>
            .outer-container {
                width: 100%;
                background-color: var(--light);
                padding: 20px;
                border-radius: 20px;
                display: flex;
                flex-direction: column-reverse;
                flex-direction: column;
                width: calc(100% - 185px);
                height: 100vh;
                top: 20px;
                right: 0px;
                bottom: 10px;
                padding-top: 20px;
                margin-left: 100px;
                position: fixed;
                z-index: 1;
                transition: margin-right 0.3s ease, width 0.3s ease;
            }
              
            .main-content {
                background-color: #185D62;
                padding: 15px;
                border-radius: 10px;
                z-index: 2;
            }

            .main-content .head-title {
                display: flex;
                font-weight: bold;
                align-items: center;
                justify-content: space-between;
                flex-wrap: wrap;
                align-content: center;
                padding: 6px;
                color: #fff;
                flex-grow: 1;
                max-width: calc(100% - 80px);
            }

            .table-data {
                display: flex;
                flex-wrap: wrap;
                grid-gap: 24px;
                margin-top: 24px;
                width: 100%;
                color: var(--dark);
            }

                .table-data > div {
                    border-radius: 20px;
                    background: var(--light);
                    padding: 24px;
                    overflow-x: auto;
                }

                .table-data .head {
                    display: flex;
                    align-items: center;
                    grid-gap: 16px;
                    margin-bottom: 24px;
                }

                .table-data .add-room {
                    background-color: var(--blue);
                    border-radius: 5px;
                    font-size: 10px;
                }

                .table-data .add-room a {
                    border-radius: 5px;
                    font-size: 10px;
                }

                .table-data .head h3 {
                    margin-right: auto;
                    font-size: 24px;
                    font-weight: 600;
                }

                .table-data .order {
                    flex-grow: 1;
                    flex-basis: 500px;
                }

                .table-data .order table {
                    width: 100%;
                    border-collapse: collapse;
                }

                .table-data .order table th {
                    padding-bottom: 12px;
                    font-size: 13px;
                    text-align: left;
                    border-bottom: 1px solid var(--grey);
                }

                .table-data .order table td {
                    padding: 16px 0;
                }

                .table-data .order table tr td:first-child {
                    display: flex;
                    align-items: center;
                    grid-gap: 12px;
                    padding-left: 6px;
                }

                .table-data .order table td img {
                    width: 36px;
                    height: 36px;
                    border-radius: 50%;
                    object-fit: cover;
                }

                .table-data .order .room-details-body tr:hover {
                    background: var(--grey);
                }

</style>*@

﻿
