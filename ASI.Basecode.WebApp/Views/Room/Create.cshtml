@*Room Script
<script>
    document.addEventListener("DOMContentLoaded", function () {
        // Function to load rooms from API and populate the table
        function loadRooms() {
            fetch('/api/Room/rooms')
                .then(response => response.json())
                .then(data => {
                    const tableBody = document.getElementById('roomsTableBody');
                    tableBody.innerHTML = ''; // Clear previous data

                    data.forEach(room => {
                        const row = document.createElement('tr');
                        row.innerHTML = `
                                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">${room.name}</td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${room.type}</td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${room.capacity}</td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${room.location}</td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${room.facilities}</td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                                        <button class="edit-room-btn text-blue-600 hover:text-blue-900 mr-2" data-id="${room.id}">Edit</button>
                                        <button class="details-room-btn text-green-600 hover:text-green-900 mr-2" data-id="${room.id}">Details</button>
                                        <button class="delete-room-btn text-red-600 hover:text-red-900" data-id="${room.id}">Delete</button>
                                    </td>
                                `;
                        tableBody.appendChild(row);
                    });

                    // Add event listeners to the new buttons (assuming these are for editing, details, and deletion)
                    document.querySelectorAll('.edit-room-btn').forEach(btn => {
                        btn.addEventListener('click', () => editRoom(btn.dataset.id));
                    });
                    document.querySelectorAll('.details-room-btn').forEach(btn => {
                        btn.addEventListener('click', () => showRoomDetails(btn.dataset.id));
                    });
                    document.querySelectorAll('.delete-room-btn').forEach(btn => {
                        btn.addEventListener('click', () => deleteRoom(btn.dataset.id));
                    });
                })
                .catch(error => console.error('Error fetching rooms:', error));
        }
        loadRooms();
        // Room form submission
        roomForm.addEventListener('submit', function (e) {
            e.preventDefault();

            if (!validateRoomForm()) {
                alert('Please fill in all required fields.');
                return;
            }

            const formData = new FormData(this);
            const data = {

                roomName: formData.get('name'),
                roomFacilities: formData.get('facilities'),
                roomCapacity: parseInt(formData.get('capacity')),
                roomType: parseInt(formData.get('type')),
                roomLocation: formData.get('location')
            };

            const submitButton = this.querySelector('button[type="submit"]');
            submitButton.disabled = true;
            submitButton.textContent = 'Submitting...';

            const url = this.dataset.mode === 'edit'
                ? `/api/Room/${this.dataset.roomId}`
                : '/api/Room/create';
            const method = this.dataset.mode === 'edit' ? 'PUT' : 'POST';

            fetch(url, {
                method: method,
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(data)
            })
                .then(response => {
                    if (!response.ok) {
                        return response.json().then(err => { throw err; });
                    }
                    return response.json();
                })
                .then(result => {
                    console.log('Room ' + (this.dataset.mode === 'edit' ? 'updated' : 'created') + ':', result);
                    roomModal.style.display = "none";
                    loadRooms(); // Function to refresh room list
                    roomForm.reset();

                    // Reset form mode and submit button text
                    this.dataset.mode = 'create';
                    delete this.dataset.roomId;
                    submitButton.textContent = 'Create Room';

                    alert(this.dataset.mode === 'edit' ? 'Room updated successfully!' : 'Room created successfully!');
                })
                .catch(error => {
                    console.error('Error ' + (this.dataset.mode === 'edit' ? 'updating' : 'creating') + ' room:', error);
                    let errorMessage = 'An error occurred while ' + (this.dataset.mode === 'edit' ? 'updating' : 'creating') + ' the room. Please try again.';
                    if (error.errors) {
                        errorMessage += '\n\nDetails:\n' + JSON.stringify(error.errors, null, 2);
                    }
                    alert(errorMessage);
                })
                .finally(() => {
                    submitButton.disabled = false;
                    submitButton.textContent = this.dataset.mode === 'edit' ? 'Update Room' : 'Create Room';
                });
        });



        // Function to handle editing a room (placeholder)
        function editRoom(roomId) {
            console.log(`Edit room with ID: ${roomId}`);
            // Implement edit room functionality here
        }

        // Function to handle showing room details (placeholder)
        function showRoomDetails(roomId) {
            console.log(`Show details for room with ID: ${roomId}`);
            // Implement show room details functionality here
        }

        // Function to handle deleting a room (placeholder)
        function deleteRoom(roomId) {
            console.log(`Delete room with ID: ${roomId}`);
            // Implement delete room functionality here
        }

        // Initial load of rooms on page load
        loadRooms();

        // Add event listener for refresh button
        document.getElementById('refreshRoomsButton').addEventListener('click', loadRooms);

        // Event listener for opening the add room modal
        document.getElementById('addRoomButton').addEventListener('click', function () {
            var roomModal = document.getElementById("addRoomModal");
            roomModal.style.display = "block";
            document.getElementById('roomForm').reset(); // reset form fields
        });

        // Event listener for closing the modal
        document.querySelector('.close').addEventListener('click', function () {
            var roomModal = document.getElementById("addRoomModal");
            roomModal.style.display = "none";
        });

        // Event listener for submitting the add room form
        document.getElementById('roomForm').addEventListener('submit', function (event) {
            event.preventDefault(); // Prevent default form submission

            // Perform form validation if needed

            // Fetch POST request to add room to backend
            fetch('/api/Room/create', { // Ensure the endpoint matches your API
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    roomName: document.getElementById('name').value,
                    roomType: document.getElementById('type').value,
                    capacity: document.getElementById('capacity').value,
                    location: document.getElementById('location').value,
                    facilities: document.getElementById('facilities').value
                })
            })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        var roomModal = document.getElementById("addRoomModal");
                        roomModal.style.display = "none";

                        // Reload rooms to reflect the new addition
                        loadRooms();
                    } else {
                        console.error(data.message);
                        // Handle error
                    }
                })
                .catch(error => console.error('Error adding room:', error));
        });

        // Open/close the room modal
        var roomModal = document.getElementById("addRoomModal");
        var roomBtn = document.getElementById("addRoomButton");
        var span = roomModal.getElementsByClassName("close")[0];

        roomBtn.onclick = function () {
            roomModal.style.display = "block";
            document.getElementById('roomForm').reset(); // reset button
        }

        span.onclick = function () {
            roomModal.style.display = "none";
        }

        window.onclick = function (event) {
            if (event.target == roomModal) {
                roomModal.style.display = "none";
            }
        }
    });
</script>*@