                    text-align: center;
                    color: #ecf0f1;
                    margin-bottom: 20px;
                    font-size: 2.5rem;
                    font-weight: 600;
                }

        .white-container {
            background-color: white;
            color: #185D62;
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 20px;
        }

            .white-container p {
                margin-bottom: 10px;
                line-height: 1.6;
                font-size: 1em;
            }

            .white-container strong {
                font-weight: 600;
            }
    </style>
}



