@{
    ViewData["Title"] = "Calendar";
}
<div class="outer-container">
    <div class="main-content">
        <div class="calendar-container">
            <h1>Calendar</h1>
            ////Implementation here 
        </div>
    </div>
</div>

@section Styles {
    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            width: 100%;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
            background-color: #000;
        }

        .outer-container {
            box-sizing: border-box;
            background-color: var(--light);
            padding: 10px;
            border-radius: 15px;
            display: flex;
            flex-direction: column-reverse;
            flex-direction: column;
            width: calc(100% - 265px);
            height: calc(100%-40px);
            top: 20px;
            right: 20px;
            bottom: 20px;
            margin-left: 100px;
            position: fixed;
            z-index: 0;
        }

        .main-content {
            height: 85vh;
            background-color: #185D62;
            padding: 20px;
            color: #fff;
            border-radius: 10px;
            width: 100%;
            box-sizing: border-box;
            display: flex;
            justify-content: center;
            align-items: center;

            flex-grow: 1;
        }

        .calendar-container {
            width: 100%;
            height: 100%;
            max-width: 800px;
            max-height: 600px;
            background-color: #1A7275;
            border-radius: 10px;
            padding: 20px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
            color: #fff;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
        }

        h1 {
            font-size: 36px;
            font-weight: 500;
            margin-top: 0;
            margin-bottom: 20px;
            letter-spacing: 0.5px;
            text-align: center;
        }

        .calendar {
            width: 100%;
            height: 100%;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .calendar-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

            .calendar-header button {
                background-color: transparent;
                border: none;
                color: #fff;
                font-size: 24px;
                cursor: pointer;
            }

            .calendar-header .current-month {
                font-size: 18px;
                font-weight: bold;
            }

        .calendar-body {
            display: flex;
            flex-direction: column;
        }

        .day-names {
            display: flex;
            justify-content: space-between;
            margin-bottom: 10px;
        }

            .day-names div {
                flex: 1;
                text-align: center;
                font-weight: bold;
            }

        .dates {
            display: flex;
            flex-wrap: wrap;
            flex-grow: 1;
        }

            .dates .date {
                width: calc(100% / 7);
                text-align: center;
                padding: 10px 0;
                box-sizing: border-box;
            }

                .dates .date.active {
                    border: 1px solid #fff;
                    border-radius: 50%;
                }
    </style>
}
