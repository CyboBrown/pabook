@model ASI.Basecode.Services.ServiceModels.PreferenceViewModel
@{
    ViewData["Title"] = "User Settings";
    var userRole = Context.Session.GetString("Role");
}

<body class="@((Model != null && Model.DarkMode) ? "light" : "dark")">
    <link rel="stylesheet" href="~/css/admin.css" />
    <link rel="stylesheet" href="~/css/admindark.css" id="theme-style" />

    <form id="preferencesForm" method="post">
        <div class="message-container" id="messageContainer"></div> <!-- Message container -->
        <div class="outer-container">
            <div class="main-content">
                <h1 style="font-size: 1.5rem;text-align: center;">Account Settings</h1>
                
                <div class="settings-section">
                    <div class="profile-section">
                        <div class="profile-pic">
                            <img id="profilePicture" src="~/img/user.jpg" alt="Profile Picture" />

                        </div>
                        
                        <div class="profile-info">
                            <span class="user-name ml-2 overflow-hidden">@HttpContextAccessor.HttpContext.Session.GetString("FullName")</span>
                            <span class="user-email ml-2 overflow-hidden">@HttpContextAccessor.HttpContext.Session.GetString("Email")</span>
                            @*<div class="user-details">
                                <span class="user-name ml-2 overflow-hidden">@HttpContextAccessor.HttpContext.Session.GetString("FullName")</span>
                                <span class="user-email ml-2 overflow-hidden">@HttpContextAccessor.HttpContext.Session.GetString("Email")</span>
                            </div>
                            <span class="profile-status">@((HttpContextAccessor.HttpContext.Session.GetString("Email") ?? ""))</span>*@
                        </div>
                    </div>
                    <div class="setting">
                        <span>Switch to Light Mode</span>
                        <label id="dark-change" class="toggle-switch">
                            <input type="checkbox" name="DarkMode" value="true" @(Model?.DarkMode ?? false? "checked" : "")>
                            <span class="slider"></span>
                        </label>
                    </div>

                    <div class="setting-group">
                        <h2>Booking Duration</h2>
                        <div class="setting">
                            <span>Time Format</span>
                            <select class="time-select" name="TimeFormat">
                                <option value="24" selected="@(Model?.TimeFormat == 24 ? "selected" : null)">24 - hour</option>
                                <option value="12" selected="@(Model?.TimeFormat == 12 ? "selected" : null)">12 - hour</option>
                            </select>
                        </div>
                        <div class="setting">
                            <span>Default Booking Duration</span>
                            <select class="time-select" name="DefaultBookingDuration">
                                <option value="30" selected="@(Model?.DefaultBookingDuration == 30 ? "selected" : null)">30 - minutes</option>
                                <option value="60" selected="@(Model?.DefaultBookingDuration == 60 ? "selected" : null)">60 - minutes</option>
                                <option value="90" selected="@(Model?.DefaultBookingDuration == 90 ? "selected" : null)">90 - minutes</option>
                            </select>
                        </div>
                    </div>
                    <div class="action-buttons">
                        <button type="submit" class="save-button">Save Changes</button>
                    </div>
                </div>
            </div>
        </div>
    </form>
    

    <script>       
        //Fetch and preference sa user from the db
        document.addEventListener('DOMContentLoaded', function () {
            fetchPreferences();

            var userId = '@HttpContextAccessor.HttpContext.Session.GetString("UserId")';
            sessionStorage.setItem('UserId', userId);            
        });

        function fetchPreferences() {
            const userId = sessionStorage.getItem('UserId');
            if (!userId) {
                console.error('User ID not found in session storage.');
                return;

            }

            fetch(`/api/Preference/myPreferences?userId=${userId}`)
                .then(response => {
                    if (!response.ok) {
                        throw new Error('Network response was not ok');
                    }
                    return response.json();
                })
                .then(data => {
                    console.log('Fetched preferences data:', data);

                    if (Array.isArray(data) && data.length === 0) {
                        console.log('No preferences found. Setting default values or handling empty state.');
                        // Handle case when no preferences are found (perhaps set defaults)
                    } else if (typeof data === 'object') {
                        // Update UI based on fetched preferences
                        document.querySelector('input[name="DarkMode"]').checked = data.darkMode;
                        document.querySelector('select[name="TimeFormat"]').value = data.timeFormat.toString(); // Convert to string
                        document.querySelector('select[name="DefaultBookingDuration"]').value = data.defaultBookingDuration.toString(); // Convert to string

                        // Store preferences including TimeFormat and DefaultBookingDuration in session storage
                        const preferences = {
                            darkMode: data.darkMode,
                            timeFormat: data.timeFormat,
                            defaultBookingDuration: data.defaultBookingDuration
                        };
                        sessionStorage.setItem('userPreferences', JSON.stringify(preferences));

                        // Apply theme based on preferences
                        applyTheme(data.darkMode);
                    } else {
                        console.error('Unexpected data format:', data);
                    }
                })
                .catch(error => console.error('Error fetching preferences:', error));
        }



        const darkModeToggle = document.querySelector('#dark-change input');
        darkModeToggle.addEventListener('change', function () {
            const theme = this.checked ? 'light' : 'dark';
            document.body.className = theme;
            const preferences = JSON.parse(sessionStorage.getItem('userPreferences')) || {};
            preferences.darkMode = this.checked;
            sessionStorage.setItem('userPreferences', JSON.stringify(preferences));
            
        });
        //DarkMode and LightMode
        function applyTheme(isDarkMode) {
            const body = document.body;
            if (isDarkMode) {
                body.classList.add('light');
                body.classList.remove('dark');
                loadTheme('user.css'); //CSS file for light mode
            } else {
                body.classList.add('dark');
                body.classList.remove('light');
                loadTheme('admindark.css'); //CSS file for light mode
            }
        }

        function loadTheme(themeName) {
            const themeStyle = document.getElementById('theme-style');
            if (themeStyle) {
                themeStyle.setAttribute('href', `/css/${themeName}`);
            } else {
                console.error('Theme style link element not found');
            }
        }

        function displaySuccessMessage() {
            const messageContainer = document.getElementById('messageContainer');
            messageContainer.textContent = 'Changes Saved!';
            messageContainer.style.display = 'block';

            setTimeout(() => {
                messageContainer.style.display = 'none';
            }, 3000);
        }

        function updateUIFromPreferences(preferences) {
            console.log('Updating UI with preferences:', preferences);

            // Assuming preferences is an array and we are interested in the first element
            const preference = preferences[0];

            const darkModeInput = document.querySelector('input[name="DarkMode"]');
            if (darkModeInput) {
                darkModeInput.checked = preferences.darkMode;
            }
            const timeFormatSelect = document.querySelector('select[name="TimeFormat"]');
            if (timeFormatSelect) {
                timeFormatSelect.checked = preferences.timeFormat;
            }

            const defaultBookingDurationSelect = document.querySelector('select[name="DefaultBookingDuration"]');
            if (defaultBookingDurationSelect) {
                defaultBookingDurationSelect.checked = preferences.defaultBookingDuration;
            }

            applyTheme(preferences.darkMode);
        }

        // Function to handle form submission
        document.getElementById('preferencesForm').addEventListener('submit', function (event) {
            event.preventDefault(); // Prevent default form submission
            savePreferences();
        });
        //Save Changes Button nga function
        function savePreferences() {
            const preferences = {
                Id: parseInt(sessionStorage.getItem('UserId')),
                darkMode: document.querySelector('input[name="DarkMode"]').checked,
                //enableNotifications: document.querySelector('select[name="EnableNotifications"]').value === "true",
                timeFormat: parseInt(document.querySelector('select[name="TimeFormat"]').value),
                defaultBookingDuration: parseInt(document.querySelector('select[name="DefaultBookingDuration"]').value)
            };

            fetch('/api/Preference/save', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(preferences)
            })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        console.log('Preferences saved successfully.');
                        applyTheme(preferences.darkMode);
                        displaySuccessMessage();
                    } else {
                        console.error('Failed to save preferences:', data.message);
                    }
                })
                .catch(error => console.error('Error saving preferences:', error));
        }

        function updateUIAndSessionFromPreferences(preferences) {
            // Update UI based on preferences
            updateUIFromPreferences([preferences]);

            // Store preferences in session storage
            sessionStorage.setItem('userPreferences', JSON.stringify([preferences]));

            console.log('Preferences updated in UI and session storage:', preferences);
        }
        document.addEventListener("DOMContentLoaded", function () {
            function adjustFontSize() {
                const zoomLevel = Math.round(window.devicePixelRatio * 100);
                const rootFontSize = 16 * window.devicePixelRatio;
                document.documentElement.style.fontSize = `${rootFontSize}px`;

                const weight = zoomLevel > 100 ? "bold" : "normal";
                document.body.style.fontWeight = weight;

                // Exclude sidebar from being resizable
                const sidebar = document.querySelector(".sidebar");
                if (sidebar) {
                    sidebar.style.width = "265px"; // Ensure the sidebar width stays fixed
                    sidebar.style.fontSize = "initial"; // Reset sidebar font size
                }
            }

            window.addEventListener("resize", adjustFontSize);
            adjustFontSize(); // Initial call
        });


    </script>
</body>
@functions {
    private string GetProfilePictureUrl(string role)
    {
        switch (role)
        {
            case "admin":
                return "/img/admin.jpg";
            case "manager":
                return "/img/manager.jpg";
            default:
                return "/img/user.jpg";
        }
    }
}

