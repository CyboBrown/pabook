@model ASI.Basecode.Services.ServiceModels.BookingViewModel
<link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
<link href="https://unpkg.com/flowbite@1.4.7/dist/flowbite.min.css" rel="stylesheet">

@{
    ViewData["Title"] = "User Home Page";
}
<div class="outer-container">
    <div class="main-content">
        <div class="header">
            <div id="addBookingTab" class="tab active" onclick="switchTab('addBooking')">
                <i class="fas fa-plus"></i>
                <span>Add Booking</span>
            </div>
            <div id="myBookingsTab" class="tab" onclick="switchTab('myBookings')">
                <i class="fas fa-calendar-check"></i>
                <span>My Bookings</span>
            </div>
        </div>
        <div id="addBookingContent" class="content flex">
            <div class="left-pane">
                <div class="background-image">
                    <div class="overlay">
                        <div class="date-time">
                            <span id="time-now" class="time-now"></span><br>
                            <span id="date-now" class="date-now"></span>
                        </div>
                        <div class="book-now">
                            <button>Book now</button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="right-pane">
                <div class="booking-info">
                    <h1 class="text-3xl font-bold mb-4">Today's Booking</h1>
                    <div class="overflow-x-auto">
                        <div class="max-h-96 overflow-y-auto">
                            <table class="min-w-full bg-white border border-gray-200 rounded-lg">
                                <thead class="bg-gray-50">
                                    <tr>
                                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Time</th>
                                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Title</th>
                                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Room</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody id="bookingItems" class="divide-y divide-gray-200">
                                      
                                </tbody>
                            </table>
                        </div>
                    </div>

                </div>
            </div>
        </div>
        <div id="myBookingsContent" class="content hidden">
            <div class="container mx-auto p-4 bg-gray-100" style="height: 79vh;">
                <h2 class="text-3xl font-bold mb-4 text-gray-800">My Bookings</h2>
                <div class="flex flex-col sm:flex-row justify-between items-center mb-6 space-y-4 sm:space-y-0">
                    <input type="text" id="searchBar" class="w-full sm:w-2/3 p-2 border border-gray-300 rounded-md shadow-sm focus:ring-2 focus:ring-blue-400 focus:border-blue-400" placeholder="Search...">
                    <button id="filterButton" class="w-full sm:w-auto sm:ml-4 px-4 py-2 bg-blue-600 text-white rounded-md flex items-center justify-center hover:bg-blue-700 transition duration-300 ease-in-out">
                        <i class="fas fa-filter mr-2"></i>
                        Filter
                    </button>
                </div>
                <div class="bg-white shadow-lg rounded-lg overflow-hidden">
                    <div class="table-container" style="overflow-x: auto; max-height: calc(79vh - 10rem);">
                        <table class="min-w-full max-w-full divide-y divide-gray-200">
                            <thead class="bg-gray-50">
                                <tr>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Booking Name</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date & Time</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Room</th>
                                    <th class="px-2 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Recurring</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="bookingsTableBody" class="bg-white divide-y divide-gray-200">
                                <!-- ari ang mga bookings ma display -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<div id="addMeetingModal" class="modal">
    <div class="modal-content">
        <span class="close">&times;</span>
        <h1 style="font-size: 2.5rem;">Booking Form</h1>
        <form id="bookingForm">
            <div class="form-group full-width">
                <label for="title">Title:</label>
                <input type="text" id="title" name="title" required>
            </div>

            <div class="form-group full-width">
                <label for="description">Description:</label>
                <input type="text" id="description" name="description">
            </div>

            <div class="form-group">
                <label for="date">Date:</label>
                <input type="date" id="date" name="date" required>
            </div>

            <div class="form-group">
                <label for="room">Room:</label>
                <select id="room" name="room" required>
                    <option value="">Select a room</option>
                </select>
            </div>

            <div class="form-group">
                <label for="startTime">Start Time:</label>
                <input type="time" id="startTime" name="startTime" required>
            </div>

            <div class="form-group">
                <label for="endTime">End Time:</label>
                <input type="time" id="endTime" name="endTime" required>
            </div>

            <div class="form-group full-width">
                <label for="recurring">Recurring:</label>
                <select id="recurring" name="recurring">
                    <option value="false">No</option>
                    <option value="true">Yes</option>
                </select>
            </div>

            <div id="recurrenceOptions" class="full-width" style="display: none;">
                <div class="form-group-half">
                    <label for="recurrenceType">Recurrence Type:</label>
                    <select id="RecurrenceTypeId" name="RecurrenceTypeId" class="form-control">
                        <option value="">Select Recurrence Type</option>
                    </select>
                </div>

                <div class="form-group-half">
                    <label for="recurrenceEndDate">Recurrence End Date:</label>
                    <input type="date" id="recurrenceEndDate" name="recurrenceEndDate">
                </div>
            </div>

            <div class="form-group full-width">
                <button type="submit">Create Booking</button>
                <button type="reset" class="reset-button">Reset</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal for details -->
<div id="bookingDetailsModal" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center hidden">
    <div class="bg-gray-400 p-6 rounded-lg shadow-xl max-w-md w-full text-white font-sans relative">
        <button id="closeModalBtn" class="absolute top-2 right-2 text-white hover:text-gray-300">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
        </button>
        <h3 class="text-xl font-semibold mb-4">Booking Details</h3>
        <div id="bookingDetailsContent"></div>
    </div>
</div>



<script>
    //fetching karon nga bookings
    //document.addEventListener('DOMContentLoaded', function () {
    //    fetchTodaysBookings();
    //    // Refreshes kada 1 sec
    //    setInterval(fetchTodaysBookings, 100000);
    //});
    //fetchTodaysBookings();


    function fetchTodaysBookings() {
        fetch('/api/Booking/todaysBookings')
            .then(response => response.json())
            .then(data => {
                // Sort bookings by start time
                data.sort((a, b) => a.startTime.localeCompare(b.startTime));

                const bookingItemsContainer = document.getElementById('bookingItems');
                bookingItemsContainer.innerHTML = ''; // Clear existing items

                data.forEach(booking => {
                    //console.log("Today's Bookings ID No. " + booking.id);
                    const bookingItem = document.createElement('tr');
                    bookingItem.classList.add('booking-item');
                    bookingItem.innerHTML = `
                        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">${formatTime(booking.startTime)}</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${booking.title}</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${booking.roomName}</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                            <button class="details-btn text-green-600 hover:text-green-900" data-id="${booking.id}">
                                <i class="fas fa-info-circle"></i>Details
                            </button>
                        </td>
                    `;
                    bookingItemsContainer.appendChild(bookingItem);
                });
            })
            .catch(error => console.error('Error fetching bookings:', error));
    }


    function formatTime(timeString) {
        const [hours, minutes] = timeString.split(':');
        let hoursInt = parseInt(hours);
        const ampm = hoursInt >= 12 ? 'PM' : 'AM';
        hoursInt = hoursInt % 12 || 12; // Convert to 12-hour format
        return `${hoursInt}:${minutes} ${ampm}`;
    }

    function updateDateTime() {
        const now = new Date();

        // pag update sa time
        const timeElement = document.getElementById('time-now');
        const currentTime = now.toTimeString().slice(0, 5); // HH:MM
        timeElement.textContent = formatTime(currentTime);

        // pag update sa day
        const dateElement = document.getElementById('date-now');
        dateElement.textContent = now.toLocaleString('en-US', {
            weekday: 'long',
            month: 'long',
            day: 'numeric'
        });
    }

    //real time update sa time and date 
    updateDateTime();
    setInterval(updateDateTime, 1000);

    document.addEventListener("DOMContentLoaded", function () {
        // Fetch rooms and populate the select element
        fetch('/api/Booking/rooms')
            .then(response => response.json())
            .then(data => {
                const roomSelect = document.getElementById('room');
                data.forEach(room => {
                    const option = document.createElement('option');
                    option.value = room.id;
                    option.text = room.name;
                    roomSelect.appendChild(option);
                });
            })
            .catch(error => console.error('Error fetching rooms:', error));

        //For fetching recurr types
        function populateRecurrenceTypes() {
            $.ajax({
                url: '/api/Booking/recurrenceTypes',
                type: 'GET',
                success: function (data) {
                    var dropdown = $('#RecurrenceTypeId');
                    dropdown.empty();
                    dropdown.append($('<option></option>').val('').text('Select Recurrence Type'));
                    $.each(data, function (i, item) {
                        dropdown.append($('<option></option>').val(item.id).text(item.name));
                    });
                },
                error: function (error) {
                    console.log('Error fetching recurrence types:', error);
                }
            });
        }

        // Call this function when the page loads
        $(document).ready(function () {
            populateRecurrenceTypes();
        });


        // Add form validation
        function validateForm() {
            const requiredFields = bookingForm.querySelectorAll('[required]');
            let isValid = true;
            requiredFields.forEach(field => {
                if (!field.value.trim()) {
                    isValid = false;
                    field.classList.add('invalid');
                } else {
                    field.classList.remove('invalid');
                }
            });
            return isValid;
        }

        // format time to TimeSpan string
        function formatTimeToTimeSpan(timeString) {
            const [hours, minutes] = timeString.split(':');
            return `${hours.padStart(2, '0')}:${minutes}:00`;
        }

        const bookingForm = document.getElementById('bookingForm');
        const submitButton = bookingForm.querySelector('button[type="submit"]');

        function loadBookings() {
            fetch('/api/Booking/myBookings')
                .then(response => {
                    if (!response.ok) {
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }
                    return response.json();
                })
                .then(data => {
                    const tableBody = document.getElementById('bookingsTableBody');
                    tableBody.innerHTML = '';
                    data.forEach(booking => {
                        console.log("My Bookings ID No. " + booking.id);
                        const row = document.createElement('tr');
                        row.innerHTML = `
                        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">${booking.title}</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${new Date(booking.date).toLocaleDateString()} ${booking.startTime} - ${booking.endTime}</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${booking.roomName}</td>
                        <td class="px-3 py-4 whitespace-nowrap text-sm text-gray-500">
                            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full ${booking.recurring ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800'}">
                                ${booking.recurring ? 'Yes' : 'No'}
                            </span>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                            <button class="edit-btn text-blue-600 hover:text-blue-900 mr-2" data-id="${booking.id}">Edit</button>
                            <button class="details-btn text-green-600 hover:text-green-900 mr-2" data-id="${booking.id}">Details</button>
                            <button class="cancel-btn text-red-600 hover:text-red-900" data-id="${booking.id}">Cancel</button>
                        </td>
                    `;
                        tableBody.appendChild(row);
                    });

                    // Add event listeners to the new buttons
                    document.querySelectorAll('.edit-btn').forEach(btn => {
                        btn.addEventListener('click', () => editBooking(btn.dataset.id));
                    });
                    document.querySelectorAll('.details-btn').forEach(btn => {
                        btn.addEventListener('click', () => showBookingDetails(btn.dataset.id));
                    });
                    document.querySelectorAll('.cancel-btn').forEach(btn => {
                        btn.addEventListener('click', () => cancelBooking(btn.dataset.id));
                    });
                })
                .catch(error => console.error('Error fetching bookings:', error));
        }

        // i laod ang bookings
        fetchTodaysBookings();
        loadBookings();

        // Form submission
        bookingForm.addEventListener('submit', function (e) {
            e.preventDefault();

            if (!validateForm()) {
                alert('Please fill in all required fields.');
                return;
            }

            const formData = new FormData(this);
            const startTime = formData.get('startTime');
            const endTime = formData.get('endTime');
            const date = formData.get('date');

            // Validate date is not before the current date
            const currentDate = new Date().toISOString().split('T')[0];
            if (date < currentDate) {
                alert('Selected date cannot be in the past.');
                return;
            }

            // Validate start time is not before the current time if booking is for today
            const currentDateTime = new Date();
            const selectedDateTime = new Date(`${date}T${startTime}`);
            if (date === currentDate && selectedDateTime < currentDateTime) {
                alert('Start time cannot be in the past.');
                return;
            }

            // Validate duration is at least 5 minutes
            const startTimeInMinutes = parseInt(startTime.split(':')[0]) * 60 + parseInt(startTime.split(':')[1]);
            const endTimeInMinutes = parseInt(endTime.split(':')[0]) * 60 + parseInt(endTime.split(':')[1]);
            if (endTimeInMinutes - startTimeInMinutes < 5) {
                alert('The duration between start time and end time must be at least 5 minutes.');
                return;
            }

            const data = {
                title: formData.get('title'),
                description: formData.get('description'),
                date: formData.get('date'),
                roomId: parseInt(formData.get('room')),
                startTime: formatTimeToTimeSpan(formData.get('startTime')),
                endTime: formatTimeToTimeSpan(formData.get('endTime')),
                recurring: formData.get('recurring') === 'true',
                recurrenceTypeId: formData.get('recurring') === 'true' ? parseInt(formData.get('RecurrenceTypeId')) || null : null,
                recurrenceEndDate: formData.get('recurring') === 'true' ? formData.get('recurrenceEndDate') : null,
                userId: getCurrentUserId()
            };

            if (this.dataset.mode === 'edit') {
                data.id = parseInt(this.dataset.bookingId); // Ensure the id is included and correctly parsed
            }

            const submitButton = this.querySelector('button[type="submit"]');
            submitButton.disabled = true;
            submitButton.textContent = 'Submitting...';

            const url = this.dataset.mode === 'edit'
                ? `/api/Booking/${this.dataset.bookingId}`
                : '/api/Booking/create';
            const method = this.dataset.mode === 'edit' ? 'PUT' : 'POST';

            fetch(url, {
                method: method,
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(data)
            })
                .then(response => {
                    if (!response.ok) {
                        return response.json().then(err => { throw err; });
                    }
                    return response.json();
                })
                .then(result => {
                    console.log('Booking ' + (this.dataset.mode === 'edit' ? 'updated' : 'created') + ':', result);
                    modal.style.display = "none";
                    loadBookings(); // This will refresh the entire table
                    fetchTodaysBookings();
                    bookingForm.reset();

                    // Reset form mode and submit button text
                    this.dataset.mode = 'create';
                    delete this.dataset.bookingId;
                    submitButton.textContent = 'Create Booking';

                    // Check if the booking is for today
                    const today = new Date().toISOString().split('T')[0];
                    if (data.date === today) {
                        fetchTodaysBookings();
                    }

                    // Add success alert only for new bookings
                    if (method === 'POST') {
                        alert('Booking created successfully!');
                    } else {
                        alert('Booking updated successfully!');
                    }
                })
                .catch(error => {
                    console.error('Error ' + (this.dataset.mode === 'edit' ? 'updating' : 'creating') + ' booking:', error);
                    let errorMessage = 'An error occurred while ' + (this.dataset.mode === 'edit' ? 'updating' : 'creating') + ' the booking. Please try again.';
                    if (error.errors) {
                        errorMessage += '\n\nDetails:\n' + JSON.stringify(error.errors, null, 2);
                    }
                    alert(errorMessage);
                })
                .finally(() => {
                    submitButton.disabled = false;
                    submitButton.textContent = this.dataset.mode === 'edit' ? 'Update Booking' : 'Create Booking';
                });
        });

        // Function to edit booking
        function editBooking(bookingId) {
            fetch(`/api/Booking/${bookingId}`)
                .then(response => response.json())
                .then(booking => {
                    // Populate the form with booking details
                    document.getElementById('title').value = booking.title;
                    document.getElementById('description').value = booking.description;
                    document.getElementById('date').value = booking.date.split('T')[0];
                    document.getElementById('room').value = booking.roomId;
                    document.getElementById('startTime').value = booking.startTime;
                    document.getElementById('endTime').value = booking.endTime;
                    document.getElementById('recurring').value = booking.recurring ? 'true' : 'false';

                    if (booking.recurring) {
                        document.getElementById('recurrenceOptions').style.display = 'block';
                        document.getElementById('RecurrenceTypeId').value = booking.recurrenceTypeId;
                        document.getElementById('recurrenceEndDate').value = booking.recurrenceEndDate.split('T')[0];
                    }

                    // Change form submission to update instead of create
                    const form = document.getElementById('bookingForm');
                    form.dataset.mode = 'edit';
                    form.dataset.bookingId = bookingId;

                    // Change submit button text to 'Update Booking'
                    const submitButton = form.querySelector('button[type="submit"]');
                    submitButton.textContent = 'Update Booking';

                    // Show the modal
                    document.getElementById('addMeetingModal').style.display = 'block';
                })
                .catch(error => console.error('Error fetching booking details:', error));
        }

        function showBookingDetails(bookingId) {
            function getRecurrenceTypeName(recurrenceId) {
                result = "Error";
                fetch(`/api/Booking/recurrence/${recurrenceId}`)
                    .then(response => response.json())
                    .then(data => result = data)
                    .catch(error => console.error('Error getting recurrence type name:', error));
                return result;
            }
            fetch(`/api/Booking/${bookingId}`)
                .then(response => response.json())
                .then(booking => {
                    const modal = document.getElementById('bookingDetailsModal');
                    const content = document.getElementById('bookingDetailsContent');
                    content.innerHTML = `
                    <p class="mb-2"><strong>Title:</strong> ${booking.title}</p>
                    <p class="mb-2"><strong>Description:</strong> ${booking.description}</p>
                    <p class="mb-2"><strong>Date:</strong> ${new Date(booking.date).toLocaleDateString()}</p>
                    <p class="mb-2"><strong>Time:</strong> ${booking.startTime} - ${booking.endTime}</p>
                    <p class="mb-2"><strong>Room:</strong> ${booking.roomName}</p>
                    <p class="mb-2"><strong>Recurring:</strong> ${booking.recurring ? 'Yes' : 'No'}</p>
                    ${booking.recurring ? `
                                <p class="mb-2"><strong>Recurrence Type:</strong> ${getRecurrenceTypeName(booking.recurrenceTypeId)}</p>
                        <p class="mb-2"><strong>Recurrence End Date:</strong> ${new Date(booking.recurrenceEndDate).toLocaleDateString()}</p>
                    ` : ''}
                `;
                    modal.classList.remove('hidden');
                })
                .catch(error => console.error('Error fetching booking details:', error));
        }

        function closeBookingDetailsModal() {
            const modal = document.getElementById('bookingDetailsModal');
            modal.classList.add('hidden');
        }

        // Event listener for the close button
        document.getElementById('closeModalBtn').addEventListener('click', closeBookingDetailsModal);

        // Event listener for closing the modal when clicking outside the content
        document.getElementById('bookingDetailsModal').addEventListener('click', function (event) {
            if (event.target === this) {
                closeBookingDetailsModal();
            }
        });

        function cancelBooking(bookingId) {
            if (confirm('Are you sure you want to cancel this booking?')) {
                fetch(`/api/Booking/${bookingId}`, { method: 'DELETE' })
                    .then(response => {
                        if (response.ok) {
                            // Remove the row from the table
                            const row = document.querySelector(`button[data-id="${bookingId}"]`).closest('tr');
                            row.remove();
                            alert('Booking cancelled successfully');
                        } else {
                            throw new Error('Failed to cancel booking');
                        }
                    })
                    .catch(error => {
                        console.error('Error cancelling booking:', error);
                        alert('Failed to cancel booking. Please try again.');
                    });
            }
        }

        // pag open/close sa modal
        var modal = document.getElementById("addMeetingModal");
        var btn = document.querySelector(".book-now button");
        var span = document.getElementsByClassName("close")[0];

        btn.onclick = function () {
            modal.style.display = "block";
            bookingForm.reset(); // reset button
        }

        span.onclick = function () {
            modal.style.display = "none";
        }

        window.onclick = function (event) {
            if (event.target == modal) {
                modal.style.display = "none";
            }
        }

        // recurring nga choice
        document.getElementById('recurring').addEventListener('change', function () {
            document.getElementById('recurrenceOptions').style.display =
                this.value === 'true' ? 'flex' : 'none';
        });

        // reset function
        document.querySelector('.reset-button').addEventListener('click', function () {
            document.getElementById('recurrenceOptions').style.display = 'none';
        });

        // get current user ID (to be implemented)
        function getCurrentUserId() {
            // should return the ID of the currently logged-in user
            // pwede from global var, local stor, or API call
            return 1; // Placeholder value for now
        }
    });
</script>


@*Switch Tabs Script*@
<script>
    function switchTab(tabName) {
        // Taguan ani tanan content
        document.getElementById('addBookingContent').style.display = 'none';
        document.getElementById('myBookingsContent').style.display = 'none';

        // Kuhaon ang active class sa tanan nga tabs
        document.getElementById('addBookingTab').classList.remove('active');
        document.getElementById('myBookingsTab').classList.remove('active');

        // Ipakita ang gipili nga content ug ibutang ang active class
        document.getElementById(tabName + 'Content').style.display = 'flex';
        document.getElementById(tabName + 'Tab').classList.add('active');
    }
</script>

@section Styles {
    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            width: 100%;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
            background-color: #000;
        }

        .outer-container {
            box-sizing: border-box;
            background-color: var(--light);
            padding: 10px;
            border-radius: 15px;
            display: flex;
            flex-direction: column-reverse;
            flex-direction: column;
            width: calc(100% - 265px);
            height: calc(100%-40px);
            top: 20px;
            right: 20px;
            bottom: 20px;
            margin-left: 100px;
            position: fixed;
            z-index: 0;
        }

        .notification-profile {
            display: flex;
            justify-content: flex-end;
