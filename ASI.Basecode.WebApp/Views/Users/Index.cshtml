@model ASI.Basecode.Services.ServiceModels.BookingViewModel
<link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
<link href="https://unpkg.com/flowbite@1.4.7/dist/flowbite.min.css" rel="stylesheet">

@{
    ViewData["Title"] = "User Home Page";
}
<div class="outer-container">
    <div class="main-content">
        <div class="header">
            <div id="addBookingTab" class="tab active" onclick="switchTab('addBooking')">
                <i class="fas fa-plus"></i>
                <span>Add Booking</span>
            </div>
            <div id="myBookingsTab" class="tab" onclick="switchTab('myBookings')">
                <i class="fas fa-calendar-check"></i>
                <span>My Bookings</span>
            </div>
        </div>
        <div id="addBookingContent" class="content flex">
            <div class="left-pane">
                <div class="background-image">
                    <div class="overlay">
                        <div class="date-time">
                            <span class="time-now">
                                11:11</br>
                                <span class="date-now">Tuesday, June 18</span>
                        </div>
                        <div class="book-now">
                            <button>Book now</button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="right-pane">
                <div class="booking-info">
                    <h1 style="font-size: 4.5vh;">Today's Booking</h1>
                    <div class="booking-item">
                        <span class="time">09:00</span>
                        <span class="title">Project Management Mock Defense</span>
                        <span class="location">Training Room</span>
                    </div>
                    <div class="booking-item">
                        <span class="time">11:00</span>
                        <span class="title">C# Mock Defense</span>
                        <span class="location">Training Room</span>
                    </div>
                </div>
            </div>
        </div>
        <div id="myBookingsContent" class="content hidden">
            <div class="container mx-auto p-4 bg-gray-100" style="height: 75vh;">
                <h2 class="text-2xl font-bold mb-6 text-gray-800">My Bookings</h2>
                <div class="flex flex-col sm:flex-row justify-between items-center mb-6 space-y-4 sm:space-y-0">
                    <input type="text" id="searchBar" class="w-full sm:w-2/3 p-2 border border-gray-300 rounded-md shadow-sm focus:ring-2 focus:ring-blue-400 focus:border-blue-400" placeholder="Search...">
                    <button id="filterButton" class="w-full sm:w-auto sm:ml-4 px-4 py-2 bg-blue-600 text-white rounded-md flex items-center justify-center hover:bg-blue-700 transition duration-300 ease-in-out">
                        <i class="fas fa-filter mr-2"></i>
                        Filter
                    </button>
                </div>
                <div class="bg-white shadow-lg rounded-lg overflow-hidden">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="bg-gray-50">
                            <tr>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Booking Name</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date & Time</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Room</th>
                                <th class="px-2 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Recurring</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="bookingsTableBody" class="bg-white divide-y divide-gray-200">
                            <!-- ari musud ang next rows. naa ang script sa ubos -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>
</div>


<div id="addMeetingModal" class="modal">
    <div class="modal-content">
        <span class="close">&times;</span>
        <h1>Booking Form</h1>
        <form id="bookingForm">
            <div class="form-group full-width">
                <label for="title">Title:</label>
                <input type="text" id="title" name="title" required>
            </div>

            <div class="form-group full-width">
                <label for="description">Description:</label>
                <input type="text" id="description" name="description">
            </div>

            <div class="form-group">
                <label for="date">Date:</label>
                <input type="date" id="date" name="date" required>
            </div>

            <div class="form-group">
                <label for="room">Room:</label>
                <select id="room" name="room" required>
                    <option value="">Select a room</option>
                </select>
            </div>

            <div class="form-group">
                <label for="startTime">Start Time:</label>
                <input type="time" id="startTime" name="startTime" required>
            </div>

            <div class="form-group">
                <label for="endTime">End Time:</label>
                <input type="time" id="endTime" name="endTime" required>
            </div>

            <div class="form-group full-width">
                <label for="recurring">Recurring:</label>
                <select id="recurring" name="recurring">
                    <option value="false">No</option>
                    <option value="true">Yes</option>
                </select>
            </div>

            <div id="recurrenceOptions" class="full-width" style="display: none;">
                <div class="form-group-half">
                    <label for="recurrenceType">Recurrence Type:</label>
                    <select id="recurrenceType" name="recurrenceType">
                        <option value="daily">Daily</option>
                        <option value="weekly">Weekly</option>
                        <option value="monthly">Monthly</option>
                    </select>
                </div>

                <div class="form-group-half">
                    <label for="recurrenceEndDate">Recurrence End Date:</label>
                    <input type="date" id="recurrenceEndDate" name="recurrenceEndDate">
                </div>
            </div>

            <div class="form-group full-width">
                <button type="submit">Create Booking</button>
                <button type="reset" class="reset-button">Reset</button>
            </div>
        </form>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        // Fetch rooms and populate the select element
        fetch('/api/Booking/rooms')
            .then(response => response.json())
            .then(data => {
                const roomSelect = document.getElementById('room');
                data.forEach(room => {
                    const option = document.createElement('option');
                    option.value = room.id;
                    option.text = room.name;
                    roomSelect.appendChild(option);
                });
            })
            .catch(error => console.error('Error fetching rooms:', error));

        const bookingForm = document.getElementById('bookingForm');
        const submitButton = bookingForm.querySelector('button[type="submit"]');


        // Add form validation
        function validateForm() {
            const requiredFields = bookingForm.querySelectorAll('[required]');
            let isValid = true;
            requiredFields.forEach(field => {
                if (!field.value.trim()) {
                    isValid = false;
                    field.classList.add('invalid');
                } else {
                    field.classList.remove('invalid');
                }
            });
            return isValid;
        }

        // format time to TimeSpan string
        function formatTimeToTimeSpan(timeString) {
            const [hours, minutes] = timeString.split(':');
            return `${hours.padStart(2, '0')}:${minutes}:00`;
        }

        // form submission
        bookingForm.addEventListener('submit', function (e) {
            e.preventDefault();

            if (!validateForm()) {
                alert('Please fill in all required fields.');
                return;
            }

            const formData = new FormData(this);
            const data = {
                title: formData.get('title'),
                description: formData.get('description'),
                date: formData.get('date'),
                roomId: parseInt(formData.get('room')),
                startTime: formatTimeToTimeSpan(formData.get('startTime')),
                endTime: formatTimeToTimeSpan(formData.get('endTime')),
                recurring: formData.get('recurring') === 'true',
                recurrenceTypeId: formData.get('recurring') === 'true' ? parseInt(formData.get('recurrenceType')) : null,
                recurrenceEndDate: formData.get('recurring') === 'true' ? formData.get('recurrenceEndDate') : null,
                userId: getCurrentUserId() // pagkuha sa current user ID
            };

            submitButton.disabled = true;
            submitButton.textContent = 'Submitting...';

            fetch('/api/Booking/create', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(data)
            })
                .then(response => {
                    if (!response.ok) {
                        return response.json().then(err => { throw err; });
                    }
                    return response.json();
                })
                .then(result => {
                    console.log('Booking created:', result);
                    modal.style.display = "none";
                    loadBookings();
                    bookingForm.reset();
                })
                .catch(error => {
                    console.error('Error creating booking:', error);
                    let errorMessage = 'An error occurred while creating the booking. Please try again.';
                    if (error.errors) {
                        errorMessage += '\n\nDetails:\n' + JSON.stringify(error.errors, null, 2);
                    }
                    alert(errorMessage);
                })
                .finally(() => {
                    submitButton.disabled = false;
                    submitButton.textContent = 'Create Booking';
                });
        });


        function loadBookings() {
            fetch('/api/Booking/bookings')
                .then(response => response.json())
                .then(data => {
                    const tableBody = document.getElementById('bookingsTableBody');
                    tableBody.innerHTML = ''; 
                    data.forEach(booking => {
                        const row = document.createElement('tr');
                        row.innerHTML = `
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">${booking.title}</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${new Date(booking.date).toLocaleDateString()} ${booking.startTime} - ${booking.endTime}</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${booking.roomName}</td>
                            <td class="px-3 py-4 whitespace-nowrap text-sm text-gray-500">
                                <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full ${booking.recurring ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800'}">
                                    ${booking.recurring ? 'Yes' : 'No'}
                                </span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                                <button class="text-blue-600 hover:text-blue-900 mr-2">Edit</button>
                                <button class="text-green-600 hover:text-green-900 mr-2">Details</button>
                                <button class="text-red-600 hover:text-red-900">Cancel</button>
                            </td>
                        `;
                        tableBody.appendChild(row);
                    });
                })
                .catch(error => console.error('Error fetching bookings:', error));
        }

        // i laod ang bookings
        loadBookings();

        // pag open/close sa modal
        var modal = document.getElementById("addMeetingModal");
        var btn = document.querySelector(".book-now button");
        var span = document.getElementsByClassName("close")[0];

        btn.onclick = function () {
            modal.style.display = "block";
            bookingForm.reset(); // reset button
        }

        span.onclick = function () {
            modal.style.display = "none";
        }

        window.onclick = function (event) {
            if (event.target == modal) {
                modal.style.display = "none";
            }
        }

        // recurring nga choice
        document.getElementById('recurring').addEventListener('change', function () {
            document.getElementById('recurrenceOptions').style.display =
                this.value === 'true' ? 'flex' : 'none';
        });

        // reset function
        document.querySelector('.reset-button').addEventListener('click', function () {
            document.getElementById('recurrenceOptions').style.display = 'none';
        });

        // get current user ID (to be implemented)
        function getCurrentUserId() {
            // should return the ID of the currently logged-in user
            // pwede from global var, local stor, or API call
            return 1; // Placeholder value for now
        }
    });
</script>



<script>
    function switchTab(tabName) {
        // Taguan ani tanan content
        document.getElementById('addBookingContent').style.display = 'none';
        document.getElementById('myBookingsContent').style.display = 'none';

        // Kuhaon ang active class sa tanan nga tabs
        document.getElementById('addBookingTab').classList.remove('active');
        document.getElementById('myBookingsTab').classList.remove('active');

        // Ipakita ang gipili nga content ug ibutang ang active class
        document.getElementById(tabName + 'Content').style.display = 'flex';
        document.getElementById(tabName + 'Tab').classList.add('active');
    }
</script>

@section Styles {
    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            width: 100%;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
            background-color: #000;
        }

        .outer-container {
            background-color: #f0f0f0;
            padding: 20px;
            border-radius: 20px;
            display: flex;
            flex-direction: column;
            height: calc(100vh - 40px);
            width: calc(150vh - 10px);
            box-sizing: border-box;
            justify-content: center;
            align-items: center;
        }

        .notification-profile {
            display: flex;
            justify-content: flex-end;
            align-items: center;
            position: absolute;
            top: 20px;
            right: 20px;
        }

        .notification {
            position: relative;
            margin-right: 20px;
            color: #185D62;
            font-size: 24px;
            cursor: pointer;
        }

        .badge {
            position: absolute;
            top: -10px;
            right: -10px;
            background-color: red;
            color: white;
            font-size: 12px;
            padding: 4px 6px;
            border-radius: 50%;
        }

        .profile-picture {
            position: relative;
            width: 50px;
            height: 50px;
            border-radius: 50%;
            overflow: hidden;
            border: 2px solid #1BC7D2;
        }

            .profile-picture img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                border-radius: 50%;
            }

        .main-content {
            height: 85vh;
            background-color: #185D62;
            padding: 20px;
            color: #fff;
            border-radius: 10px;
            width: 100%;
            box-sizing: border-box;
            flex-grow: 1;
        }

        .header {
            display: flex;
            justify-content: flex-start;
            margin-bottom: 20px;
            border-bottom: 2px solid #1BC7D2;
        }

            .header .tab {
                padding: 10px 20px;
                cursor: pointer;
                background-color: #185D62;
                color: #fff;
                border-radius: 5px 5px 0 0;
                margin-right: 10px;
            }

                .header .tab.active {
                    background-color: #1BC7D2;
                    color: #000;
                }

        .content {
            display: flex;
            justify-content: space-between;
            flex-wrap: wrap;
            height: 100%;
            overflow-y: hidden;
        }

        .left-pane, .right-pane {
            flex: 1;
            margin: 10px;
        }

        .background-image {
            background-image: url("/img/book.jpg");
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            width: 100%;
            height: 85%;
            position: relative;
            border-radius: 10px;
            overflow: hidden;
        }

        .overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: #fff;
            text-align: center;
        }

        .date-time {
            margin-bottom: 20px;
        }

            .date-time .time-now,
            .date-time .date-now {
                display: block;
                font-size: 40px;
                line-height: 1.2;
                margin-bottom: 10px;
            }

        .book-now button {
            background-color: #5bc0de;
            color: #fff;
            border: none;
            padding: 10px 20px;
            font-size: 24px;
            cursor: pointer;
            border-radius: 5px;
            transition: background-color 0.3s ease;
        }

            .book-now button:hover {
                background-color: #31b0d5;
            }

        .booking-info {
            background-color: #fff;
            color: #000;
            padding: 20px;
            border-radius: 10px;
            width: 100%;
        }

        .booking-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 0;
        }

            .booking-item:not(:last-child) {
                border-bottom: 1px solid #ccc;
            }

        .time {
            font-weight: bold;
            flex: 0 0 80px;
        }

        .title {
            flex-grow: 1;
            margin-left: 10px;
        }

        .location {
            font-style: italic;
            flex: 0 0 150px;
            text-align: right;
        }

        .content {
            display: flex;
            justify-content: space-between;
            flex-wrap: wrap;
            height: 100%;
            overflow-y: auto;
        }

        #addBookingContent, #myBookingsContent {
            display: flex;
        }




        .modal {
            display: none;
            position: fixed;
            z-index: 1;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            overflow: auto;
            background-color: rgba(0,0,0,0.4);
            padding-top: 20px; 
            padding-bottom: 20px; 
        }

        .modal-content {
            background-color: #185D62;
            margin: 0 auto;
            padding: 20px;
            border: 1px solid #185D62;
            width: 80%;
            max-width: 700px;
            border-radius: 10px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.3);
            font-family: 'YourMainContainerFont', sans-serif;
            color: white;
            position: relative;
        }

            .modal-content h1 {
                text-align: center;
                color: #ecf0f1;
                margin-bottom: 10px; 
            }

            .modal-content form {
                background: #fff;
                padding: 15px;
                border-radius: 8px;
                display: flex;
                flex-wrap: wrap;
                gap: 8px; 
                margin-bottom: 20px; 
            }

            .modal-content label {
                display: block;
                margin-bottom: 2px; 
                font-weight: bold;
                font-size: 0.9em;
                color: #000;
            }

            .modal-content input,
            .modal-content select {
                width: 100%;
                padding: 6px; 
                margin-bottom: 6px;
                border: 1px solid #ccc;
                border-radius: 4px;
                box-sizing: border-box;
                background-color: #ecf0f1;
                color: #2c3e50;
            }

        .form-group {
            flex: 1 1 calc(50% - 8px);
            min-width: 200px;
        }

        .full-width {
            flex: 1 1 100%;
        }

        .form-group-half {
            flex: 1 1 calc(50% - 8px); 
            min-width: calc(50% - 8px);
            margin-right: 10px;
        }

        .modal-content button {
            background-color: #5bc0de;
            color: white;
            padding: 8px 12px; 
            border: none;
            border-radius: 4px;
            cursor: pointer;
            width: 100%;
            margin-top: 8px; 
        }

            .modal-content button:hover {
                background-color: #31b0d5;
            }

        .close {
            color: #fff;
            position: absolute;
            top: 10px;
            right: 15px;
            font-size: 24px; 
            font-weight: bold;
        }

            .close:hover,
            .close:focus {
                color: #ecf0f1;
                text-decoration: none;
                cursor: pointer;
            }

        #recurrenceOptions {
            margin-top: 6px;
        }

        .form-group:last-child {
            margin-bottom: 0;
        }

    </style>
}