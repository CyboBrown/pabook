<link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
<link href="https://unpkg.com/flowbite@1.4.7/dist/flowbite.min.css" rel="stylesheet">

@{
    ViewData["Title"] = "User Home Page";
}
<div class="outer-container">
    <div class="main-content">
        <div class="header">
            <div id="addBookingTab" class="tab active" onclick="switchTab('addBooking')">
                <i class="fas fa-plus"></i>
                <span>Add Booking</span>
            </div>
            <div id="myBookingsTab" class="tab" onclick="switchTab('myBookings')">
                <i class="fas fa-calendar-check"></i>
                <span>My Bookings</span>
            </div>
        </div>
        <div id="addBookingContent" class="content flex">
            <div class="left-pane">
                <div class="background-image">
                    <div class="overlay">
                        <div class="date-time">
                            <span class="time-now">
                                11:11</br>
                                <span class="date-now">Tuesday, June 18</span>
                        </div>
                        <div class="book-now">
                            <button>Book now</button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="right-pane">
                <div class="booking-info">
                    <h1 style="font-size: 4.5vh;">Today's Booking</h1>
                    <div class="booking-item">
                        <span class="time">09:00</span>
                        <span class="title">Project Management Mock Defense</span>
                        <span class="location">Training Room</span>
                    </div>
                    <div class="booking-item">
                        <span class="time">11:00</span>
                        <span class="title">C# Mock Defense</span>
                        <span class="location">Training Room</span>
                    </div>
                </div>
            </div>
        </div>
        <div id="myBookingsContent" class="content hidden">
            <div class="container mx-auto p-4 bg-gray-100" style="height: 75vh;">
                <h2 class="text-2xl font-bold mb-6 text-gray-800">My Bookings</h2>
                <div class="flex flex-col sm:flex-row justify-between items-center mb-6 space-y-4 sm:space-y-0">
                    <input type="text" id="searchBar" class="w-full sm:w-2/3 p-2 border border-gray-300 rounded-md shadow-sm focus:ring-2 focus:ring-blue-400 focus:border-blue-400" placeholder="Search...">
                    <button id="filterButton" class="w-full sm:w-auto sm:ml-4 px-4 py-2 bg-blue-600 text-white rounded-md flex items-center justify-center hover:bg-blue-700 transition duration-300 ease-in-out">
                        <i class="fas fa-filter mr-2"></i>
                        Filter
                    </button>
                </div>
                <div class="bg-white shadow-lg rounded-lg overflow-hidden">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="bg-gray-50">
                            <tr>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Booking Name</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date & Time</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Room</th>
                                <th class="px-2 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Recurring</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="bg-white divide-y divide-gray-200">
                            <tr>
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">Project Management Mock Defense</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">Tue 18 Jun, 2024 9:00 AM - 11:00 AM</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">Training Room</td>
                                <td class="px-3 py-4 whitespace-nowrap text-sm text-gray-500">
                                    <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">
                                        Yes
                                    </span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                                    <button class="text-blue-600 hover:text-blue-900 mr-2">Edit</button>
                                    <button class="text-green-600 hover:text-green-900 mr-2">Details</button>
                                    <button class="text-red-600 hover:text-red-900">Cancel</button>
                                </td>
                            </tr>
                            <tr>
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">C# Mock Defense</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">Tue 18 Jun, 2024 11:00 AM - 1:00 PM</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">Training Room</td>
                                <td class="px-3 py-4 whitespace-nowrap text-sm text-gray-500">
                                    <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-red-100 text-red-800">
                                        No
                                    </span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                                    <button class="text-blue-600 hover:text-blue-900 mr-2">Edit</button>
                                    <button class="text-green-600 hover:text-green-900 mr-2">Details</button>
                                    <button class="text-red-600 hover:text-red-900">Cancel</button>
                                </td>
                            </tr>
                            <!-- for test for more rows -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="addMeetingModal" class="modal">
    <div class="modal-content">
        <span class="close">&times;</span>
        <h1>Booking Form</h1>
        <form id="bookingForm">
            <div class="form-group full-width">
                <label for="title">Title:</label>
                <input type="text" id="title" name="title" required>
            </div>

            <div class="form-group full-width">
                <label for="description">Description:</label>
                <input type="text" id="description" name="description">
            </div>

            <div class="form-group">
                <label for="date">Date:</label>
                <input type="date" id="date" name="date" required>
            </div>

            <div class="form-group">
                <label for="room">Room:</label>
                <select id="room" name="room" required>
                    <option value="">Select a room</option>
                    <option value="1">Room 1</option>
                    <option value="2">Room 2</option>
                    <option value="3">Room 3</option>
                </select>
            </div>

            <div class="form-group">
                <label for="startTime">Start Time:</label>
                <input type="time" id="startTime" name="startTime" required>
            </div>

            <div class="form-group">
                <label for="endTime">End Time:</label>
                <input type="time" id="endTime" name="endTime" required>
            </div>

            <div class="form-group full-width">
                <label for="recurring">Recurring:</label>
                <select id="recurring" name="recurring">
                    <option value="false">No</option>
                    <option value="true">Yes</option>
                </select>
            </div>

            <div id="recurrenceOptions" class="full-width" style="display: none;">
                <div class="form-group-half">
                    <label for="recurrenceType">Recurrence Type:</label>
                    <select id="recurrenceType" name="recurrenceType">
                        <option value="daily">Daily</option>
                        <option value="weekly">Weekly</option>
                        <option value="monthly">Monthly</option>
                    </select>
                </div>

                <div class="form-group-half">
                    <label for="recurrenceEndDate">Recurrence End Date:</label>
                    <input type="date" id="recurrenceEndDate" name="recurrenceEndDate">
                </div>
            </div>

            <div class="form-group full-width">
                <button type="submit">Create Booking</button>
                <button type="reset" class="reset-button">Reset</button>
            </div>

        </form>
    </div>
</div>

<script>
    function switchTab(tabName) {
        // Taguan ani tanan content
        document.getElementById('addBookingContent').style.display = 'none';
        document.getElementById('myBookingsContent').style.display = 'none';

        // Kuhaon ang active class sa tanan nga tabs
        document.getElementById('addBookingTab').classList.remove('active');
        document.getElementById('myBookingsTab').classList.remove('active');

        // Ipakita ang gipili nga content ug ibutang ang active class
        document.getElementById(tabName + 'Content').style.display = 'flex';
        document.getElementById(tabName + 'Tab').classList.add('active');
    }
</script>

<script>
    // pagkuha sa modal
    var modal = document.getElementById("addMeetingModal");

    // pag open sa modal
    var btn = document.querySelector(".book-now button");

    // pag close sa modal
    var span = document.getElementsByClassName("close")[0];

    // mga buttons ubos sa modal form
    var form = document.getElementById("addMeetingForm");
    var addMeetingButton = document.getElementById("addMeetingButton");
    var resetButton = document.getElementById("resetButton");

    btn.onclick = function () {
        modal.style.display = "block";
    }

    span.onclick = function () {
        modal.style.display = "none";
    }

    // Kung i-click sa user bisan asa gawas sa modal, ma close sya
    window.onclick = function (event) {
        if (event.target == modal) {
            modal.style.display = "none";
        }
    }

    // Handle recurring option
    document.getElementById('recurring').addEventListener('change', function () {
        document.getElementById('recurrenceOptions').style.display =
            this.value === 'true' ? 'flex' : 'none';
    });

    // Handle form submission
    document.getElementById('bookingForm').addEventListener('submit', function (e) {
        e.preventDefault();
        // Add your form submission logic here
        console.log('Form submitted');
        modal.style.display = "none";
    });

    // Handle form reset
    document.querySelector('.reset-button').addEventListener('click', function () {
        document.getElementById('recurrenceOptions').style.display = 'none';
    });
</script>

@section Styles {
    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            width: 100%;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
            background-color: #000;
        }

        .outer-container {
            background-color: #f0f0f0;
            padding: 20px;
            border-radius: 20px;
            display: flex;
            flex-direction: column;
            height: calc(100vh - 40px);
            width: calc(150vh - 10px);
            box-sizing: border-box;
            justify-content: center;
            align-items: center;
        }

        .notification-profile {
            display: flex;
            justify-content: flex-end;
            align-items: center;
            position: absolute;
            top: 20px;
            right: 20px;
        }

        .notification {
            position: relative;
            margin-right: 20px;
            color: #185D62;
            font-size: 24px;
            cursor: pointer;
        }

        .badge {
            position: absolute;
            top: -10px;
            right: -10px;
            background-color: red;
            color: white;
            font-size: 12px;
            padding: 4px 6px;
            border-radius: 50%;
        }

        .profile-picture {
            position: relative;
            width: 50px;
            height: 50px;
            border-radius: 50%;
            overflow: hidden;
            border: 2px solid #1BC7D2;
        }

            .profile-picture img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                border-radius: 50%;
            }

        .main-content {
            height: 85vh;
            background-color: #185D62;
            padding: 20px;
            color: #fff;
            border-radius: 10px;
            width: 100%;
            box-sizing: border-box;
            flex-grow: 1;
        }

        .header {
            display: flex;
            justify-content: flex-start;
            margin-bottom: 20px;
            border-bottom: 2px solid #1BC7D2;
        }

            .header .tab {
                padding: 10px 20px;
                cursor: pointer;
                background-color: #185D62;
                color: #fff;
                border-radius: 5px 5px 0 0;
                margin-right: 10px;
            }

                .header .tab.active {
                    background-color: #1BC7D2;
                    color: #000;
                }

        .content {
            display: flex;
            justify-content: space-between;
            flex-wrap: wrap;
            height: 100%;
            overflow-y: hidden;
        }

        .left-pane, .right-pane {
            flex: 1;
            margin: 10px;
        }

        .background-image {
            background-image: url("/img/book.jpg");
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            width: 100%;
            height: 85%;
            position: relative;
            border-radius: 10px;
            overflow: hidden;
        }

        .overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: #fff;
            text-align: center;
        }

        .date-time {
            margin-bottom: 20px;
        }

            .date-time .time-now,
            .date-time .date-now {
                display: block;
                font-size: 40px;
                line-height: 1.2;
                margin-bottom: 10px;
            }

        .book-now button {
            background-color: #5bc0de;
            color: #fff;
            border: none;
            padding: 10px 20px;
            font-size: 24px;
            cursor: pointer;
            border-radius: 5px;
            transition: background-color 0.3s ease;
        }

            .book-now button:hover {
                background-color: #31b0d5;
            }

        .booking-info {
            background-color: #fff;
            color: #000;
            padding: 20px;
            border-radius: 10px;
            width: 100%;
        }

        .booking-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 0;
        }

            .booking-item:not(:last-child) {
                border-bottom: 1px solid #ccc;
            }

        .time {
            font-weight: bold;
            flex: 0 0 80px;
        }

        .title {
            flex-grow: 1;
            margin-left: 10px;
        }

        .location {
            font-style: italic;
            flex: 0 0 150px;
            text-align: right;
        }

        .content {
            display: flex;
            justify-content: space-between;
            flex-wrap: wrap;
            height: 100%;
            overflow-y: auto;
        }

        #addBookingContent, #myBookingsContent {
            display: flex;
        }




        .modal {
            display: none;
            position: fixed;
            z-index: 1;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            overflow: auto;
            background-color: rgba(0,0,0,0.4);
            padding-top: 20px; 
            padding-bottom: 20px; 
        }

        .modal-content {
            background-color: #185D62;
            margin: 0 auto;
            padding: 20px;
            border: 1px solid #185D62;
            width: 80%;
            max-width: 700px;
            border-radius: 10px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.3);
            font-family: 'YourMainContainerFont', sans-serif;
            color: white;
            position: relative;
        }

            .modal-content h1 {
                text-align: center;
                color: #ecf0f1;
                margin-bottom: 10px; 
            }

            .modal-content form {
                background: #fff;
                padding: 15px;
                border-radius: 8px;
                display: flex;
                flex-wrap: wrap;
                gap: 8px; 
                margin-bottom: 20px; 
            }

            .modal-content label {
                display: block;
                margin-bottom: 2px; 
                font-weight: bold;
                font-size: 0.9em;
                color: #000;
            }

            .modal-content input,
            .modal-content select {
                width: 100%;
                padding: 6px; 
                margin-bottom: 6px;
                border: 1px solid #ccc;
                border-radius: 4px;
                box-sizing: border-box;
                background-color: #ecf0f1;
                color: #2c3e50;
            }

        .form-group {
            flex: 1 1 calc(50% - 8px);
            min-width: 200px;
        }

        .full-width {
            flex: 1 1 100%;
        }

        .form-group-half {
            flex: 1 1 calc(50% - 8px); 
            min-width: calc(50% - 8px);
            margin-right: 10px;
        }

        .modal-content button {
            background-color: #5bc0de;
            color: white;
            padding: 8px 12px; 
            border: none;
            border-radius: 4px;
            cursor: pointer;
            width: 100%;
            margin-top: 8px; 
        }

            .modal-content button:hover {
                background-color: #31b0d5;
            }

        .close {
            color: #fff;
            position: absolute;
            top: 10px;
            right: 15px;
            font-size: 24px; 
            font-weight: bold;
        }

            .close:hover,
            .close:focus {
                color: #ecf0f1;
                text-decoration: none;
                cursor: pointer;
            }

        #recurrenceOptions {
            margin-top: 6px;
        }

        .form-group:last-child {
            margin-bottom: 0;
        }

    </style>
}