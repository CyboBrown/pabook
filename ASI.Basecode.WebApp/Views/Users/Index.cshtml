@{
    ViewData["Title"] = "User Home Page";
}
<div class="outer-container">
    <div class="main-content">
        <div class="header">
            <div id="addBookingTab" class="tab active" onclick="switchTab('addBooking')">
                <i class="fas fa-plus"></i>
                <span>Add Booking</span>
            </div>
            <div id="myBookingsTab" class="tab" onclick="switchTab('myBookings')">
                <i class="fas fa-calendar-check"></i>
                <span>My Bookings</span>
            </div>
        </div>
        <div id="addBookingContent" class="content">
            <div class="left-pane">
                <div class="background-image">
                    <div class="overlay">
                        <div class="date-time">
                            <span class="time-now">11:11</br>
                            <span class="date-now">Tuesday, June 18</span>
                        </div>
                        <div class="book-now">
                            <button>Book now</button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="right-pane">
                <div class="booking-info">
                    <h2>Today's Booking</h2>
                    <div class="booking-item">
                        <span class="time">09:00</span>
                        <span class="title">Project Management Mock Defense</span>
                        <span class="location">Training Room</span>
                    </div>
                    <div class="booking-item">
                        <span class="time">11:00</span>
                        <span class="title">C# Mock Defense</span>
                        <span class="location">Training Room</span>
                    </div>
                </div>
            </div>
        </div>
        <div id="myBookingsContent" class="content" style="display: none;">
            <!-- I add code dri for my bookings if ready na--> 
        </div>
    </div>
</div>

<div id="addMeetingModal" class="modal">
    <div class="modal-content">
        <span class="close">&times;</span>
        <h2>Add a Meeting</h2>
        <form id="addMeetingForm">
            <label for="meetingName">Meeting Name</label>
            <input type="text" id="meetingName" name="meetingName" required>

            <label for="startDate">Start Date</label>
            <input type="date" id="startDate" name="startDate" required>

            <label for="startTime">Start Time</label>
            <input type="time" id="startTime" name="startTime" required>

            <label for="endDate">End Date</label>
            <input type="date" id="endDate" name="endDate" required>

            <label for="endTime">End Time</label>
            <input type="time" id="endTime" name="endTime" required>

            <label for="recurring">Recurring</label>
            <input type="checkbox" id="recurring" name="recurring">

            <label for="room">Room</label>
            <input type="text" id="room" name="room" required>

            <div class="buttons">
                <button type="button" id="addMeetingButton">Add Meeting</button>
                <button type="button" id="resetButton">Reset</button>
            </div>
        </form>
    </div>
</div>

<script>
    function switchTab(tabName) {
        // Taguan ani tanan content
        document.getElementById('addBookingContent').style.display = 'none';
        document.getElementById('myBookingsContent').style.display = 'none';

        // Kuhaon ang active class sa tanan nga tabs
        document.getElementById('addBookingTab').classList.remove('active');
        document.getElementById('myBookingsTab').classList.remove('active');

        // Ipakita ang gipili nga content ug ibutang ang active class
        document.getElementById(tabName + 'Content').style.display = 'flex';
        document.getElementById(tabName + 'Tab').classList.add('active');
    }
</script>

<script>
    // pagkuha sa modal
    var modal = document.getElementById("addMeetingModal");

    // pag open sa modal
    var btn = document.querySelector(".book-now button");

    // pag close sa modal
    var span = document.getElementsByClassName("close")[0];

    // mga buttons ubos sa modal form
    var form = document.getElementById("addMeetingForm");
    var addMeetingButton = document.getElementById("addMeetingButton");
    var resetButton = document.getElementById("resetButton");

    btn.onclick = function () {
        modal.style.display = "block";
    }

    span.onclick = function () {
        modal.style.display = "none";
    }

    // Kung i-click sa user bisan asa gawas sa modal, ma close sya
    window.onclick = function (event) {
        if (event.target == modal) {
            modal.style.display = "none";
        }
    }

    // Pag-handle sa form submission
    addMeetingButton.onclick = function () {
        // pagkuha sa data sa form
        var meetingName = document.getElementById("meetingName").value;
        var startDate = document.getElementById("startDate").value;
        var startTime = document.getElementById("startTime").value;
        var endDate = document.getElementById("endDate").value;
        var endTime = document.getElementById("endTime").value;
        var recurring = document.getElementById("recurring").checked;
        var room = document.getElementById("room").value;

        // submission logic diri
        console.log("Meeting Name:", meetingName);
        console.log("Start Date:", startDate);
        console.log("Start Time:", startTime);
        console.log("End Date:", endDate);
        console.log("End Time:", endTime);
        console.log("Recurring:", recurring);
        console.log("Room:", room);

        modal.style.display = "none";
        form.reset();
    }

    // form reset
    resetButton.onclick = function () {
        form.reset();
    }
</script>

@section Styles {
    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            width: 100%;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
            background-color: #000;
        }

        .outer-container {
            background-color: #f0f0f0;
            padding: 20px;
            border-radius: 20px;
            display: flex;
            flex-direction: column;
            height: calc(100vh - 40px);
            width: calc(150vh - 10px);
            box-sizing: border-box;
            justify-content: center;
            align-items: center;
        }

        .notification-profile {
            display: flex;
            justify-content: flex-end;
            align-items: center;
            position: absolute;
            top: 20px;
            right: 20px;
        }

        .notification {
            position: relative;
            margin-right: 20px;
            color: #185D62;
            font-size: 24px;
            cursor: pointer;
        }

        .badge {
            position: absolute;
            top: -10px;
            right: -10px;
            background-color: red;
            color: white;
            font-size: 12px;
            padding: 4px 6px;
            border-radius: 50%;
        }

        .profile-picture {
            position: relative;
            width: 50px;
            height: 50px;
            border-radius: 50%;
            overflow: hidden;
            border: 2px solid #1BC7D2;
        }

        .profile-picture img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 50%;
        }

        .main-content {
            height: 85vh;
            background-color: #185D62;
            padding: 20px;
            color: #fff;
            border-radius: 10px;
            width: 100%;
            box-sizing: border-box;
            flex-grow: 1;
        }

        .header {
            display: flex;
            justify-content: flex-start;
            margin-bottom: 20px;
            border-bottom: 2px solid #1BC7D2;
        }

        .header .tab {
            padding: 10px 20px;
            cursor: pointer;
            background-color: #185D62;
            color: #fff;
            border-radius: 5px 5px 0 0;
            margin-right: 10px;
        }

        .header .tab.active {
            background-color: #1BC7D2;
            color: #000;
        }

        .content {
            display: flex;
            justify-content: space-between;
            flex-wrap: wrap;
            height: 100%;
            overflow-y: hidden; 
        }

        .left-pane, .right-pane {
            flex: 1;
            margin: 10px;
        }

        .background-image {
            background-image: url("/img/book.jpg");
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            width: 100%;
            height: 85%;
            position: relative;
            border-radius: 10px;
            overflow: hidden;
        }

        .overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: #fff;
            text-align: center;
        }

        .date-time {
            margin-bottom: 20px;
        }

        .date-time .time-now,
        .date-time .date-now {
            display: block;
            font-size: 40px; 
            line-height: 1.2;
            margin-bottom: 10px; 
        }

        .book-now button {
            background-color: #5bc0de; 
            color: #fff;
            border: none;
            padding: 10px 20px;
            font-size: 24px; 
            cursor: pointer;
            border-radius: 5px;
            transition: background-color 0.3s ease;
        }

            .book-now button:hover {
                background-color: #31b0d5; 
            }

        .booking-info {
            background-color: #fff;
            color: #000;
            padding: 20px;
            border-radius: 10px;
            width: 100%;
        }

        .booking-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 0;
        }

        .booking-item:not(:last-child) {
            border-bottom: 1px solid #ccc;
        }

        .time {
            font-weight: bold;
            flex: 0 0 80px;
        }

        .title {
            flex-grow: 1;
            margin-left: 10px;
        }

        .location {
            font-style: italic;
            flex: 0 0 150px;
            text-align: right;
        }

        .content {
            display: flex;
            justify-content: space-between;
            flex-wrap: wrap;
            height: 100%;
            overflow-y: auto;
        }

        #addBookingContent, #myBookingsContent {
            display: flex;
        }




        .modal {
            display: none;
            position: fixed;
            z-index: 1;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            overflow: auto;
            background-color: rgba(0,0,0,0.4);
            padding-top: 60px;
        }

        .modal-content {
            background-color: #185D62;
            margin: 5% auto;
            padding: 20px;
            border: 1px solid #888;
            width: 80%;
            max-width: 500px;
            border-radius: 10px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.3);
            font-family: 'YourMainContainerFont', sans-serif; 
            color: white; 
            position: relative; 
        }

        .close {
            color: #aaa;
            position: absolute;
            top: 10px;
            right: 10px;
            font-size: 28px;
            font-weight: bold;
        }

            .close:hover,
            .close:focus {
                color: black;
                text-decoration: none;
                cursor: pointer;
            }

        form {
            display: flex;
            flex-direction: column;
        }

        form label {
            margin-top: 10px;
            font-weight: normal;
            margin-bottom: 5px; 
        }

        form input, form button {
            margin-top: 5px;
            padding: 10px;
            font-size: 16px;
            border: 1px solid #ccc;
            border-radius: 5px;
            font-weight: normal; 
        }

        form button {
            margin-top: 20px;
            cursor: pointer;
            background-color: #1BC7D2;
            color: white;
            border: none;
            font-weight: normal;
        }

        form .buttons {
            display: flex;
            justify-content: space-between;
            margin-top: 20px; 
        }

        form .buttons button {
            flex: 1;
            margin: 5px;
        }

        .inline-label {
            display: inline;
            margin-left: 10px;
        }

        .date-time {
            display: flex;
            justify-content: space-between;
            margin-top: 10px; 
        }

        .date-time label, .date-time input {
            flex: 1;
            margin-right: 10px;
        }

        .date-time input:last-child {
            margin-right: 0;
        }

        .recurring {
            display: flex;
            align-items: center;
            margin-top: 10px;
        }

        form label, form input {
            margin-bottom: 10px; 
        }

        form input#room {
            margin-bottom: 20px; 
        }
    </style>
}

