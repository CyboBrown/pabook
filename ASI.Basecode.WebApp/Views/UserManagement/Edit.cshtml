@model ASI.Basecode.Services.ServiceModels.UserManagementViewModel

@{
    ViewData["Title"] = "Edit User";
}
<div class="main-content">
    <h1>Edit User</h1>

    <hr />
    <div class="row">
        <div class="col-md-4">
            <form asp-action="PostUpdate" id="editForm">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input asp-for="Id" type="hidden" />
                <div class="form-group">
                    <label asp-for="LastName" class="control-label"></label>
                    <input asp-for="LastName" class="form-control" />
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="FirstName" class="control-label"></label>
                    <input asp-for="FirstName" class="form-control"/>
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Email" class="control-label"></label>
                    <input asp-for="Email" class="form-control" type="number" min="0" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="UserRole" class="control-label"></label>
                    <select asp-for="UserRole" class="form-control">
                        <option value="">-- Select Role --</option>
                        <option value="0">Admin</option>
                        <option value="1">Manager</option>
                        <option value="2">User</option>
                    </select>
                    <span asp-validation-for="UserRole" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <input type="submit" value="Save" class="btn btn-primary" />
                </div>
            </form>
        </div>
    </div>

    <div>
        <a href="@Url.Action("Index", "Admin", new { tab = "Room" })" onclick="selectRoomTab()">Back to List</a>
    </div>
</div>
<script>
    toastr.options = {
        positionClass: "toast-top-center",
        timeOut: 5000,
        closeButton: true,
        progressBar: true
    };

    var successMessage = '@TempData["SuccessMessage"]';
    var duplicateError = '@TempData["DuplicateErr"]';

    if (successMessage) {
        toastr.success(successMessage);
    }
    if (duplicateError) {
        toastr.error(duplicateError);
    }


    document.getElementById('editForm').addEventListener('submit', function (event) {
        var typeField = document.querySelector('input[name="Type"]');
        var capacityField = document.querySelector('input[name="Capacity"]');

        if (typeField.value < 0) {
            event.preventDefault();
            alert("Type cannot be a negative number.");
        }

        if (capacityField.value < 0) {
            event.preventDefault();
            alert("Capacity cannot be a negative number.");
        }
    });
</script>

<style>
    .outer-container {
        width: 100%;
        background-color: var(--light);
        padding: 20px;
        border-radius: 20px;
        display: flex;
        flex-direction: column-reverse;
        flex-direction: column;
        width: calc(100% - 185px);
        height: 100vh;
        top: 20px;
        right: 0px;
        bottom: 10px;
        padding-top: 20px;
        margin-left: 100px;
        position: fixed;
        z-index: 1;
        transition: margin-right 0.3s ease, width 0.3s ease;
    }

    .main-content {
        background-color: #185D62;
        padding: 15px;
        border-radius: 10px;
        z-index: 2;
    }

    .row {
        color: white;
    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

