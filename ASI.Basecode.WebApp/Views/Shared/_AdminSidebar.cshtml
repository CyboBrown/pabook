*@

    <div class="sidebar">
        <div class="logo">
            <img src="/img/butang logo name ari idle" alt="Logo" />
        </div>
        <ul class="sidebar-menu">
            <li class="@(ViewContext.RouteData.Values["Action"].ToString() == "Index" ? "active" : "")">
                <a asp-controller="Admin" asp-action="Index">
                    <i class="fas fa-home"></i>
                    <span>Home</span>
                </a>
            </li>
            <li class="@(ViewContext.RouteData.Values["Action"].ToString() == "Analytics" ? "active" : "")">
                <a asp-controller="Admin" asp-action="Analytics">
                    <i class="fas fa-chart-bar"></i>
                    <span>Analytics</span>
                </a>
            </li>
            <li class="@(ViewContext.RouteData.Values["Action"].ToString() == "ManageRoles" ? "active" : "")">
                <a asp-controller="Admin" asp-action="ManageRoles">
                    <i class="fas fa-users-cog"></i>
                    <span>Manage Roles</span>
                </a>
            </li>
            <li class="@(ViewContext.RouteData.Values["Action"].ToString() == "AdminSettings" ? "active" : "")">
                <a asp-controller="Admin" asp-action="AdminSettings">
                    <i class="fas fa-cog"></i>
                    <span>Settings</span>
                </a>
            </li>
        </ul>
        <div class="user-info">
            <div class="notification-button">
                <a href="#" id="notificationToggle">
                    <i class="fas fa-bell"></i>
                    <span class="notification-badge">3</span>
                </a>
            </div>
            <div class="user-details">
                <span class="user-name">Admin Kent John</span>
                <span class="user-email">kennyadmin@gmail.com</span>
            </div>
            <div class="logout">
                <a asp-action="SignOutAdmin" asp-controller="Account">
                    <i class="fas fa-sign-out-alt"></i>
                </a>
            </div>
        </div>
    </div>



<style>
    .sidebar {
        width: 215px;
        height: 100vh;
        background-color: #000;
        color: #fff;
        position: fixed;
        top: 0;
        left: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding-top: 20px;
    }

    .logo img {
        width: 100px;
        height: auto;
    }

    .sidebar-menu {
        list-style: none;
        padding: 0;
        margin: 20px 0;
        width: 100%;
    }

    .sidebar-menu li {
        width: 100%;
    }

    .sidebar-menu li a {
        display: flex;
        align-items: center;
        padding: 10px 20px;
        color: #fff;
        text-decoration: none;
        width: 100%;
    }

    .sidebar-menu li a:hover,
    .sidebar-menu li.active a {
        background-color: #333;
    }
   
    .sidebar-menu li.active a {
        background-color: #1BC7D2;        
        color: #000;
        font-weight: bold;
    }

    
    .sidebar-menu li a i {
        margin-right: 10px;

    }

    .user-info {
        margin-top: auto;
        width: 100%;
        padding: 10px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: 12px;
    }

    .notification-button {
        position: relative;
    }

    .notification-button a {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        background-color: #333;
        border-radius: 50%;
        color: #fff;
        text-decoration: none;
        transition: background-color 0.3s ease;
    }

        .notification-button a:hover {
            background-color: #555;
        }

    .notification-badge {
        position: absolute;
        top: -5px;
        right: -5px;
        background-color: #ff4444;
        color: #fff;
        font-size: 12px;
        font-weight: bold;
        padding: 2px 6px;
        border-radius: 50%;
    }

    .user-details {
        flex-grow: 1;
        margin-left: 15px;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
    }

    .user-name {
        font-weight: bold;
        margin-bottom: 5px;
    }

    .user-email {
        font-size: 0.7em;
        color: #bbb;
    }

    .logout a {
        display: flex;
        align-items: center;
        color: #fff;
        text-decoration: none;
    }

        .logout a i {
            font-size: 1.4em;
        }
</style>