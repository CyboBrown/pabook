
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
<div class="sidebar">
    <div class="logo">
        <img src="~/img/asi-logo-invert.svg"
             style="width: 100%; height: auto;" alt="logo"
             onclick="window.location.href = '@Url.Action("Index", "Admin")';">

    </div>
    <p style="margin-top: 10px; margin-bottom: 10px;">
        @HttpContextAccessor.HttpContext.Session.GetString("UserName")
    </p>
   


    <ul class="sidebar-menu">
        <li class="@(ViewContext.RouteData.Values["Action"].ToString() == "Index" ? "active" : "")">
            <a asp-controller="Admin" asp-action="Index">
                <i class="fas fa-home"></i>
                <span>Home</span>
            </a>
        </li>
        <li class="@(ViewContext.RouteData.Values["Action"].ToString() == "Bookings" ? "active" : "")">
            <a asp-controller="Admin" asp-action="RoomManagement">
                <i class="fas fa-chart-bar"></i>
                <span>Room Management</span>
            </a>
        </li>
        <li class="@(ViewContext.RouteData.Values["Action"].ToString() == "Analytics" ? "active" : "")">
            <a asp-controller="Admin" asp-action="Analytics">
                <i class="fas fa-chart-bar"></i>
                <span>Analytics</span>
            </a>
        </li>
        <li class="@(ViewContext.RouteData.Values["Action"].ToString() == "ManageRoles" ? "active" : "")">
            <a asp-controller="Admin" asp-action="ManageRoles">
                <i class="fas fa-users-cog"></i>
                <span>Manage Roles</span>
            </a>
        </li>
        <li class="@(ViewContext.RouteData.Values["Action"].ToString() == "AdminSettings" ? "active" : "")">
            <a asp-controller="Admin" asp-action="AdminSettings">
                <i class="fas fa-cog"></i>
                <span>Settings</span>
            </a>
        </li>
    </ul>
    <div class="user-info">
        <div class="notification-button">
            <a href="#" id="notificationToggle">
                <i class="fas fa-bell"></i>
                <span class="notification-badge">3</span>
            </a>
        </div>
        <div class="user-details">
            <span class="user-name">Admin</span>
            <span class="user-email">admin@gmail.com</span>
        </div>
        <div class="logout">
            <a asp-action="SignOutAdmin" asp-controller="Account">
                <i class="fas fa-sign-out-alt"></i>
            </a>
        </div>
    </div>
</div>



<script>
    document.addEventListener("DOMContentLoaded", function () {
        const sidebar = document.querySelector('.sidebar');
        const outerContainer = document.querySelector('.outer-container');
        const roomContainer = document.querySelector('.room-container');

        sidebar.addEventListener('mouseover', function () {
            sidebar.classList.add('expanded');
            outerContainer.classList.remove('expanded');
            roomContainer.classList.remove('expanded');
        });

        sidebar.addEventListener('mouseout', function () {
            sidebar.classList.remove('expanded');
            outerContainer.classList.add('expanded');
            roomContainer.classList.remove('expanded');
        });
    });


    const menuBar = document.querySelector('.main-content .bx');
    const sidebar = document.getElementById('sidebar');

    menuBar.addEventListener('click', function () {
        sidebar.classList.toggle('hide');
    })


</script>

