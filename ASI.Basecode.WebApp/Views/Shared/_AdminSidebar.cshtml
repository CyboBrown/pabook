

    <div class="sidebar">
        <div class="logo">
            <img src="/img/logo-dark-horizontal.png" alt="Logo" />
        </div>
        <ul class="sidebar-menu">
            <li class="@(ViewContext.RouteData.Values["Action"].ToString() == "Index" ? "active" : "")">
                <a asp-controller="Admin" asp-action="Index">
                    <i class="fas fa-home"></i>
                    <span>Home</span>
                </a>
            </li>
            <li class="@(ViewContext.RouteData.Values["Action"].ToString() == "Analytics" ? "active" : "")">
                <a asp-controller="Admin" asp-action="Analytics">
                    <i class="fas fa-chart-bar"></i>
                    <span>Analytics</span>
                </a>
            </li>
            <li class="@(ViewContext.RouteData.Values["Action"].ToString() == "ManageRoles" ? "active" : "")">
                <a asp-controller="Admin" asp-action="ManageRoles">
                    <i class="fas fa-users-cog"></i>
                    <span>Manage Roles</span>
                </a>
            </li>
            <li class="@(ViewContext.RouteData.Values["Action"].ToString() == "AdminSettings" ? "active" : "")">
                <a asp-controller="Admin" asp-action="AdminSettings">
                    <i class="fas fa-cog"></i>
                    <span>Settings</span>
                </a>
            </li>
        </ul>

    <div class="user-details">
        <span class="user-name ml-2 overflow-hidden">@HttpContextAccessor.HttpContext.Session.GetString("FullName")</span>
        <span class="user-email ml-2 overflow-hidden">@HttpContextAccessor.HttpContext.Session.GetString("Email")</span>
    </div>
        <div class="notification-section">
            <a href="#" id="notificationToggle">
                <i class="fas fa-bell"></i>
                <span class="notification-text">Notification</span>
            </a>
        </div>
        <div class="signout">
            <a asp-action="SignOutAdmin" asp-controller="Account">
                <i class="fas fa-sign-out-alt"></i>
            <span>Logout, @HttpContextAccessor.HttpContext.Session.GetString("UserName")</span>
            </a>
        </div>
    </div>



<style>
    .sidebar {
        width: 265px;
        height: 100vh;
        background-color: #000;
        color: #fff;
        position: fixed;
        top: 0;
        left: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding-top: 20px;
    }

    .logo img {
        width: 200px;
        height: auto;
    }

    .sidebar-menu {
        list-style: none;
        padding: 0px;
        margin: 20px 0;
        width: 100%;
    }

    .sidebar-menu li {
        width: 100%;
    }

    .sidebar-menu li a {
        display: flex;
        align-items: center;
        padding: 10px 20px;
        color: #fff;
        text-decoration: none;
        width: 100%;
    }

    .sidebar-menu li a:hover,
    .sidebar-menu li.active a {
        background-color: #333;
    }
   
    .sidebar-menu li.active a {
        background-color: #1BC7D2;        
        color: #000;
        font-weight: bold;
    }

    
    .sidebar-menu li a i {
        margin-right: 10px;

    }

    .user-details {
        width: 100%;
        padding: 10px;
        text-align: start;
        border-bottom: 1px solid #444;
        margin-top: auto;
    }

    .user-name {
        display: block;
        font-weight: bold;
        margin-bottom: 5px;
        color: #fff;
    }

    .user-email {
        font-size: 0.9em;
        color: #bbb;
    }
  
    .notification-section {
        width: 100%;
        
        padding: 0px 0px;
    }

    .notification-section a {
        display: flex;
        align-items: center;
        color: #fff;
        text-decoration: none;
        width: 100%;
        padding: 10px 20px;
        transition: background-color 0.3s ease;
    }

    .notification-section a:hover {
        color: blue;
    }

    .notification-section i {
        margin-right: 10px;
    }

    .notification-text {
        flex-grow: 1;
    }

    .signout {
        width: 100%;
        margin-bottom: 20px;
    }

    .signout a {
        display: flex;
        align-items: center;
        color: #fff;
        text-decoration: none;
        width: 100%;
        padding: 10px 20px;
        transition: background-color 0.3s ease;
    }

    .signout a:hover {
        color: red;
    }

    .signout i {
        margin-right: 10px;
     }

     .fas {
         width: 25px;
     }
</style>