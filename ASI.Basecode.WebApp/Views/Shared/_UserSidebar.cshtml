    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    <div class="sidebar">
        <div class="logo">
            <img src="/img/butang logo name ari idle" alt="Logo" />
        </div>
        <ul class="sidebar-menu">
            <li class="@(ViewContext.RouteData.Values["Action"].ToString() == "Index" ? "active" : "")">
                <a asp-controller="Home" asp-action="Index">
                    <i class="fas fa-home"></i>
                    <span>Home</span>
                </a>
            </li>
            <li class="@(ViewContext.RouteData.Values["Action"].ToString() == "ViewBookings" ? "active" : "")">
                <a asp-controller="Home" asp-action="ViewBookings">
                    <i class="fas fa-calendar-alt"></i>
                    <span>View Bookings</span>
                </a>
            </li>
            <li class="@(ViewContext.RouteData.Values["Action"].ToString() == "Calendar" ? "active" : "")">
                <a asp-controller="Home" asp-action="Calendar">
                    <i class="fas fa-calendar"></i>
                    <span>Calendar</span>
                </a>
            </li>
            <li class="@(ViewContext.RouteData.Values["Action"].ToString() == "UserSettings" ? "active" : "")">
                <a asp-controller="Home" asp-action="UserSettings">
                    <i class="fas fa-cog"></i>
                    <span>Settings</span>
                </a>
            </li>
        </ul>
        <div class="user-info">
            <div class="notification-button">
                <a href="#" id="notificationToggle">
                    <i class="fas fa-bell"></i>
                    <span class="notification-badge">3</span>
                </a>
            </div>
            <div class="user-details">
                <span class="user-name">Kent John Dico</span>
                <span class="user-email">kennydeku@gmail.com</span>
            </div>
            <div class="logout">
                <a asp-action="SignOutUser" asp-controller="Account">
                    <i class="fas fa-sign-out-alt"></i>
                </a>
            </div>
        </div>
    </div>
}

<style>
    .sidebar {
        width: 265px;
        height: 100vh;
        background-color: #000;
        color: #fff;
        position: fixed;
        top: 0;
        left: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding-top: 20px;
        z-index: 1;
    }

    .logo img {
        width: 100px;
        height: auto;
    }

    .sidebar-menu {
        list-style: none;
        padding: 0;
        margin: 20px 0;
        width: 100%;
    }

        .sidebar-menu li {
            width: 100%;
        }

            .sidebar-menu li a {
                display: flex;
                align-items: center;
                padding: 10px 20px;
                color: #fff;
                text-decoration: none;
                width: 100%;
            }

                .sidebar-menu li a:hover,
                .sidebar-menu li.active a {
                    background-color: #333;
                }

                .sidebar-menu li a i {
                    margin-right: 10px;
                }

    .user-info {
        margin-top: auto;
        width: 100%;
        padding: 10px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .notification-button {
        position: relative;
    }

        .notification-button a {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 40px;
            height: 40px;
            background-color: #333;
            border-radius: 50%;
            color: #fff;
            text-decoration: none;
            transition: background-color 0.3s ease;
        }

            .notification-button a:hover {
                background-color: #555;
            }

    .notification-badge {
        position: absolute;
        top: -5px;
        right: -5px;
        background-color: #ff4444;
        color: #fff;
        font-size: 12px;
        font-weight: bold;
        padding: 2px 6px;
        border-radius: 50%;
    }

    .user-details {
        flex-grow: 1;
        margin-left: 15px;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
    }

    .user-name {
        font-weight: bold;
        margin-bottom: 5px;
    }

    .user-email {
        font-size: 0.7em;
        color: #bbb;
    }

    .logout a {
        display: flex;
        align-items: center;
        color: #fff;
        text-decoration: none;
    }

        .logout a i {
            font-size: 1.4em;
        }
</style> 
