@{
    <link rel="stylesheet" href="~/css/admin.css" />
    <div class="sidebar">
        <div class="logo">
            @*<img id="logo-img" src="/img/logo-dark-horizontal.png" alt="Logo" />*@
            <img id="logo-dark" src="~/img/logo-dark-horizontal.png" alt="Dark Mode Logo" style="display: block;">
            <img id="logo-light" src="~/img/logo-light-horizontal.png" alt="Light Mode Logo" style="display: none;">
        </div>
        <ul class="sidebar-menu">
            <li class="@(ViewContext.RouteData.Values["Action"].ToString() == "Index" ? "active" : "")">
                <a asp-controller="Users" asp-action="Index">
                    <i class="fas fa-home"></i>
                    <span>Home</span>
                </a>
            </li>
            <li class="@(ViewContext.RouteData.Values["Action"].ToString() == "Calendar" ? "active" : "")">
                <a asp-controller="Users" asp-action="Calendar">
                    <i class="fas fa-calendar"></i>
                    <span>Calendar</span>
                </a>
            </li>
            <li class="@(ViewContext.RouteData.Values["Action"].ToString() == "UserSettings" ? "active" : "")">
                <a asp-controller="Users" asp-action="UserSettings">
                    <i class="fas fa-cog"></i>
                    <span>Settings</span>
                </a>
            </li>
        </ul>
        
        <div class="user-details">
            <span class="side-user-name ml-2 overflow-hidden">Hi! @HttpContextAccessor.HttpContext.Session.GetString("FirstName")</span>
        </div>
        <div class="notification-section">
            <a asp-controller="Notification" asp-action="Index" id="notificationToggle">
                <i class="fas fa-bell"></i>
                <span class="notification-text">Notifications</span>
            </a>
        </div>
        <div class="signout">
            <a asp-action="SignOutAdmin" asp-controller="Account">
                <i class="fas fa-sign-out-alt"></i>
                <span>Logout</span>
            </a>
        </div>
    </div>
}