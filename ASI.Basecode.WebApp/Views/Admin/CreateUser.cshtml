@model ASI.Basecode.Services.ServiceModels.UserManagementViewModel

@{
    ViewData["Title"] = "Create User";
}
<div class="outer-container">
    <div class="main-content">
        <h1>Create</h1>
        <hr />
        <div class="row">
            <div class="inside">
                
                <form asp-action="PostCreate" id="createForm">
                 <input type="hidden" id="requestId" name="requestId" value="@Guid.NewGuid().ToString()" />
                    <div>
                        <a href="@Url.Action("Index", "Admin", new { tab = "User" })" onclick="selectUserTab()">Back to List</a>
                    </div>
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="form-group">
                        <label asp-for="LastName" class="control-label"></label>
                        <input asp-for="LastName" class="form-control" />
                        <span asp-validation-for="LastName" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="FirstName" class="control-label"></label>
                        <input asp-for="FirstName" class="form-control" />
                        <span asp-validation-for="FirstName" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Email" class="control-label"></label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="UserRole" class="control-label"></label>
                        <select asp-for="UserRole" class="form-control">
                            <option value="">-- Select Role --</option>
                            <option value="0">Admin</option>
                            <option value="1">Manager</option>
                            <option value="2">User</option>
                        </select>
                        <span asp-validation-for="UserRole" class="text-danger"></span>
                    </div>
                    <div class="buttons">
                        <input type="submit" value="Add" class="btn btn-primary" />
                        <button type="button" id="resetButton">Reset</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

<script>
    document.getElementById('resetButton').addEventListener('click', function() {
        document.getElementById('createForm').reset();
    });
    
    function selectRoomTab() {
        document.getElementById('tabRoom').checked = true;
            
        loadTabContent('Room');
    }


    toastr.options = {
            positionClass: "toast-top-center",
            timeOut: 5000,
            closeButton: true,
            progressBar: true
    };

    var duplicateError = '@TempData["DuplicateErr"]';

    if (successMessage) {
        toastr.success(successMessage);
    }
    if (duplicateError) {
        toastr.error(duplicateError);
    }


    document.getElementById('createForm').addEventListener('submit', function(event) {
        var typeField = document.querySelector('input[name="Type"]');
        var capacityField = document.querySelector('input[name="Capacity"]');
            
        if (typeField.value < 0) {
            event.preventDefault();
            alert("Type cannot be a negative number.");
        }
            
        if (capacityField.value < 0) {
            event.preventDefault();
            alert("Capacity cannot be a negative number.");
        }
    });
</script>

    <style>

         @* css code ni sa container, ayaw labti para uniform, scroll down naay space adto for manipulating styles *@

        body {
        margin: 0;
        font-family: Arial, sans-serif;
        width: 100%;
        height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        overflow: hidden;
        background-color: #000;
        }

        .outer-container {
            box-sizing: border-box;
            background-color: var(--light);
            padding: 10px;
            border-radius: 15px;
            display: flex;
            flex-direction: column-reverse;
            flex-direction: column;
            width: calc(100% - 215px);
            height: calc(100%-40px);
            top: 20px;
            right: 20px;
            bottom: 20px;
            margin-left: 100px;
            position: fixed;
            z-index: 0;
            text-align: center;
        }

        .main-content {
            height: 85vh;
            background-color: #185D62;
            padding: 20px;
            color: #fff;
            border-radius: 10px;
            width: 100%;
            box-sizing: border-box;
            flex-grow: 1;
        }

        h1 {
            font-size: 36px;
            font-weight: 500;
            margin-top: 0;
            margin-bottom: 10px;
            letter-spacing: 0.5px;
        }
        
        .form-group {
            margin-bottom: 20px;
            text-align: left; /* Adjust alignment of labels and inputs */
        }
        
        
    </style>
}


