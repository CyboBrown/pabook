@model ASI.Basecode.Services.ServiceModels.PreferenceViewModel
@{
    ViewData["Title"] = "Admin Settings";
}

<body class="@(@Model?.DarkMode ?? false ? "night" : "")">
    <link rel="stylesheet" href="~/css/admin.css" />

    <form asp-action="SavePreferences" method="post">
        <div class="outer-container">
            <div class="main-content">
                <h1>Settings and Preferences</h1>
                <div class="profile-section">
                    <div class="profile-pic"></div>
                    <div class="profile-info">
                        <span class="profile-name">ADMIN USER</span>
                        <span class="profile-status">@((HttpContextAccessor.HttpContext.Session.GetString("Email") ?? ""))</span>
                    </div>
                </div>

                <div class="settings-section">
                    <div class="setting">
                        <span>Switch to light mode</span>
                        <label id="dark-change" class="toggle-switch">
                            <input type="checkbox" name="DarkMode" value="true" @(Model?.DarkMode ?? false ? "checked" : "")>
                            <span class="slider"></span>
                        </label>
                    </div>

                    <div class="setting">
                        <span>Notification</span>
                        <select class="status" name="EnableNotifications">
                            <option value="true" selected="@(Model?.EnableNotifications == true ? "selected" : null)">On</option>
                            <option value="false" selected="@(Model?.EnableNotifications == false ? "selected" : null)">Off</option>
                        </select>
                    </div>
                    <div class="setting">
                        <span>Default Time</span>
                        <select class="time-select" name="TimeFormat">
                            <option value="24" selected="@(Model?.TimeFormat == 24 ? "selected" : null)">24 - hour</option>
                            <option value="12" selected="@(Model?.TimeFormat == 12 ? "selected" : null)">12 - hour</option>
                        </select>

                    </div>
                </div>
                <div class="action-buttons">
                    <button type="submit" class="save-button">Save Changes</button>
                    <button type="button" class="cancel-button">Cancel</button>
                </div>
            </div>
        </div>
    </form>

    <script>
        var darkMode = document.getElementById('dark-change');
        darkMode.addEventListener('change', function () {
            document.body.classList.toggle('night', this.checked);
            document.querySelector('.outer-container').classList.toggle('night', this.checked);
            document.querySelector('.main-content').classList.toggle('night', this.checked);
            document.querySelector('.profile-pic').classList.toggle('night', this.checked);
            document.querySelector('.sidebar').classList.toggle('night', this.checked);
            document.querySelectorAll('.sidebar-menu li a').forEach(function (link) {
                link.classList.toggle('night', darkMode.checked);
            });
            document.querySelector('.user-details').classList.toggle('night', darkMode.checked);
            document.querySelector('.notification-section').classList.toggle('night', darkMode.checked);
            document.querySelector('.signout').classList.toggle('night', darkMode.checked);
            document.querySelector('.logo-img').classList.toggle('night', darkMode.checked);

            // Toggle logo
            var logoImg = document.querySelector('.logo-img img');
            if (darkMode.checked) {
                logoImg.src = '/img/logo-light-horizontal.png';
            } else {
                logoImg.src = '/img/logo-dark-horizontal.png';
            }
        });
    </script>
</body>




