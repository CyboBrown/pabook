@model ASI.Basecode.Services.ServiceModels.PreferenceViewModel
@{
    ViewData["Title"] = "Admin Settings";
}

<body class="@((Model != null && Model.DarkMode) ? "light" : "dark")">
    <link rel="stylesheet" href="~/css/admin.css" />
    <link rel="stylesheet" href="~/css/admindark.css" id="theme-style" />
    <form id="preferencesForm" method="post">
        <div class="message-container" id="messageContainer"></div> <!-- Message container -->
        <div class="outer-container">
            <div class="main-content">
                <h1 style="font-size: 1.5rem;text-align: center;">Account Settings</h1>
                
                <div class="settings-section">
                    <div class="profile-section">
                        <div class="profile-pic">
                            <img id="profilePicture" src="~/img/admin.jpg" alt="Profile Picture" />
                        </div>
                        <div class="profile-info">
                            <span class="user-name ml-2 overflow-hidden">@HttpContextAccessor.HttpContext.Session.GetString("FullName")</span>
                            <span class="user-email ml-2 overflow-hidden">@HttpContextAccessor.HttpContext.Session.GetString("Email")</span>
                            <button type="button" class="edit-button ml-2" onclick="editUser('@HttpContextAccessor.HttpContext.Session.GetString("UserId")')">Edit</button>
                        </div>  
                        
                    </div>

                    <div class="lightt">
                        <div class="setting">
                            <span>Switch to Light Mode</span>
                            <label id="dark-change" class="toggle-switch">
                                <input type="checkbox" name="DarkMode" value="true" @(Model?.DarkMode ?? false ? "checked" : "")>
                                <span class="slider"></span>
                            </label>
                        </div>
                    </div>
                    

                    <div class="lightt">
                        @*<h2>Booking Duration</h2>*@
                        <div class="setting">
                            <span>Time Format</span>
                            <select class="time-select" name="TimeFormat">
                                <option value="24" selected="@(Model?.TimeFormat == 24 ? "selected" : null)">24 - hour</option>
                                <option value="12" selected="@(Model?.TimeFormat == 12 ? "selected" : null)">12 - hour</option>
                            </select>
                        </div>
                        <div class="setting">
                            <span>Default Booking Duration</span>
                            <select class="time-select" name="DefaultBookingDuration">
                                <option value="30" selected="@(Model?.DefaultBookingDuration == 30 ? "selected" : null)">30 - minutes</option>
                                <option value="60" selected="@(Model?.DefaultBookingDuration == 60 ? "selected" : null)">60 - minutes</option>
                                <option value="90" selected="@(Model?.DefaultBookingDuration == 90 ? "selected" : null)">90 - minutes</option>
                            </select>
                        </div>
                    </div>
                    <div class="action-buttons">
                        <button type="submit" class="save-button">Save Changes</button>
                    </div>
                </div>
            </div>
        </div>
    </form>   
    <div id="addUserModal" class="modal">
        <div class="modal-content">
            <span class="close">&times;</span>
            <h1 style="font-size: 2rem;">Account Information</h1>
            <form id="userForm">
                <div class="form-group full-width">
                    <label for="firstName">First Name:</label>
                    <input type="text" id="firstName" name="firstName" required>
                </div>
                <div class="form-group full-width">
                    <label for="username">Username:</label>
                    <input type="text" id="username" name="username" required>
                </div>
                <div class="form-group full-width">
                    <label for="lastName">Last Name:</label>
                    <input type="text" id="lastName" name="lastName" required>
                </div>
                <div class="form-group full-width">
                    <label for="email">Contact Email:</label>
                    <input type="email" id="email" name="email" required>
                </div>
                <div class="form-group full-width">
                    <label for="password">Password:</label>
                    <input type="password" id="password" name="password">
                </div>
                <div class="form-group full-width">
                    <div class="button-group">
                        
                        <button type="submit">Save</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    
    <script>     
        function toggleLogos(isDarkMode) {
            const logoDark = document.getElementById('logo-dark');
            const logoLight = document.getElementById('logo-light');

            if (isDarkMode) {
                logoLight.style.display = 'block';
                logoDark.style.display = 'none';
            } else {
                logoLight.style.display = 'none';
                logoDark.style.display = 'block';
            }
        }
        //Fetch and preference sa user from the db
        document.addEventListener('DOMContentLoaded', function () {
            fetchPreferences();

            var userId = '@HttpContextAccessor.HttpContext.Session.GetString("UserId")';
            sessionStorage.setItem('UserId', userId);
                    
        });
        
        //fetch the id using sessionstorage
        function fetchPreferences() {
            const userId = sessionStorage.getItem('UserId');
            if (!userId) {
                console.error('User ID not found in session storage.');
                return;
            }

            fetch(`/api/Preference/myPreferences?userId=${userId}`)
                .then(response => {
                    if (!response.ok) {
                        throw new Error('Network response was not ok');
                    }
                    return response.json();
                })
                .then(data => {
                    console.log('Fetched preferences data:', data);

                    if (Array.isArray(data) && data.length === 0) {
                        console.log('No preferences found. Setting default values or handling empty state.');
                        // Handle case when no preferences are found (perhaps set defaults)
                    } else if (typeof data === 'object') {
                        // Update UI based on fetched preferences
                        document.querySelector('input[name="DarkMode"]').checked = data.darkMode;
                        //document.querySelector('select[name="TimeFormat"]').value = data.timeFormat.toString(); // Ensure value is converted to string
                        document.querySelector('select[name="DefaultBookingDuration"]').value = data.defaultBookingDuration.toString(); // Ensure value is converted to string

                        // Store preferences in session storage
                        //sessionStorage.setItem('userPreferences', JSON.stringify(data));

                        // Apply theme based on preferences
                        applyTheme(data.darkMode);
                    } else {
                        console.error('Unexpected data format:', data);
                    }
                })
                .catch(error => console.error('Error fetching preferences:', error));
        }
        
        const darkModeToggle = document.querySelector('#dark-change input');
        darkModeToggle.addEventListener('change', function () {
            const theme = this.checked ? 'light' : 'dark';
            document.body.className = theme;
            const preferences = JSON.parse(sessionStorage.getItem('userPreferences')) || {};
            preferences.darkMode = this.checked;
            //sessionStorage.setItem('userPreferences', JSON.stringify(preferences));
            toggleLogos(preferences.darkMode);
            
        });
        
        //DarkMode and LightMode
        function applyTheme(isDarkMode) {
            const body = document.body;
            if (isDarkMode) {
                body.classList.add('light');
                body.classList.remove('dark');
                loadTheme('admin.css'); //CSS file for light mode
            } else {
                body.classList.add('dark');
                body.classList.remove('light');
                loadTheme('admindark.css'); //CSS file for dark mode
            }
            toggleLogos(preferences.darkMode);
        }

        function loadTheme(themeName) {
            const themeStyle = document.getElementById('theme-style');
            if (themeStyle) {
                themeStyle.setAttribute('href', `/css/${themeName}`);
            } else {
                console.error('Theme style link element not found');
            }
        }      
        function updateUIFromPreferences(preferences) {
            console.log('Updating UI with preferences:', preferences);

            // Assuming preferences is an array and we are interested in the first element
            const preference = preferences[0];
            const darkModeInput = document.querySelector('input[name="DarkMode"]');
            if (darkModeInput) {
                darkModeInput.checked = preferences.darkMode;
            }
               
            
            const timeFormatSelect = document.querySelector('select[name="TimeFormat"]');
            if (timeFormatSelect) {
                timeFormatSelect.checked = preferences.timeFormat;
            }

            const defaultBookingDurationSelect = document.querySelector('select[name="DefaultBookingDuration"]');
            if (defaultBookingDurationSelect) {
                defaultBookingDurationSelect.checked = preferences.defaultBookingDuration;
            }
            applyTheme(preferences.darkMode);
        }

        // Function to handle form submission
        document.getElementById('preferencesForm').addEventListener('submit', function (event) {
            event.preventDefault(); // Prevent default form submission
            savePreferences();
        });

        //Save Changes Button nga function
        function savePreferences() {
            const preferences = {
                Id: parseInt(sessionStorage.getItem('UserId')),
                darkMode: document.querySelector('input[name="DarkMode"]').checked,
                //enableNotifications: document.querySelector('select[name="EnableNotifications"]').value === "true",
                timeFormat: parseInt(document.querySelector('select[name="TimeFormat"]').value),
                defaultBookingDuration: parseInt(document.querySelector('select[name="DefaultBookingDuration"]').value)
            };
            // Basic client-side validation for passwords
            if (preferences.newPassword !== preferences.confirmPassword) {
                alert('Passwords do not match.');
                return;
            }
            fetch('/api/Preference/save', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(preferences)
            })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        toastr.success('Changes Saved!');
                        //console.log('Preferences saved successfully.');
                        applyTheme(preferences.darkMode);
                        displaySuccessMessage();
                    } else {
                        console.error('Failed to save preferences:', data.message);
                    }
                })
                .catch(error => console.error('Error saving preferences:', error));
        }

        function updateUIAndSessionFromPreferences(preferences) {
            updateUIFromPreferences([preferences]);
            // Store preferences in session storage
            sessionStorage.setItem('userPreferences', JSON.stringify([preferences]));

            console.log('Preferences updated in UI and session storage:', preferences);
        }
        document.addEventListener("DOMContentLoaded", function () {
            function adjustFontSize() {
                const zoomLevel = Math.round(window.devicePixelRatio * 100);
                const rootFontSize = 16 * window.devicePixelRatio;
                document.documentElement.style.fontSize = `${rootFontSize}px`;

                const weight = zoomLevel > 100 ? "bold" : "normal";
                document.body.style.fontWeight = weight;

                // Exclude sidebar from being resizable
                const sidebar = document.querySelector(".sidebar");
                if (sidebar) {
                    sidebar.style.width = "265px"; // Ensure the sidebar width stays fixed
                    sidebar.style.fontSize = "initial"; // Reset sidebar font size
                }
            }

            window.addEventListener("resize", adjustFontSize);
            adjustFontSize(); // Initial call
        });   
    </script>
</body>
<script>  
        document.addEventListener("DOMContentLoaded", function () {
        const userForm = document.getElementById('userForm');
        const submitButton = userForm.querySelector('button[type="submit"]');
        const userModal = document.getElementById('addUserModal');
        const closeModalButton = document.querySelector('.close');

        // Validate form
        function validateForm() {
            const requiredFields = userForm.querySelectorAll('[required]');
            let isValid = true;
            requiredFields.forEach(field => {
                if (!field.value.trim()) {
                    isValid = false;
                    field.classList.add('invalid');
                } else {
                    field.classList.remove('invalid');
                }
            });
            return isValid;
        }

        // Handle form submission
        userForm.addEventListener('submit', function (e) {
            e.preventDefault();

            if (!validateForm()) {
                alert('Please fill in all required fields.');
                return;
            }

            const formData = new FormData(this);
            const data = {
                username: formData.get('username'),
                lastName: formData.get('lastName'),
                firstName: formData.get('firstName'),
                email: formData.get('email'),
                password: formData.get('password'),
            };

            // If in edit mode, include userId
            if (this.dataset.mode === 'edit') {
                data.id = parseInt(this.dataset.userId, 10);
            } else {
                return; // Prevent submission if not in edit mode
            }

            submitButton.disabled = true;
            submitButton.textContent = 'Submitting...';

            fetch(`/api/UserManagement/${data.id}`, {
                method: 'PUT',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(data)
            })
            .then(response => response.json())
            .then(result => {
                if (result.success) {
                    userModal.style.display = "none";
                    //userForm.reset();
                    submitButton.textContent = 'Save';
                    toastr.success('User updated successfully!');
                } else {
                    toastr.error(result.message || 'Input password to modify.');
                }
            })
            .catch(error => {
                console.error('Error details:', error);
                toastr.error('Error!');
            })
            .finally(() => {
                submitButton.disabled = false;
                submitButton.textContent = 'Save';
            });
        });

        // Handle modal close
        closeModalButton.addEventListener('click', function () {
            userModal.style.display = 'none';
        });

        window.addEventListener('click', function (event) {
            if (event.target === userModal) {
                userModal.style.display = 'none';
            }
        });

        // Edit user function
        window.editUser = function (userId) {
            fetch(`/api/UserManagement/${userId}`, {
                method: 'GET',
                headers: {
                    'Content-Type': 'application/json'
                }
            })
            .then(response => response.json())
            .then(user => {
                document.getElementById('username').value = user.userName;
                document.getElementById('lastName').value = user.lastName;
                document.getElementById('firstName').value = user.firstName;
                document.getElementById('email').value = user.email;
                document.getElementById('password').value = '';


                userForm.dataset.mode = 'edit';
                userForm.dataset.userId = userId;
                submitButton.textContent = 'Update User';
                userModal.style.display = 'block';
            })
            .catch(error => {
                console.error('Error fetching user details:', error);
                alert('An error occurred while fetching user details.');
            });
        };
    });

</script>

<style>  
    
    .modal {
        display: none;
        position: fixed;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        overflow: auto;
        background-color: rgba(0,0,0,0.4);
        padding-top: 20px;
        padding-bottom: 20px;
        z-index: 50;
    }

    .modal-content {
        background-color: #185D62;
        margin: 0 auto;
        padding: 20px;
        border: 1px solid #185D62;
        width: 80%;
        max-width: 700px;
        border-radius: 10px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.3);
        font-family: 'Poppins', sans-serif;
        color: white;
        position: relative;
    }

    .modal-content h1 {
        text-align: center;
        color: #ecf0f1;
        margin-bottom: 10px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .modal-content form {
        background: #fff;
        padding: 15px;
        border-radius: 8px;
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .modal-content label {
        display: block;
        margin-bottom: 2px;
        font-weight: bold;
        font-size: 0.9em;
        color: #000;
    }

    .modal-content input,
    .modal-content select {
        width: 100%;
        padding: 6px;
        margin-bottom: 6px;
        border: 1px solid #ccc;
        border-radius: 4px;
        box-sizing: border-box;
        background-color: #ecf0f1;
        color: #2c3e50;
    }

    .form-group {
        flex: 1 1 calc(50% - 8px);
        min-width: 200px;
    }

    .full-width {
        flex: 1 1 100%;
    }

    .form-group-half {
        flex: 1 1 calc(50% - 8px);
        min-width: calc(50% - 8px);
        margin-right: 10px;
    }

    .modal-content button {
        background-color: #5bc0de;
        color: white;
        padding: 10px 20px;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        font-weight: 600;
        transition: background-color 0.3s ease;
        margin-right: 10px;
        margin-top: 15px;
    }

    .modal-content button:hover {
        background-color: #31b0d5;
    }

    .modal-content button[type="submit"] {
        background-color: #1893a2;
    }

    .modal-content button[type="submit"]:hover {
        background-color: #0d353f;
    }
    

    .button-group {
        display: flex;
        justify-content: center;
        align-items: center;
    }
    .password{
        font-weight: 100;
        color: red;
    }

</style>



