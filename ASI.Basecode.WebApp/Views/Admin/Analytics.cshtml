@{
    ViewData["Title"] = "Analytics";
}
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@100;200;300;400;500;600;700;800;900&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/icon?family=Material+Icons+Outlined" rel="stylesheet">
<link rel="stylesheet" href="~/css/admin.css" />
<link rel="stylesheet" href="~/css/admindark.css" />
<div class="outer-container">
    <div class="main-content">
        <h1>Report and Analytics Dashboard</h1>

        <div class="summary-cards">
            <div class="card bookings">
                <h3>Bookings</h3>
                <div class="card-content">
                    <div class="stat">
                        <span class="label">Total Bookings</span>
                        <span id="total-bookings" class="value">Loading...</span>
                    </div>
                    <div class="stat">
                        <span class="label">Cancelled</span>
                        <span id="cancelled-bookings" class="value">Loading...</span>
                    </div>
                </div>
                <i class="fas fa-calendar-check"></i>
            </div>

            <div class="card users">
                <h3>Users</h3>
                <div class="card-content">
                    <div class="stat">
                        <span class="label">Total Users</span>
                        <span id="total-users" class="value">Loading...</span>
                    </div>
                    <div class="stat">
                        <span class="label">Deleted</span>
                        <span id="deleted-users" class="value">Loading...</span>
                    </div>
                </div>
                <i class="fas fa-user"></i>
            </div>
            
            <div class="card room-usage">
                <h3>Room Usage</h3>
                <div class="card-content">
                    <div class="stat">
                        <span class="label">Most Booked</span>
                        <span id="most-booked-room" class="value">Loading...</span>
                    </div>
                    <div class="stat">
                        <span class="label">Peak Time</span>
                        <span id="peak-time" class="value">Loading...</span>
                    </div>
                </div>
                <i class="fas fa-door-open"></i>
            </div>
        </div>

        <!-- chart and chart filter -->
        <div class="charts-section">
            <h2>Overall Bookings and Room Usage</h2>
            <div class="filter-container">
                <select id="time-range" class="filter-select" onchange="updateFilterOptions()">
                    <option value="year">By Year</option>
                    <option value="month">By Month</option>
                   
                </select>
                <select id="filter-options" class="filter-select" onchange="updateChartData()">
                </select>
            </div>
            <div id="area-chart" class="chart"></div>
        </div>

        <button id="generate-report-btn" class="btn pulse">Generate Report</button>

        <!-- Modal sa Generated Reports -->
        <div id="report-modal" class="modalRA">
            <div class="modal-contentRA">
                <span class="closeRA">&times;</span>
                <h2>Generate Report</h2>
                <div class="report-options">
                    <select id="report-type">
                        <option value="room-usage">Room Usage Report</option>
                        <option value="user-activity">User Activity Report</option>
                        <option value="booking-summary">Booking Summary Report</option>
                    </select>
                    <button id="generate-report" class="btn btn-primary">Generate</button>
                    <button id="download-pdf" class="btn btn-secondary">Download</button>
                </div>
                <div id="report-preview" class="report-preview">
             </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const generateBtn = document.getElementById('generate-report');
        const downloadBtn = document.getElementById('download-pdf');
        const reportTypeSelect = document.getElementById('report-type');
        const reportPreview = document.getElementById('report-preview');

        reportPreview.style.backgroundColor = '#cfc9c9';
        reportPreview.style.display = 'flex';
        reportPreview.style.justifyContent = 'center';
        reportPreview.style.alignItems = 'center';
        reportPreview.innerHTML = '<p>Please choose a report type and click "Generate" <br> To download report as pdf file, click "Download"</p>';
        reportPreview.disabled = true;

        generateBtn.disabled = reportTypeSelect.value === '';
        downloadBtn.disabled = true;
        downloadBtn.title = 'Generate report first';
        downloadBtn.classList.add('disabled-with-message');

        reportTypeSelect.addEventListener('change', function () {
            generateBtn.disabled = reportTypeSelect.value === '';
        });

        generateBtn.addEventListener('click', generateReport);
        downloadBtn.addEventListener('click', downloadPDF);

        async function generateReport() {
            const reportType = reportTypeSelect.value;
            let reportContent = '';

            switch (reportType) {
                case 'room-usage':
                    reportContent = await generateRoomUsageReport();
                    break;
                case 'user-activity':
                    reportContent = await generateUserActivityReport();
                    break;
                case 'booking-summary':
                    reportContent = await generateBookingSummaryReport();
                    break;
                default:
                    reportContent = '<p>Error: Invalid report type selected.</p>';
            }

            reportPreview.style.backgroundColor = 'white';
            reportPreview.style.display = 'block';
            reportPreview.innerHTML = reportContent;
            reportPreview.disabled = false;
            downloadBtn.disabled = false; // Enable download button after generating the report
            downloadBtn.title = 'Download PDF';
            downloadBtn.classList.remove('disabled-with-message');
        }

        function handleDownload(event) {
            if (downloadBtn.disabled) {
                event.preventDefault();
            } else {
                downloadPDF();
            }
        }

        async function downloadPDF() {
            const element = document.getElementById('report-preview');
            const reportType = reportTypeSelect.options[reportTypeSelect.selectedIndex].text;
            const currentDate = new Date().toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'numeric',
                day: 'numeric'
            }).replace(/\//g, '-');

            const opt = {
                margin: 10,
                filename: `${reportType}_${currentDate}.pdf`,
                image: { type: 'jpeg', quality: 0.98 },
                html2canvas: { scale: 2 },
                jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' }
            };
            html2pdf().from(element).set(opt).save();
        }


        async function generateRoomUsageReport() {
            try {
                const response = await fetch('/api/analytics/monthly-data');
                const data = await response.json();

                let tableRows = '';
                for (const [month, monthData] of Object.entries(data)) {
                    tableRows += `
                            <tr>
                                <td>${month}</td>
                                <td>${monthData.bookingSummary}</td>
                                <td>${monthData.roomUsage}</td>
                            </tr>
                        `;
                }
                return `
                        <h3>Room Usage Report</h3>
                        <p>Generated on: ${new Date().toLocaleString()}</p>
                        <table>
                            <tr><th>Month</th><th>Total Bookings</th><th>Rooms Used</th></tr>
                            ${tableRows}
                        </table>
                    `;
            } catch (error) {
                console.error('Error fetching room usage report:', error);
                return '<p>Error fetching room usage report</p>';
            }
        }

        async function generateUserActivityReport() {
            try {
                const response = await fetch('/api/analytics/dashboard');
                const data = await response.json();

                return `
                        <h3>User Activity Report</h3>
                        <p>Generated on: ${new Date().toLocaleString()}</p>
                        <table>
                            <tr><th>Metric</th><th>Value</th></tr>
                            <tr><td>Total Users</td><td>${data.totalUsers}</td></tr>
                            <tr><td>Total Bookings</td><td>${data.totalBookings}</td></tr>
                            <tr><td>Cancelled Bookings</td><td>${data.totalCancelledBookings}</td></tr>
                            <tr><td>Deleted Users</td><td>${data.totalDeletedUsers}</td></tr>
                        </table>
                    `;
            } catch (error) {
                console.error('Error fetching user activity report:', error);
                return '<p>Error fetching user activity report</p>';
            }
        }

        async function generateBookingSummaryReport() {
            try {
                const response = await fetch('/api/analytics/dashboard');
                const data = await response.json();

                return `
                        <h3>Booking Summary Report</h3>
                        <p>Generated on: ${new Date().toLocaleString()}</p>
                        <table>
                            <tr><th>Metric</th><th>Value</th></tr>
                            <tr><td>Total Bookings</td><td>${data.totalBookings}</td></tr>
                            <tr><td>Cancelled Bookings</td><td>${data.totalCancelledBookings}</td></tr>
                            <tr><td>Most Booked Room</td><td>${data.mostBookedRoom}</td></tr>
                            <tr><td>Peak Booking Time</td><td>${data.peakTime}</td></tr>
                        </table>
                    `;
            } catch (error) {
                console.error('Error fetching booking summary report:', error);
                return '<p>Error fetching booking summary report</p>';
            }
        }
    });
</script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/apexcharts/3.35.5/apexcharts.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        fetchAnalyticsData();
    });

    function fetchAnalyticsData() {
        fetch('/api/analytics/total-bookings')
            .then(response => response.json())
            .then(data => {
                document.getElementById('total-bookings').textContent = data.totalBookings;
            })
            .catch(error => console.error('Error fetching total bookings:', error));

        fetch('/api/analytics/cancelled-bookings')
            .then(response => response.json())
            .then(data => {
                document.getElementById('cancelled-bookings').textContent = data.cancelledBookings;
            })
            .catch(error => console.error('Error fetching cancelled bookings:', error));

        fetch('/api/analytics/total-users')
            .then(response => response.json())
            .then(data => {
                document.getElementById('total-users').textContent = data.totalUsers;
            })
            .catch(error => console.error('Error fetching total users:', error));

        fetch('/api/analytics/deleted-users')
            .then(response => response.json())
            .then(data => {
                document.getElementById('deleted-users').textContent = data.deletedUsers;
            })
            .catch(error => console.error('Error fetching deleted users:', error));

        fetch('/api/analytics/most-booked-room')
            .then(response => response.json())
            .then(data => {
                document.getElementById('most-booked-room').textContent = data.mostBookedRoom;
            })
            .catch(error => console.error('Error fetching most booked room:', error));

        fetch('/api/analytics/peak-time')
            .then(response => response.json())
            .then(data => {
                document.getElementById('peak-time').textContent = data.peakTime;
            })
            .catch(error => console.error('Error fetching peak time:', error));
    }
</script>

<script>
    const areaChartOptions = {
        series: [
            {
                name: 'Booking Summary',
                data: [],
            },
            {
                name: 'Room Usage',
                data: [],
            },
        ],
        chart: {
            type: 'line',
            background: 'transparent',
            height: 250,
            stacked: false,
            toolbar: {
                show: false,
            },
        },
        colors: ['#EF9C66', '#84c0dc'],
        dataLabels: {
            enabled: false,
        },
        stroke: {
            curve: 'smooth',
            width: [4, 4],
        },
        fill: {
            opacity: [0.5, 0.3],
        },
        grid: {
            borderColor: '#d8ddb9',
            yaxis: {
                lines: {
                    show: true,
                },
            },
            xaxis: {
                lines: {
                    show: true,
                },
            },
            row: {
                colors: ['#5d5d5d', 'transparent'],
                opacity: 0.5,
            },
        },
        legend: {
            labels: {
                colors: '#FCF8F3',
            },
            show: true,
            position: 'top',
        },
        markers: {
            size: 6,
            strokeColors: '#1b2635',
            strokeWidth: 2,
        },
        xaxis: {
            axisBorder: {
                color: '#FCF8F3',
                show: true,
            },
            axisTicks: {
                color: '#FCF8F3',
                show: true,
            },
            labels: {
                offsetY: 0,
                style: {
                    colors: '#FCF8F3',
                    fontSize: '0.9rem',
                },
            },
        },
        yaxis: [
            {
                title: {
                    text: 'Booking Summary',
                    style: {
                        color: '#FCF8F3',
                        fontSize: '0.9rem',
                    },
                },
                labels: {
                    style: {
                        colors: ['#FCF8F3'],
                        fontSize: '0.9rem',
                    },
                },
            },
            {
                opposite: true,
                title: {
                    text: 'Room Usage',
                    style: {
                        color: '#FCF8F3',
                        fontSize: '0.9rem',
                    },
                },
                labels: {
                    style: {
                        colors: ['#FCF8F3'],
                        fontSize: '0.9rem',
                    },
                },
            },
        ],
        tooltip: {
            shared: true,
            intersect: false,
            theme: 'dark',
        },
    };

    const areaChart = new ApexCharts(
        document.querySelector('#area-chart'),
        areaChartOptions
    );
    areaChart.render();

    function updateChartData() {
        const timeRange = document.getElementById('time-range').value;
        const filterOption = document.getElementById('filter-options').value;

        let apiUrl = '/api/Analytics/';
        if (timeRange === 'month') {
            const month = new Date(Date.parse(filterOption + " 1, 2021")).getMonth() + 1;
            const year = new Date().getFullYear();
            apiUrl += `monthly-data/${year}/${month}`;
        } else if (timeRange === 'year') {
            apiUrl += `yearly-data/${filterOption}`;
        }

        fetch(apiUrl)
            .then(response => {
                if (!response.ok) {
                    throw new Error('Network response was not ok');
                }
                return response.json();
            })
            .then(data => {
                if (!data || Object.keys(data).length === 0) {
                    throw new Error('No data returned from API');
                }

                const labels = Object.keys(data);
                const bookingSummary = labels.map(label => data[label].bookingSummary || 0);
                const roomUsage = labels.map(label => data[label].roomUsage || 0);

                const newChartType = timeRange === 'month' ? 'bar' : 'line';

                const updatedOptions = {
                    chart: {
                        type: newChartType,
                        background: '#1f504d',
                    },
                    colors: ['#FCF8F3', '#abebf6'],
                    theme: {
                        mode: 'dark',
                    },
                    grid: {
                        borderColor: '#455b55',
                        row: {
                            colors: ['#264945', '#263f32'],
                            opacity: 0.5
                        },
                    },
                    xaxis: {
                        categories: labels,
                        labels: {
                            style: {
                                colors: '#FCF8F3',
                            },
                        },
                        axisBorder: {
                            color: '#455b55'
                        },
                        axisTicks: {
                            color: '#455b55'
                        },
                    },
                    yaxis: {
                        labels: {
                            style: {
                                colors: '#FCF8F3',
                            },
                        },
                    },
                    legend: {
                        labels: {
                            colors: '#FCF8F3',
                        },
                    },
                    tooltip: {
                        theme: 'dark',
                        style: {
                            fontSize: '12px',
                            fontFamily: 'Poppins'
                        },
                    },
                };

                areaChart.updateOptions(updatedOptions);

                areaChart.updateSeries([
                    {
                        name: 'Booking Summary',
                        data: bookingSummary
                    },
                    {
                        name: 'Room Usage',
                        data: roomUsage
                    }
                ]);
            })
            .catch(error => console.error('Error fetching data:', error));
    }

    function updateFilterOptions() {
        const timeRange = document.getElementById('time-range').value;
        const filterOptions = document.getElementById('filter-options');
        filterOptions.innerHTML = '';

        if (timeRange === 'month') {
            const months = [
                'January', 'February', 'March', 'April', 'May', 'June',
                'July', 'August', 'September', 'October', 'November', 'December'
            ];
            months.forEach(month => {
                const option = document.createElement('option');
                option.value = month;
                option.textContent = month;
                filterOptions.appendChild(option);
            });
        } else if (timeRange === 'year') {
            const currentYear = new Date().getFullYear();
            for (let year = currentYear; year >= currentYear - 10; year--) {
                const option = document.createElement('option');
                option.value = year;
                option.textContent = year;
                filterOptions.appendChild(option);
            }
        }
        updateChartData();
    }
    updateFilterOptions();

    //periodic updates (every 5 minutes)
    setInterval(updateChartData, 5 * 60 * 1000);
</script>

<script>
    //paras modal ni
    var modal = document.getElementById("report-modal");
    var btn = document.getElementById("generate-report-btn");
    var span = document.getElementsByClassName("closeRA")[0];

    btn.onclick = function () {
        modal.style.display = "block";
    }

    span.onclick = function () {
        modal.style.display = "none";
    }

    window.onclick = function (event) {
        if (event.target == modal) {
            modal.style.display = "none";
        }
    }
</script>

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap');
    @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap');

    body {
        margin: 0;
        font-family: 'Poppins', sans-serif;
        width: 100%;
        height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        overflow: hidden;
        background-color: #000;
    }

    .outer-container {
        box-sizing: border-box;
        background-color: var(--light);
        padding: 10px;
        border-radius: 15px;
        display: flex;
        flex-direction: column;
        width: calc(100% - 265px);
        height: calc(100% - 40px);
        top: 20px;
        right: 20px;
        bottom: 20px;
        margin-left: 100px;
        position: fixed;
        z-index: 5;
    }

        .outer-container.expand {
            width: calc(100% - 60px);
        }

    .main-content {
        height: 85vh;
        background-color: #185D62;
        padding: 20px;
        color: #fff;
        border-radius: 10px;
        width: 100%;
        box-sizing: border-box;
        flex-grow: 1;
        z-index: 5;
        overflow-y: auto;
    }

        .main-content nav {
            position: relative;
            height: 100px;
            width: calc(100% - 300px);
            padding-left: 20px;
            padding-right: 20px;
        }

    h1, h2 {
        color: #fff;
        font-size: 1.5rem;
    }

    h3 {
        color: #000;
    }

    h1 {
        font-size: 2.5rem;
        text-align: center;
        margin-bottom: 2rem;
    }

    .summary-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1rem;
        margin-bottom: 1rem;
        font-family: 'Inter', sans-serif;
    }

    .card {
        background-color: #EEF7FF;
        border-radius: 12px;
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
        padding: 1rem;
        position: relative;
        overflow: hidden;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.15);
        }

        .card h3 {
            margin-top: 0;
            margin-bottom: 1rem;
            font-size: 1.5rem;
            font-weight: 700;
            color: #1F2937;
        }

    .card-content {
        display: flex;
        flex-direction: column;
        gap: 0.8rem;
    }

    .stat {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .label {
        font-size: 0.875rem;
        color: #4B5563;
        font-weight: 500;
    }

    .value {
        font-size: 1rem;
        font-weight: 700;
        color: #1F2937;
    }

    .card i {
        position: absolute;
        top: 1rem;
        right: 1.2rem;
        font-size: 1.5rem;
        opacity: 0.5;
        color: #7AB2B2;
    }

    .charts-section {
        background-color: #185D62;
        border-radius: 8px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        margin-bottom: 1.5rem;
        padding: 0.5rem;
        align-items: center;
        justify-content: center;
    }

    .chart {
        height: 200px;
        margin-top: 0.5rem;
    }

    .filter-container {
        display: flex;
        gap: 0.5rem;
        margin-bottom: 1rem;
    }

    .filter-select {
        background-color: #EEF7FF;
        border: 1px solid #ccc;
        border-radius: 4px;
        padding: 0.25rem 0.5rem;
        font-size: 0.875rem;
        color: #333;
        outline: none;
        transition: border-color 0.2s;
        max-width: 125px; 
    }

        .filter-select:focus {
            border-color: #007bff;
        }


    .btn {
        padding: 0.6rem 1rem;
        border-radius: 25px;
        border: none;
        font-size: 0.9rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        text-transform: uppercase;
        letter-spacing: 0.7px;
    }

        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
        }

    #generate-report-btn {
        display: block;
        margin: 1.5rem auto;
        background-color: #4D869C;
        color: #fff;
        font-size: 1rem;
        padding: 0.8rem 1.5rem;
    }

    .pulse {
        animation: pulse 1.5s infinite;
    }

    @@keyframes pulse {
        0% {
            box-shadow: 0 0 0 0 rgba(114, 151, 98, 0.7);
        }

        70% {
            box-shadow: 0 0 0 7px rgba(52, 152, 219, 0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(52, 152, 219, 0);
        }
    }

    .modalRA {
        display: none;
        position: fixed;
        z-index: 1000;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        overflow: auto;
        background-color: rgba(0,0,0,0.6);
    }

    .modal-contentRA {
        background-color: #185D62;
        margin: 5% auto;
        padding: 2rem;
        border: none;
        width: 80%;
        max-width: 800px;
        border-radius: 12px;
        box-shadow: 0 15px 30px rgba(0, 0, 0, 0.2);
    }

    .closeRA {
        color: #aaa;
        float: right;
        font-size: 28px;
        font-weight: bold;
        cursor: pointer;
        transition: color 0.3s ease;
    }

        .closeRA:hover {
            color: #2c3e50;
        }

    .report-options {
        display: flex;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    select {
        flex-grow: 1;
        padding: 0.8rem 1rem;
        border-radius: 8px;
        border: 1px solid #ddd;
        font-size: 1rem;
        font-family: 'Poppins', sans-serif;
    }

    .btn-primary {
        background-color: #e7f0dc;
        color: #2c3e50;
    }

        .btn-primary:hover {
            background-color: #E6B9A6;
        }

    .btn-secondary {
        background-color: #ecf0f1;
        color: #a0937d;
    }

    .report-preview {
        background-color: #f9f9f9;
        border: 1px solid #ddd;
        border-radius: 8px;
        padding: 1.5rem;
        min-height: 200px;
    }

    @@media (max-width: 768px) {
        .summary-cards {
            grid-template-columns: 1fr;
        }

        .report-options {
            flex-direction: column;
        }

        .btn, select {
            width: 100%;
        }
    }

    .report-preview {
        margin-top: 20px;
        padding: 20px;
        border: 1px solid #ddd;
        border-radius: 5px;
        color: black; 
    }

        .report-preview table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
            color: black; 
        }

        .report-preview th, .report-preview td {
            border: 1px solid #ddd;
            padding: 8px;
            text-align: left;
            color: black; 
