@{
    ViewData["Title"] = "Analytics";
}
<div class="outer-container">
    <div class="main-content">
        <h1>Report and Analytics</h1>
        <!--I add dri report and analytics code for later -->
    </div>
</div>

@section Styles {
    <style>

         @* css code ni sa container, ayaw labti para uniform, scroll down naay space adto for manipulating styles *@

        body {
        margin: 0;
        font-family: Arial, sans-serif;
        width: 100%;
        height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        overflow: hidden;
        background-color: #000;
        }

        .outer-container {
            box-sizing: border-box;
            background-color: var(--light);
            padding: 10px;
            border-radius: 15px;
            display: flex;
            flex-direction: column-reverse;
            flex-direction: column;
            width: calc(100% - 215px);
            height: calc(100%-40px);
            top: 20px;
            right: 20px;
            bottom: 20px;
            margin-left: 100px;
            margin-right: 20px;
            position: fixed;
            z-index: 0;
        }

        .main-content {
            height: 85vh;
            background-color: #185D62;
            padding: 20px;
            color: #fff;
            border-radius: 10px;
            width: 100%;
            box-sizing: border-box;
            flex-grow: 1;
        }

        h1 {
            font-size: 36px;
            font-weight: 500;
            margin-top: 0;
            margin-bottom: 30px;
            letter-spacing: 0.5px;
        }

        <!--Add dri code sa imong css styles sa imong report and analytics nga code-->

    </style>
}