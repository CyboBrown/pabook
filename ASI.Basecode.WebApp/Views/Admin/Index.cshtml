                        row.innerHTML = `
                        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">${room.name}</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full ${room.type != 0 ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800'}">
                                ${roomTypes[room.type]}
                            </span>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${room.capacity}</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full ${room.location != 0 ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800'}">
                                ${locations[room.location]}
                            </span>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${room.facilities}</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                            <button class="details-room-btn text-green-600 hover:text-green-900 mr-2" data-id="${room.id}">Details</button>
                            <button class="edit-room-btn text-blue-600 hover:text-blue-900 mr-2" data-id="${room.id}">Edit</button>
                            <button class="delete-room-btn text-red-600 hover:text-red-900" data-id="${room.id}">Delete</button>
                        </td>
                    `;
                        tableBody.appendChild(row);
                    });

                    document.querySelectorAll('.edit-room-btn').forEach(btn => {
                        btn.addEventListener('click', () => editRoom(btn.dataset.id));
                    });
                    document.querySelectorAll('.details-room-btn').forEach(btn => {
                        btn.addEventListener('click', () => showRoomDetails(btn.dataset.id));
