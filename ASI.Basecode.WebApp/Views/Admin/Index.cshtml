                </button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to remove this room?</p>
            </div>
            <div class="modal-footer">
                <input type="hidden" id="RoomIdToDelete" />
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
