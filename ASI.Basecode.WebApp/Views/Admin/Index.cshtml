                    if (error.errors) {
                        // Check for specific validation errors
                        if (error.errors.id) {
                            errorMessage += '\n\nID Error: ' + error.errors.id[0]; // Display the specific validation error for 'id'
                        } else {
                            errorMessage += '\n\nDetails:\n' + JSON.stringify(error.errors, null, 2);
                        }
                    }

                    alert(errorMessage);
                })

                .finally(() => {
                    submitButton.disabled = false;
                    submitButton.textContent = this.dataset.mode === 'edit' ? 'Update Room' : 'Add Room';
                });
        });

