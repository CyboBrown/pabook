                .catch(error => console.error('Error fetching room details:', error));
        }

        document.getElementById('closeRoomDetailsModalBtn').onclick = function () {
            document.getElementById('roomDetailsModal').style.display = 'none';
        }

        //DELETE Room
        function deleteRoom(roomId) {
            if (confirm('Are you sure you want to remove this room?')) {
                fetch(`/api/Room/${roomId}`, { method: 'DELETE' })
                    .then(response => {
                        if (response.ok) {
                            const row = document.querySelector(`button[data-id="${roomId}"]`).closest('tr');
                            row.remove();
                            alert('Room cancelled successfully');
                        } else {
                            throw new Error('Failed to cancel room');
                        }
                    })
                    .catch(error => {
                        console.error('Error cancelling room:', error);
                        alert('Failed to cancel room. Please try again.');
                    });
            }
        }


        var roomModal = document.getElementById("addRoomModal");
        var roomBtn = document.getElementById("addRoomButton");
        var span = roomModal.getElementsByClassName("close")[0];

        roomBtn.onclick = function () {
            roomModal.style.display = "block";
            roomForm.reset();
        }

        span.onclick = function () {
            roomModal.style.display = "none";
        }

        window.onclick = function (event) {
            if (event.target == roomModal) {
                roomModal.style.display = "none";
            }
        }

        document.querySelector('.reset-button').addEventListener('click', function () {
            roomForm.reset();
            document.getElementById('recurrenceOptions').style.display = 'none';
        });
    });



    function searchFilterRooms() {
        var input, filter, table, tr, td, i, j, txtValue;
        input = document.getElementById("searchRoomsBar");
        filter = input.value.toUpperCase();
        table = document.getElementById("roomTable");
        tr = table.getElementsByTagName("tr");

        for (i = 1; i < tr.length; i++) { // Start from 1 to skip the header row
            let rowContainsFilter = false;
            for (j = 0; j < 4; j++) { // Check the first four columns
                td = tr[i].getElementsByTagName("td")[j];
                if (td) {
                    txtValue = (td.textContent || td.innerText).toUpperCase();
                    if (txtValue.indexOf(filter) > -1) {
                        rowContainsFilter = true;
                        break;
                    }
                }
            }
            if (rowContainsFilter) {
                tr[i].style.display = "";
            } else {
                tr[i].style.display = "none";
            }
        }
    }

    function toggleDropdownRoom() {
        document.getElementById('roomDropdown').classList.toggle('show');
    }

    function filterByLocation(room) {
        const filter = room;
        const table = document.getElementById('roomTable');
        const tr = table.getElementsByTagName('tr');
        for (let i = 1; i < tr.length; i++) {
            const td = tr[i].getElementsByTagName('td')[3];
            if (td) {
                const txtValue = (td.textContent || td.innerText).trim();
                console.log(filter);
                if (txtValue === filter) {
                    tr[i].style.display = '';
                } else {
                    tr[i].style.display = 'none';
                }
            }
        }
        document.getElementById('roomDropdown').classList.remove('show');
    }

    function showAllLocations() {
        const table = document.getElementById('roomTable');
        const tr = table.getElementsByTagName('tr');
        for (let i = 1; i < tr.length; i++) {
            tr[i].style.display = '';
        }
        document.getElementById('roomDropdown').classList.remove('show');
    } 
</script>





















