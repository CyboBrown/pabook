@section Styles {
    <script>
        toastr.options = {
            positionClass: "toast-top-center",
            timeOut: 5000,
            closeButton: true,
            progressBar: true
        };

        var successMessage = '@TempData["SuccessMessage"]';
        var addedRoom = '@TempData["AddedRoom"]';
        var successDeletion = '@TempData["SuccessDeletion"]';

        if (successMessage) {
            toastr.success(successMessage);
        }
        if (addedRoom) {
            toastr.success(addedRoom);
        }
        if (successDeletion) {
            toastr.success(successDeletion);
        }
        
        function showDeleteModal(roomId) {
            document.getElementById('RoomIdToDelete').value = roomId;
            $('#deleteModal').modal('show');
        }

        // Function to handle deletion after confirmation
        function confirmDelete() {
            var roomId = document.getElementById('RoomIdToDelete').value;

            $.ajax({
                url: '@Url.Action("PostDelete", "Admin")',
                type: 'POST',
                data: { id: roomId },
                success: function () {
                    toastr.success('Room deleted successfully.');
                    $('#deleteModal').modal('hide');
                    refreshRoomDetails(); 
                },
                error: function () {
                    toastr.error('Failed to delete room.');
                }
            });
        }


        function showRoomDetails(floor) {
            $.ajax({
                url: '@Url.Action("GetRoomDetailsByFloor", "Admin")',
                type: 'GET',
                data: { floor: floor },
                success: function (result) {
                    $('#room-details-body').html(result);
                },
                error: function () {
                    alert('Failed to load room details.');
                }
            });
        }

        function showUserDetails() {
            $.ajax({
                url: '@Url.Action("GetAll", "Admin")',
                type: 'GET',
                data: { floor: floor },
                success: function (result) {
                    $('#room-details-body').html(result);
                },
                error: function () {
                    alert('Failed to load user details.');
                }
            });
        }


        function refreshRoomDetails() {
            $.ajax({
                url: '@Url.Action("GetRoomDetails", "Admin")',
                type: 'GET',
                success: function (data) {
                    $('#room-details-body').html(data); // Replace table body with updated data
                    toastr.success('Room details refreshed.');
                },
                error: function () {
                    toastr.error('Failed to refresh room details.');
                }
            });
        }

   </script> 
