@model ASI.Basecode.Services.ServiceModels.RoomViewModel
@{
    ViewData["Title"] = "Admin Home Page";
}

<div class="outer-container">
    <div class="main-content">
        <div class="mytabs">
            <input type="radio" id="tabfree" name="mytabs" checked="checked">
            <label for="tabfree">Bookings</label>
            <div class="tab">
              <h2>Bookings</h2>
              <p>sorry kj di gyud nako makuha imong code lisod kaayu</p>
                
              
            </div>

            <input type="radio" id="tabsilver" name="mytabs">
            <label for="tabsilver">User</label>
            <div class="tab">
              <h2>User</h2>
              <p>DRI INYONG INPUT</p>
            </div>

            <input type="radio" id="tabgold" name="mytabs">
            <label for="tabgold">Room</label>
            <div class="tab">
              <h2>Room</h2>
              <div class="floor-buttons">
                <button onclick="showRoomDetails('floor10')">
                    <i class='bx bxs-group'></i>
                    <span>10th Floor</span>
                </button>
                <button onclick="showRoomDetails('floor11')">
                    <i class='bx bxs-group'></i>
                    <span>11th Floor</span>
                </button>
                <button onclick="showRoomDetails('floor14')">
                    <i class='bx bxs-group'></i>
                    <span>14th Floor</span>
                </button>

              </div>

            </div>

        </div>
    </div>
</div>




@section Styles {
    <style>

         @*css code ni sa container, ayaw labti para uniform, scroll down naay space adto for manipulating styles *@
        body {
        margin: 0;
        font-family: Arial, sans-serif;
        width: 100%;
        height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        overflow: hidden;
        background-color: #000;
        }

        .outer-container {
            
            box-sizing: border-box;
            background-color: var(--light);
            padding: 10px;
            border-radius: 15px;
            display: flex;
            flex-direction: column-reverse;
            flex-direction: column;
            width: calc(100% - 215px);
            height: calc(100%-40px);
            top: 20px;
            right: 20px;
            bottom: 20px;
            margin-left: 100px;
            margin-right: 20px;
            position: fixed;
            z-index: 0;
        }

        .outer-container.expand{           
            width: calc(100% - 60px);
        }

        .main-content {
            height: 85vh;
            background-color: #185D62;
            padding: 20px;
            color: #fff;
            border-radius: 10px;
            width: 100%;
            box-sizing: border-box;
            flex-grow: 1;
        }
        .main-content nav{
            position: relative;
            height: 100px;
            width: calc(100%-300px);
            padding-left: 20px;
            padding-right: 20px;
        }       
        
       
        .mytabs {
            display: flex;
            flex-wrap: wrap;
            padding: 25px;
            background-color: #185D62;
            display: flex;
            justify-content: left;
            margin-bottom: 20px;
            
            margin-left: 0px;
            padding: 0px;
        }
        .mytabs input[type="radio"] {
            display: none;
        }
        .mytabs label {
            padding: 15px;
            background: #185D62;
            font-weight: bold;
            border-bottom: 2px solid #1BC7D2;
            width: 100px;
            text-align: center;
        }

        .mytabs .tab {
            width: 100%;
            padding: 20px;
            background: #185D62;
            order: 1;
            display: none;
        }
        .mytabs .tab h2 {
            font-size: 3em;
        }

        .mytabs input[type='radio']:checked + label + .tab {
            display: block;
        }

        .mytabs input[type="radio"]:checked + label {
            background: #1BC7D2;
        }
        
        
    </style>  
}