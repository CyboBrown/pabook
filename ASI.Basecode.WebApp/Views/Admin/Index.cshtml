                .then(user => {
                    const modal = document.getElementById('userDetailsModal');
                    const content = document.getElementById('userDetailsContent');
                    content.innerHTML = `
                        <p class="mb-2" > <strong>Username:</strong> ${user.userName}</p>
                        <p class="mb-2" > <strong>Last Name: </strong> ${user.lastName}</p >
                        <p class="mb-2" > <strong>First Name: </strong> ${user.firstName}</p >
                        <p class="mb-2" > <strong>Email: </strong> ${user.email}</p >
                        <p class="mb-2" > <strong>Role: </strong> ${roles[user.userRole]}</p >
                        `;
                    modal.style.display = 'block';
                })
                .catch(error => console.error('Error fetching user details:', error));
        }

        document.getElementById('closeUserDetailsModalBtn').onclick = function () {
            document.getElementById('userDetailsModal').style.display = 'none';
        }

        //DELETE User
        function deleteUser(userId) {
            if (confirm('Are you sure you want to remove this User?')) {
                fetch(`/api/UserManagement/${userId}`, { method: 'DELETE' })
                    .then(response => {
                        if (response.ok) {
                            const row = document.querySelector(`button[data-id="${userId}"]`).closest('tr');
                            row.remove();
                            alert('User removed successfully');
                        } else {
                            throw new Error('Failed to remove user');
                        }
                    })
                    .catch(error => {
                        console.error('Error removing user:', error);
                        alert('Failed to remove user. Please try again.');
                    });
            }
        }

        var userModal = document.getElementById("addUserModal");
        var userBtn = document.getElementById("addUserButton");
        var span = userModal.getElementsByClassName("close")[0];

        userBtn.onclick = function () {
            userModal.style.display = "block";
            userForm.reset();
        }

        span.onclick = function () {
            userModal.style.display = "none";
        }

        window.onclick = function (event) {
            if (event.target == userModal) {
                userModal.style.display = "none";
            }
        }

        document.querySelector('.reset-button').addEventListener('click', function () {
            userForm.reset();
        });
     });

    function searchFilterUser() {
