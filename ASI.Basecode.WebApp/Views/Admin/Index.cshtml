@model ASI.Basecode.Services.ServiceModels.AdminHomeViewModel
<link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
<link href="https://unpkg.com/flowbite@1.4.7/dist/flowbite.min.css" rel="stylesheet">

@{
    ViewData["Title"] = "Admin Home Page";
}
<div class="outer-container">
    <div class="main-content">
        <div class="header">
            <div id="bookingsTab" class="tab active" onclick="switchTab('bookings')">
                <i class="fas fa-calendar-alt"></i>
                <span>Bookings</span>
            </div>
            <div id="usersTab" class="tab" onclick="switchTab('users')">
                <i class="fas fa-users"></i>
                <span>Users</span>
            </div>
            <div id="roomsTab" class="tab" onclick="switchTab('rooms')">
                <i class="fas fa-door-open"></i>
                <span>Rooms</span>
                
            </div>
        </div>
        <div id="bookingsContent" class="content flex">
            <div class="left-pane">
                <div class="background-image">
                    <div class="overlay">
                        <div class="date-time">
                            <span id="time-now" class="time-now"></span><br>
                            <span id="date-now" class="date-now"></span>
                        </div>
                        <div class="book-now">
                            <button>Book now</button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="right-pane">
                <div class="booking-info">
                    <h1 class="text-3xl font-bold mb-4">Today's Booking</h1>
                    
                    <div class="overflow-x-auto">
                        <div class="max-h-96 overflow-y-auto">
                            <table class="min-w-full bg-white border border-gray-200 rounded-lg">
                                <thead class="bg-gray-50">
                                    <tr>
                                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Time</th>
                                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Title</th>
                                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Room</th>
                                    </tr>
                                </thead>
                                <tbody id="bookingItems" class="divide-y divide-gray-200">
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div id="usersContent" class="content hidden">
            <div class="container mx-auto p-4 bg-gray-100" style="height: 79vh;">
                <h2 class="text-3xl font-bold mb-4 text-gray-800">Users</h2>
                <div class="flex flex-col sm:flex-row justify-between items-center mb-6 space-y-4 sm:space-y-0">
                    <input type="text" id="searchUsersBar" class="w-full sm:w-2/3 p-2 border border-gray-300 rounded-md shadow-sm focus:ring-2 focus:ring-blue-400 focus:border-blue-400" placeholder="Search users...">
                    <button id="filterUsersButton" class="w-full sm:w-auto sm:ml-4 px-4 py-2 bg-blue-600 text-white rounded-md flex items-center justify-center hover:bg-blue-700 transition duration-300 ease-in-out">
                        <i class="fas fa-filter mr-2"></i>
                        Filter
                    </button>
                </div>
                <div class="bg-white shadow-lg rounded-lg overflow-hidden">
                    <div class="table-container" style="overflow-x: auto; max-height: calc(79vh - 10rem);">
                        <table class="min-w-full max-w-full divide-y divide-gray-200">
                            <thead class="bg-gray-50">
                                <tr>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">User Name</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Email</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Role</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="usersTableBody" class="bg-white divide-y divide-gray-200">
                                <!-- User data goes here -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <div id="roomsContent" class="content hidden">
            <div class="container mx-auto p-4 bg-gray-100" style="height: 79vh;">
                <h2 class="text-3xl font-bold mb-4 text-gray-800">Rooms</h2>
                <div class="flex flex-col sm:flex-row justify-between items-center mb-6 space-y-4 sm:space-y-0">
                    <input type="text" id="searchRoomsBar" class="w-full sm:w-2/3 p-2 border border-gray-300 rounded-md shadow-sm focus:ring-2 focus:ring-blue-400 focus:border-blue-400" placeholder="Search rooms...">
                    <div class="flex space-x-2">
                        <button id="filterRoomsButton" class="px-4 py-2 bg-blue-600 text-white rounded-md flex items-center justify-center hover:bg-blue-700 transition duration-300 ease-in-out">
                            <i class="fas fa-filter mr-2"></i>
                        </button>
                        <button id="addRoomButton" class="px-4 py-2 bg-green-600 text-white rounded-md flex items-center justify-center hover:bg-green-700 transition duration-300 ease-in-out">
                            <i class="fas fa-plus"></i>
                        </button>
                        <button id="refreshRoomsButton" class="px-4 py-2 bg-blue-600 text-white rounded-md flex items-center justify-center hover:bg-blue-700 transition duration-300 ease-in-out">
                            <i class="fas fa-sync-alt"></i>
                        </button>
                        
                    </div>
                </div>
                <div class="bg-white shadow-lg rounded-lg overflow-hidden">
                    <div class="table-container" style="overflow-x: auto; max-height: calc(79vh - 10rem);">
                        <table class="min-w-full max-w-full divide-y divide-gray-200">
                            <thead class="bg-gray-50">
                                <tr>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Room Name</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Room Type</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Capacity</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Location</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Facilities</th>
                                </tr>
                            </thead>
                            <tbody id="roomsTableBody" class="bg-white divide-y divide-gray-200">
                                <!-- Room data goes here -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<div id="addRoomModal" class="modal">
    <div class="modal-content">
        <span class="close">&times;</span>
        <h1 style="font-size: 2.5rem;">Add Room</h1>
        <form id="roomForm">
            <div class="form-group full-width">
                <label for="roomName">Room Name:</label>
                <input type="text" id="roomName" name="roomName" required>
            </div>

            <div class="form-group full-width">
                <label for="roomType">Room Type:</label>
                <input type="text" id="roomType" name="roomType" required>
            </div>

            <div class="form-group full-width">
                <label for="capacity">Capacity:</label>
                <input type="number" id="capacity" name="capacity" required>
            </div>

            <div class="form-group full-width">
                <label for="location">Location:</label>
                <input type="text" id="location" name="location" required>
            </div>

            <div class="form-group full-width">
                <label for="facilities">Facilities:</label>
                <textarea id="facilities" name="facilities"></textarea>
            </div>

            <div class="form-group full-width">
                <button type="submit">Add Room</button>
                <button type="reset" class="reset-button">Reset</button>
            </div>
        </form>
    </div>
</div>



<script>
    function switchTab(tabName) {
        // Hide all content sections
        document.getElementById('bookingsContent').style.display = 'none';
        document.getElementById('usersContent').style.display = 'none';
        document.getElementById('roomsContent').style.display = 'none';

        // Remove the active class from all tabs
        document.getElementById('bookingsTab').classList.remove('active');
        document.getElementById('usersTab').classList.remove('active');
        document.getElementById('roomsTab').classList.remove('active');

        // Show the selected content and add the active class to the selected tab
        document.getElementById(tabName + 'Content').style.display = 'flex';
        document.getElementById(tabName + 'Tab').classList.add('active');
    }


</script>

<script>
    // Open/close the booking modal
    var bookingModal = document.getElementById("addMeetingModal");
    var bookingBtn = document.querySelector(".book-now button");
    var bookingSpan = bookingModal.getElementsByClassName("close")[0];

    bookingBtn.onclick = function () {
        bookingModal.style.display = "block";
        document.getElementById('bookingForm').reset(); // reset button
    }

    bookingSpan.onclick = function () {
        bookingModal.style.display = "none";
    }

    window.onclick = function (event) {
        if (event.target == bookingModal) {
            bookingModal.style.display = "none";
        }
    }

    // Open/close the room modal
    var roomModal = document.getElementById("addRoomModal");
    var roomBtn = document.getElementById("addRoomButton");
    var roomSpan = roomModal.getElementsByClassName("close")[0];

    roomBtn.onclick = function () {
        roomModal.style.display = "block";
        document.getElementById('roomForm').reset(); // reset button
    }

    roomSpan.onclick = function () {
        roomModal.style.display = "none";
    }

    window.onclick = function (event) {
        if (event.target == roomModal) {
            roomModal.style.display = "none";
        }
    }
</script>

