                    //alert('Room ' + (method === 'POST' ? 'created' : 'updated') + ' successfully!');
                    
                    // Add success alert only for new bookings
                    if (method === 'POST') {
                        alert('Room created successfully!');
                    } else {
                        alert('Room updated successfully!');
                    }
                })
            
                .catch(error => {
                    
                    let errorMessage = 'An error occurred while ' + (this.dataset.mode === 'edit' ? 'updating' : 'creating') + ' the room. Please try again.';

                    if (error.status) {
                        errorMessage += '\n\nStatus Code: ' + error.status;
