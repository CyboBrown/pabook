@model IEnumerable<ASI.Basecode.Services.ServiceModels.RoomViewModel>

@{
    ViewData["Title"] = "Admin Home Page";
}

<div class="outer-container">
    <div class="main-content">
        <div class="mytabs">
            <input type="radio" id="tabBookings" name="mytabs" onchange="loadTabContent('Bookings')" @((ViewData["ActiveTab"] as string == "Bookings") ? "checked" : "")>
            <label for="tabBookings">Bookings</label>
            <div class="tab" id="tabBookingsContent">
              <h2>Bookings</h2>
              <p>sorry kj di gyud nako makuha imong code lisod kaayu</p>
                
              
            </div>

            <input type="radio" id="tabUser" name="mytabs" onchange="loadTabContent('User')" @((ViewData["ActiveTab"] as string == "User") ? "checked" : "")>
            <label for="tabUser">User</label>
            <div class="tab" id="tabUserContent">
              <h2>User</h2>
              <p>DRI INYONG INPUT</p>
            </div>

            <input type="radio" id="tabRoom" name="mytabs" onchange="loadTabContent('Room')" @((ViewData["ActiveTab"] as string == "Room") ? "checked" : "")>
            <label for="tabRoom">Room</label>

            <div class="tab" id="tabRoomContent">
              <h2>Room</h2>
              <div class="floor-buttons">
                <button onclick="showRoomDetails('floor10')">
                    <i class='bx bxs-group'></i>
                    <span>10th Floor</span>
                </button>
                <button onclick="showRoomDetails('floor11')">
                    <i class='bx bxs-group'></i>
                    <span>11th Floor</span>
                </button>
                <button onclick="showRoomDetails('floor14')">
                    <i class='bx bxs-group'></i>
                    <span>14th Floor</span>
                </button>

              </div>
              <div class="table-data">
                <div class="order">
                    <div class="head">
                        <h3>Room Details</h3>

                        <div class="add-room">
                                <a href="@Url.Action("CreateRoom", "Admin")" class="btn btn-success">
                                    <i class='bx bx-plus'></i> 
                                </a>
                        </div>
                        <div class="refresh">
                            <button class="btn btn-secondary btn-sm" onclick="refreshPage()">
                                <i class='bx bx-refresh'></i> 
                            </button>
                        </div>
                        
                    </div>
                    
                    <div class="scroll-div">
                        <table class="table-scroll">
                            <thead>
                                <tr>
                                    <th>@Html.DisplayNameFor(model => model.Id)</th>
                                    <th>@Html.DisplayNameFor(model => model.Name)</th>
                                    <th>@Html.DisplayNameFor(model => model.Type)</th>
                                    <th>@Html.DisplayNameFor(model => model.Capacity)</th>
                                    <th>@Html.DisplayNameFor(model => model.Location)</th>
                                    <th>@Html.DisplayNameFor(model => model.Facilities)</th>
                                </tr>
                            </thead>
                            <tbody id="room-details-body">
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@Html.DisplayFor(modelItem => item.Id)</td>
                                        <td>@Html.DisplayFor(modelItem => item.Name)</td>
                                        <td>@Html.DisplayFor(modelItem => item.Type)</td>
                                        <td>@Html.DisplayFor(modelItem => item.Capacity)</td>
                                        <td>@Html.DisplayFor(modelItem => item.Location)</td>
                                        <td> @Html.DisplayFor(modelItem => item.Facilities)</td>
                                        <td>@Html.ActionLink("Edit", "Edit", "Room", new { Id = item.Id }, new { @class = "btn btn-primary btn-sm" }) |
                                            @Html.ActionLink("Details", "Details", "Room", new { Id = item.Id }, new { @class= "btn btn-privacy btn-sm" }) |                              
                                            <button class="btn btn-danger btn-sm" onclick="showDeleteModal(@item.Id)">Delete</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>                            
                        </table>    
                    </div>
                </div>
              </div>
            </div>
            
        </div>
    </div>
</div>

<!-- _DeleteModal.cshtml -->
<div class="modal fade" id="deleteModal" tabindex="-1" role="dialog" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">Confirm Deletion</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to remove this room?</p>
            </div>
            <div class="modal-footer">
                <input type="hidden" id="RoomIdToDelete" />
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" onclick="confirmDelete()">Delete</button>
            </div>
        </div>
    </div>
</div>



@section Styles {
    <script>
        toastr.options = {
            positionClass: "toast-top-center",
            timeOut: 5000,
            closeButton: true,
            progressBar: true
        };

        var successMessage = '@TempData["SuccessMessage"]';
        var addedRoom = '@TempData["AddedRoom"]';
        var successDeletion = '@TempData["SuccessDeletion"]';

        if (successMessage) {
            toastr.success(successMessage);
        }
        if (addedRoom) {
            toastr.success(addedRoom);
        }
        if (successDeletion) {
            toastr.success(successDeletion);
        }
        
        function showDeleteModal(roomId) {
            document.getElementById('RoomIdToDelete').value = roomId;
            $('#deleteModal').modal('show');
        }

        // Function to handle deletion after confirmation
        function confirmDelete() {
            var roomId = document.getElementById('RoomIdToDelete').value;

            $.ajax({
                url: '@Url.Action("PostDelete", "Admin")',
                type: 'POST',
                data: { id: roomId },
                success: function () {
                    toastr.success('Room deleted successfully.');
                    $('#deleteModal').modal('hide');
                    refreshRoomDetails(); 
                },
                error: function () {
                    toastr.error('Failed to delete room.');
                }
            });
        }


        function refreshRoomDetails() {
            // Implement a function to refresh room details
            $.ajax({
                url: '@Url.Action("GetRoomDetails", "Room")', // Example URL to fetch updated data
                type: 'GET',
                success: function (data) {
                    $('#room-details-body').html(data); // Replace table body with updated data
                },
                
            });
        }

        function loadTabContent(tab) {
            let contentUrl = '';
            switch(tab) {
                case 'Room':
                    contentUrl = '@Url.Action("GetRoomContent", "Admin")';
                    break;
                case 'User':
                    contentUrl = '@Url.Action("GetUserContent", "Admin")';
                    break;
                case 'Bookings':
                    contentUrl = '@Url.Action("GetBookingsContent", "Admin")';
                    break;
            }

            if (contentUrl) {
                $.ajax({
                    url: contentUrl,
                    type: 'GET',
                    success: function (data) {
                        $('#tabContent').html(data); // Update tab content
                    }
                });
            }
        }


   </script> 
}

