@{
    ViewData["Title"] = "Admin Home Page";
}
<div class="outer-container">
    <div class="main-content">
        <h1>Admin Home</h1>
        <!--I add dri admin home code for later -->
    </div>
</div>

@section Styles {
    <style>

        @* css code ni sa container, ayaw labti para uniform, scroll down naay space adto for manipulating styles *@
         body {
        margin: 0;
        font-family: Arial, sans-serif;
        width: 100%;
        height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        overflow: hidden;
        background-color: #000;
        }

        .outer-container {
            background-color: #f0f0f0;
            padding: 20px;
            border-radius: 20px;
            display: flex;
            flex-direction: column;
            height: calc(100vh - 40px);
            width: calc(150vh - 10px);
            box-sizing: border-box;
            justify-content: center;
            align-items: center;
        }

        .main-content {
            height: 85vh;
            background-color: #185D62;
            padding: 20px;
            color: #fff;
            border-radius: 10px;
            width: 100%;
            box-sizing: border-box;
            flex-grow: 1;
        }

        h1 {
            font-size: 36px;
            font-weight: 500;
            margin-top: 0;
            margin-bottom: 30px;
            letter-spacing: 0.5px;
        }
         <!--Add dri code sa imong css styles sa imong admin home nga code-->

    </style>
}