@model ASI.Basecode.Services.ServiceModels.AdminHomeViewModel
<link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
<link href="https://unpkg.com/flowbite@1.4.7/dist/flowbite.min.css" rel="stylesheet">

@{
    ViewData["Title"] = "Admin Home Page";
}

@*Home Page*@
<div class="outer-container">
    <div class="main-content">
        <div class="header">
            <div id="bookingsTab" class="tab active" onclick="switchTab('bookings')">
                <i class="fas fa-calendar-alt"></i>
                <span>Bookings</span>
            </div>
            <div id="usersTab" class="tab" onclick="switchTab('users')">
                <i class="fas fa-users"></i>
                <span>Users</span>
            </div>
            <div id="roomsTab" class="tab" onclick="switchTab('rooms')">
                <i class="fas fa-door-open"></i>
                <span>Rooms</span>
                
            </div>
        </div>
        @*Bookings View*@
        <div id="bookingsContent" class="content flex">
            <div class="container mx-auto p-4 bg-gray-100" style="height: 79vh;">
                <h2 class="text-3xl font-bold mb-4 text-gray-800">Bookings</h2>
                <div class="flex flex-col sm:flex-row justify-between items-center mb-6 space-y-4 sm:space-y-0">
                    <input type="text" id="searchBar" class="w-full sm:w-2/3 p-2 mr-2 border border-gray-300 rounded-md shadow-sm focus:ring-2 focus:ring-blue-400 focus:border-blue-400" placeholder="Search bookings...">
                    <div class="flex space-x-2">
                        <button id="filterBookingsButton" class="px-4 py-2 bg-blue-600 text-white rounded-md flex items-center justify-center hover:bg-blue-700 transition duration-300 ease-in-out">
                            <i class="fas fa-filter"></i>
                        </button>
                        <div class="book-now">
                        <button id="addBookingButton" class="px-4 py-2 bg-red-600 text-white rounded-md flex items-center justify-center hover:bg-red-700 transition duration-300 ease-in-out">
                            <i class="fas fa-plus"></i>
                        </button>
                        </div>
                        <button id="refreshBookingsButton" class="px-4 py-2 bg-green-600 text-white rounded-md flex items-center justify-center hover:bg-green-700 transition duration-300 ease-in-out">
                            <i class="fas fa-sync-alt"></i> 
                        </button>
                    </div>
                </div>
                <div class="bg-white shadow-lg rounded-lg overflow-hidden">
                    <div class="table-container" style="overflow-x: auto; max-height: calc(79vh - 10rem);">
                        <table class="min-w-full max-w-full divide-y divide-gray-200">
                            <thead class="bg-gray-50">
                                <tr>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Booking Name</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date & Time</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Room</th>
                                    <th class="px-2 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Recurring</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="bookingsTableBody" class="bg-white divide-y divide-gray-200">
                                <!-- ari ang mga bookings ma display -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        @*User View*@
        <div id="usersContent" class="content hidden">
            <div class="container mx-auto p-4 bg-gray-100" style="height: 79vh;">
                <h2 class="text-3xl font-bold mb-4 text-gray-800">Users</h2>
                <div class="flex flex-col sm:flex-row justify-between items-center mb-6 space-y-4 sm:space-y-0">
                    <input type="text" id="searchUsersBar" class="w-full sm:w-2/3 p-2 border border-gray-300 rounded-md shadow-sm focus:ring-2 focus:ring-blue-400 focus:border-blue-400" placeholder="Search users...">
                    <button id="filterUsersButton" class="w-full sm:w-auto sm:ml-4 px-4 py-2 bg-blue-600 text-white rounded-md flex items-center justify-center hover:bg-blue-700 transition duration-300 ease-in-out">
                        <i class="fas fa-filter mr-2"></i>
                        Filter
                    </button>
                </div>
                <div class="bg-white shadow-lg rounded-lg overflow-hidden">
                    <div class="table-container" style="overflow-x: auto; max-height: calc(79vh - 10rem);">
                        <table class="min-w-full max-w-full divide-y divide-gray-200">
                            <thead class="bg-gray-50">
                                <tr>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">User Name</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Email</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Role</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="usersTableBody" class="bg-white divide-y divide-gray-200">
                                <!-- User data goes here -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        @*Room View*@
        <div id="roomsContent" class="content hidden">
            <div class="container mx-auto p-4 bg-gray-100" style="height: 79vh;">
                <h2 class="text-3xl font-bold mb-4 text-gray-800">Rooms</h2>
                <div class="flex flex-col sm:flex-row justify-between items-center mb-6 space-y-4 sm:space-y-0">
                    <input type="text" id="searchRoomsBar" class="w-full sm:w-2/3 p-2 border border-gray-300 rounded-md shadow-sm focus:ring-2 focus:ring-blue-400 focus:border-blue-400" placeholder="Search rooms...">
                    <div class="flex space-x-2">
                        <button id="filterRoomsButton" class="px-4 py-2 bg-blue-600 text-white rounded-md flex items-center justify-center hover:bg-blue-700 transition duration-300 ease-in-out">
                            <i class="fas fa-filter mr-2"></i>
                        </button>
                        <button id="addRoomButton" class="px-4 py-2 bg-green-600 text-white rounded-md flex items-center justify-center hover:bg-green-700 transition duration-300 ease-in-out">
                            <i class="fas fa-plus"></i>
                        </button>
                        <button id="refreshRoomsButton" class="px-4 py-2 bg-blue-600 text-white rounded-md flex items-center justify-center hover:bg-blue-700 transition duration-300 ease-in-out">
                            <i class="fas fa-sync-alt"></i>
                        </button>
                    </div>
                </div>
                <div class="bg-white shadow-lg rounded-lg overflow-hidden">
                    <div class="table-container" style="overflow-x: auto; max-height: calc(79vh - 10rem);">
                        <table class="min-w-full max-w-full divide-y divide-gray-200">
                            <thead class="bg-gray-50">
                                <tr>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Room Name</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Room Type</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Capacity</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Location</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Facilities</th>
                                </tr>
                            </thead>
                            <tbody id="roomsTableBody" class="bg-white divide-y divide-gray-200">
                                <!-- Room data goes here -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@*Add Booking Modal*@
<div id="addBookingModal" class="modal">
    <div class="modal-content">
        <span class="close">&times;</span>
        <h1 style="font-size: 2.5rem;">Booking Form</h1>
        <form id="bookingForm">
            <div class="form-group full-width">
                <label for="title">Title:</label>
                <input type="text" id="title" name="title" required>
            </div>

            <div class="form-group full-width">
                <label for="description">Description:</label>
                <input type="text" id="description" name="description">
            </div>

            <div class="form-group">
                <label for="date">Date:</label>
                <input type="date" id="date" name="date" required>
            </div>

            <div class="form-group">
                <label for="room">Room:</label>
                <select id="room" name="room" required>
                    <option value="">Select a room</option>
                </select>
            </div>

            <div class="form-group">
                <label for="startTime">Start Time:</label>
                <input type="time" id="startTime" name="startTime" required>
            </div>

            <div class="form-group">
                <label for="endTime">End Time:</label>
                <input type="time" id="endTime" name="endTime" required>
            </div>

            <div class="form-group full-width">
                <label for="recurring">Recurring:</label>
                <select id="recurring" name="recurring">
                    <option value="false">No</option>
                    <option value="true">Yes</option>
                </select>
            </div>

            <div id="recurrenceOptions" class="full-width" style="display: none;">
                <div class="form-group-half">
                    <label for="recurrenceType">Recurrence Type:</label>
                    <select id="RecurrenceTypeId" name="RecurrenceTypeId" class="form-control">
                        <option value="">Select Recurrence Type</option>
                    </select>
                </div>

                <div class="form-group-half">
                    <label for="recurrenceEndDate">Recurrence End Date:</label>
                    <input type="date" id="recurrenceEndDate" name="recurrenceEndDate">
                </div>
            </div>

            <div class="form-group full-width">
                <button type="submit">Create Booking</button>
                <button type="reset" class="reset-button">Reset</button>
            </div>
        </form>
    </div>
</div>

