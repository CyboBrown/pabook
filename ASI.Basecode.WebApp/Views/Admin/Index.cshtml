<script>
    function switchTab(tabName) {
        // Hide all content sections
        document.getElementById('bookingsContent').style.display = 'none';
        document.getElementById('usersContent').style.display = 'none';
        document.getElementById('roomsContent').style.display = 'none';

        // Remove the active class from all tabs
        document.getElementById('bookingsTab').classList.remove('active');
        document.getElementById('usersTab').classList.remove('active');
        document.getElementById('roomsTab').classList.remove('active');

        // Show the selected content and add the active class to the selected tab
        document.getElementById(tabName + 'Content').style.display = 'flex';
        document.getElementById(tabName + 'Tab').classList.add('active');
    }
</script>



@*Booking Script*@
<script>
    recurrenceTypes = ['Unassigned', 'Daily', 'Weekly', 'Monthly'];
    room = ['Conference Room A', 'Meeting Room B', 'Training Room C'];
    document.addEventListener("DOMContentLoaded", function () {
        // Fetch rooms and populate the select element
        fetch('/api/Booking/rooms')
            .then(response => response.json())
            .then(data => {
                const roomSelect = document.getElementById('room');
                data.forEach(room => {
                    const option = document.createElement('option');
                    option.value = room.id;
                    option.text = room.name;
                    roomSelect.appendChild(option);
                });
            })
            .catch(error => console.error('Error fetching rooms:', error));

        //For fetching recurr types
        function populateRecurrenceTypes() {
            $.ajax({
                url: '/api/Booking/recurrenceTypes',
                type: 'GET',
                success: function (data) {
                    var dropdown = $('#RecurrenceTypeId');
                    dropdown.empty();
                    dropdown.append($('<option></option>').val('').text('Select Recurrence Type'));
                    $.each(data, function (i, item) {
                        dropdown.append($('<option></option>').val(item.id).text(item.name));
                    });
                },
                error: function (error) {
                    console.log('Error fetching recurrence types:', error);
                }
            });
        }

        // Call this function when the page loads
        $(document).ready(function () {
            populateRecurrenceTypes();
        });


        // Add form validation
        function validateForm() {
            const requiredFields = bookingForm.querySelectorAll('[required]');
            let isValid = true;
            requiredFields.forEach(field => {
                if (!field.value.trim()) {
                    isValid = false;
                    field.classList.add('invalid');
                } else {
                    field.classList.remove('invalid');
                }
            });
            return isValid;
        }

        // format time to TimeSpan string
        function formatTimeToTimeSpan(timeString) {
            const [hours, minutes] = timeString.split(':');
            return `${hours.padStart(2, '0')}:${minutes}:00`;
        }

        const bookingForm = document.getElementById('bookingForm');
        const submitButton = bookingForm.querySelector('button[type="submit"]');

        let currentPage = 1;
        const itemsPerPage = 5;

        function loadBookings(page = 1) {
            fetch('/api/Booking/bookings')
                .then(response => {
                    if (!response.ok) {
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }
                    return response.json();
                })
                .then(data => {
                    const totalItems = data.length;
                    const totalPages = Math.ceil(totalItems / itemsPerPage);
                    currentPage = page;

                    const startIndex = (currentPage - 1) * itemsPerPage;
                    const endIndex = startIndex + itemsPerPage;
                    const currentItems = data.slice(startIndex, endIndex);

                    const tableBody = document.getElementById('bookingsTableBody');
                    tableBody.innerHTML = '';
                    currentItems.forEach(booking => {
                        const row = document.createElement('tr');
                        row.innerHTML = `
                        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">${booking.title}</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${new Date(booking.date).toLocaleDateString()} ${booking.startTime} - ${booking.endTime}</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${booking.roomName}</td>
                        <td class="px-3 py-4 whitespace-nowrap text-sm text-gray-500">
                            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full ${booking.recurring ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800'}">
                                ${booking.recurring ? recurrenceTypes[booking.recurrenceTypeId] : 'No'}
                            </span>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                            <button class="details-btn text-green-600 hover:text-green-900 mr-2" data-id="${booking.id}">Details</button>
                            <button class="edit-btn text-blue-600 hover:text-blue-900 mr-2" data-id="${booking.id}">Edit</button>
                            <button class="cancel-btn text-red-600 hover:text-red-900" data-id="${booking.id}">Cancel Booking</button>
                        </td>
                    `;
                        tableBody.appendChild(row);
                    });

                    document.querySelectorAll('.edit-btn').forEach(btn => {
                        btn.addEventListener('click', () => editBooking(btn.dataset.id));
                    });
                    document.querySelectorAll('.details-btn').forEach(btn => {
                        btn.addEventListener('click', () => showBookingDetails(btn.dataset.id));
                    });
                    document.querySelectorAll('.cancel-btn').forEach(btn => {
                        btn.addEventListener('click', () => cancelBooking(btn.dataset.id));
                    });

                    generatePagination(totalPages);
                })
                .catch(error => console.error('Error fetching bookings:', error));
        }

        function generatePagination(totalPages) {
            const pagination = document.getElementById('pagination');
            pagination.innerHTML = '';

            const prevButton = document.createElement('button');
            prevButton.innerHTML = '← Previous';
            prevButton.className = `px-3 py-1 mx-1 rounded text-sm ${currentPage === 1 ? 'bg-gray-200 text-gray-400 cursor-not-allowed' : 'bg-gray-600 text-white hover:bg-gray-900'}`;
            prevButton.disabled = currentPage === 1;
            prevButton.onclick = () => loadBookings(currentPage - 1);
            pagination.appendChild(prevButton);

            for (let i = 1; i <= totalPages; i++) {
                const pageButton = document.createElement('button');
                pageButton.innerHTML = i;
                pageButton.className = `px-3 py-1 mx-1 rounded text-sm ${i === currentPage ? 'bg-green-700 text-white' : 'bg-gray-200 text-gray-700 hover:bg-gray-300'}`;
                pageButton.onclick = () => loadBookings(i);
                pagination.appendChild(pageButton);
            }

            const nextButton = document.createElement('button');
            nextButton.innerHTML = 'Next →';
            nextButton.className = `px-3 py-1 mx-1 rounded text-sm ${currentPage === totalPages ? 'bg-gray-200 text-gray-400 cursor-not-allowed' : 'bg-gray-600 text-white hover:bg-gray-900'}`;
            nextButton.disabled = currentPage === totalPages;
            nextButton.onclick = () => loadBookings(currentPage + 1);
            pagination.appendChild(nextButton);
        }

        // Load initial bookings
        loadBookings();

        // Form submission
        bookingForm.addEventListener('submit', function (e) {
            e.preventDefault();

            if (!validateForm()) {  
                alert('Please fill in all required fields.');
                return;
            }

            const formData = new FormData(this);
            const startTime = formData.get('startTime');
            const endTime = formData.get('endTime');
            const date = formData.get('date');

            // Validate date is not before the current date
            const currentDate = new Date();
            const selectedDate = new Date(date);
            currentDate.setHours(0, 0, 0, 0);
            selectedDate.setHours(0, 0, 0, 0);

            if (selectedDate < currentDate) {
                document.getElementById('dateError').textContent = 'Selected date cannot be in the past.';
                document.getElementById('dateError').style.display = 'block';
                return;
            }

            // Validate start time is not before the current time if booking is for today
            const currentDateTime = new Date();
            const selectedDateTime = new Date(`${date}T${startTime}`);
            if (selectedDate.getTime() === currentDate.getTime() && selectedDateTime < currentDateTime) {
                document.getElementById('startTimeError').textContent = 'Start time cannot be in the past.';
                document.getElementById('startTimeError').style.display = 'block';
                return;
            }

            // Validate end time is at least 15 minutes after start time
            const startTimeDate = new Date(`2000-01-01T${startTime}`);
            const endTimeDate = new Date(`2000-01-01T${endTime}`);
            const timeDifference = (endTimeDate - startTimeDate) / (1000 * 60); // difference in minutes
            if (timeDifference < 15) {
                document.getElementById('endTimeError').textContent = 'End time must be at least 15 minutes after start time.';
                document.getElementById('endTimeError').style.display = 'block';
                return;
            }

            const data = {
                title: formData.get('title'),
                description: formData.get('description'),
                date: formData.get('date'),
                roomId: parseInt(formData.get('room')),
                startTime: formatTimeToTimeSpan(startTime),
                endTime: formatTimeToTimeSpan(endTime),
                recurring: formData.get('recurring') === 'true',
                recurrenceTypeId: formData.get('recurring') === 'true' ? parseInt(formData.get('RecurrenceTypeId')) || null : null,
                recurrenceEndDate: formData.get('recurring') === 'true' ? formData.get('recurrenceEndDate') : null,
                userId: getCurrentUserId()
            };

            if (this.dataset.mode === 'edit') {
                data.id = parseInt(this.dataset.bookingId);
            }

            const submitButton = this.querySelector('button[type="submit"]');
            submitButton.disabled = true;
            submitButton.textContent = 'Submitting...';

            const url = this.dataset.mode === 'edit'
                ? `/api/Booking/${this.dataset.bookingId}`
                : '/api/Booking/create';
            const method = this.dataset.mode === 'edit' ? 'PUT' : 'POST';

            fetch(url, {
                method: method,
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(data)
            })
                .then(response => {
                    if (!response.ok) {
                        return response.json().then(err => { throw err; });
                    }
                    return response.json();
                })
                .then(result => {
                    console.log('Booking ' + (this.dataset.mode === 'edit' ? 'updated' : 'created') + ':', result);
                    modal.style.display = "none";
                    loadBookings(); // This will refresh the entire table
                    bookingForm.reset();

                    // Reset form mode and submit button text
                    this.dataset.mode = 'create';
                    delete this.dataset.bookingId;
                    submitButton.textContent = 'Create Booking';

                    // Add success alert
                    if (method === 'POST') {
                        alert('Booking created successfully!');
                    } else {
                        alert('Booking updated successfully!');
                    }
                })
                .catch(error => {
                    console.error('Error ' + (this.dataset.mode === 'edit' ? 'updating' : 'creating') + ' booking:', error);
                    let errorMessage = 'An error occurred while ' + (this.dataset.mode === 'edit' ? 'updating' : 'creating') + ' the booking. Please try again.';
                    if (error.errors) {
                        errorMessage += '\n\nDetails:\n' + JSON.stringify(error.errors, null, 2);
                    }
                    alert(errorMessage);
                })
                .finally(() => {
                    submitButton.disabled = false;
                    submitButton.textContent = this.dataset.mode === 'edit' ? 'Update Booking' : 'Create Booking';
                });
        });

        function convertTimeToMinutes(time) {
            const [hours, minutes] = time.split(':').map(Number);
            return hours * 60 + minutes;
        }

        //15 minute interval for auto fill end time
        function getNearestFuture15MinInterval(date) {
            const minutes = date.getMinutes();
            const roundedMinutes = Math.ceil(minutes / 15) * 15;
            const newDate = new Date(date);
            newDate.setMinutes(roundedMinutes);
            newDate.setSeconds(0);
            newDate.setMilliseconds(0);
            return newDate;
        }

        //set initial values for start and end time
        document.getElementById('startTime').addEventListener('change', function () {
            const startTime = new Date(`2000-01-01T${this.value}`);
            const endTime = new Date(`2000-01-01T${document.getElementById('endTime').value}`);

            if (endTime <= startTime) {
                const newEndTime = new Date(startTime.getTime() + 15 * 60000);
                document.getElementById('endTime').value = newEndTime.toTimeString().substring(0, 5);
            }
        });

         //start time and end time validation
        document.getElementById('startTime').addEventListener('change', validateTimes);
        document.getElementById('endTime').addEventListener('change', validateTimes);
        document.getElementById('date').addEventListener('change', validateTimes);

        function validateTimes() {
            validateStartTime();
            validateEndTime();
        }

        function validateStartTime() {
            const startTimeSelect = document.getElementById('startTime');
            const dateInput = document.getElementById('date');
            const errorElement = document.getElementById('startTimeError');

            const selectedDate = new Date(dateInput.value);
            const selectedTime = startTimeSelect.value;
            const selectedDateTime = new Date(`${selectedDate.toDateString()} ${selectedTime}`);
            const currentDateTime = new Date();

            if (selectedDateTime < currentDateTime) {
                errorElement.textContent = 'Start time cannot be in the past.';
                errorElement.style.display = 'block';
                startTimeSelect.setCustomValidity('Invalid start time');
            } else {
                errorElement.textContent = '';
                errorElement.style.display = 'none';
                startTimeSelect.setCustomValidity('');
            }
        }

        function validateEndTime() {
            const startTimeSelect = document.getElementById('startTime');
            const endTimeSelect = document.getElementById('endTime');
            const errorElement = document.getElementById('endTimeError');

            const startTime = new Date(`2000-01-01T${startTimeSelect.value}`);
            const endTime = new Date(`2000-01-01T${endTimeSelect.value}`);

            const timeDifference = (endTime - startTime) / (1000 * 60); // difference in minutes

            if (timeDifference < 15) {
                errorElement.textContent = 'End time must be at least 15 minutes after start time.';
                errorElement.style.display = 'block';
                endTimeSelect.setCustomValidity('Invalid end time');
            } else {
                errorElement.textContent = '';
                errorElement.style.display = 'none';
                endTimeSelect.setCustomValidity('');
            }
        }


        //date validation
        document.getElementById('date').addEventListener('change', validateDate);

        function validateDate() {
            const dateInput = document.getElementById('date');
            const errorElement = document.getElementById('dateError');
            const selectedDate = new Date(dateInput.value);
            const currentDate = new Date();

            // Set both dates to midnight for accurate comparison
            selectedDate.setHours(0, 0, 0, 0);
            currentDate.setHours(0, 0, 0, 0);

            if (selectedDate < currentDate) {
                errorElement.textContent = 'Selected date cannot be in the past.';
                errorElement.style.display = 'block';
                dateInput.setCustomValidity('Invalid date');
            } else {
                errorElement.textContent = '';
                errorElement.style.display = 'none';
                dateInput.setCustomValidity('');
            }
        }

        // Function to edit booking
        function editBooking(bookingId) {
            fetch(`/api/Booking/${bookingId}`)
                .then(response => response.json())
                .then(booking => {
                    // Populate the form with booking details
                    document.getElementById('title').value = booking.title;
                    document.getElementById('description').value = booking.description;
                    document.getElementById('date').value = booking.date.split('T')[0];
                    document.getElementById('room').value = booking.roomId;
                    document.getElementById('startTime').value = booking.startTime;
                    document.getElementById('endTime').value = booking.endTime;
                    document.getElementById('recurring').value = booking.recurring ? 'true' : 'false';

                    if (booking.recurring) {
                        document.getElementById('recurrenceOptions').style.display = 'block';
                        document.getElementById('RecurrenceTypeId').value = booking.recurrenceTypeId;
                        document.getElementById('recurrenceEndDate').value = booking.recurrenceEndDate.split('T')[0];
                    }

                    // Change form submission to update instead of create
                    const form = document.getElementById('bookingForm');
                    form.dataset.mode = 'edit';
                    form.dataset.bookingId = bookingId;

                    // Change submit button text to 'Update Booking'
                    const submitButton = form.querySelector('button[type="submit"]');
                    submitButton.textContent = 'Update Booking';

                    // Show the modal
                    document.getElementById('addBookingModal').style.display = 'block';
                })
                .catch(error => console.error('Error fetching booking details:', error));
        }

        function showBookingDetails(bookingId) {
            fetch(`/api/Booking/${bookingId}`)
                .then(response => response.json())
                .then(booking => {
                    const modal = document.getElementById('bookingDetailsModal');
                    const content = document.getElementById('bookingDetailsContent');
                    content.innerHTML = `
                        <p><strong>Meeting Title:</strong> ${booking.title}</p>
                        <p><strong>Meeting Description:</strong> ${booking.description}</p>
                        <p><strong>Date:</strong> ${new Date(booking.date).toLocaleDateString()}</p>
                        <p><strong>Time:</strong> ${booking.startTime} - ${booking.endTime}</p>
                        <p><strong>Room:</strong> ${booking.roomName}</p>
                        <p><strong>Recurring:</strong> ${booking.recurring ? 'Yes' : 'No'}</p>
                        ${booking.recurring ? `
                            <p><strong>Recurrence Type:</strong> ${recurrenceTypes[booking.recurrenceTypeId]}</p>
                            <p><strong>Recurrence End Date:</strong> ${new Date(booking.recurrenceEndDate).toLocaleDateString()}</p>
                        ` : ''}
                    `;
                    modal.style.display = 'block';
                })
                .catch(error => console.error('Error fetching booking details:', error));
        }

        document.getElementById('closeModalBtn').onclick = function () {
            document.getElementById('bookingDetailsModal').style.display = 'none';
        }

        function cancelBooking(bookingId) {
            if (confirm('Are you sure you want to cancel this booking?')) {
                fetch(`/api/Booking/${bookingId}`, { method: 'DELETE' })
                    .then(response => {
                        if (response.ok) {
                            // Remove the row from the table
                            const row = document.querySelector(`button[data-id="${bookingId}"]`).closest('tr');
                            row.remove();
                            alert('Booking cancelled successfully');
                        } else {
                            throw new Error('Failed to cancel booking');
                        }
                    })
                    .catch(error => {
                        console.error('Error cancelling booking:', error);
                        alert('Failed to cancel booking. Please try again.');
                    });
            }
        }

        // pag open/close sa modal
        var modal = document.getElementById("addBookingModal");
        var btn = document.querySelector(".book-now button");
        var span = document.getElementsByClassName("close")[0];

        btn.onclick = function () {
            modal.style.display = "block";
            bookingForm.reset(); // reset form

            // Get the nearest future 15-minute interval
            const now = new Date();
            const startTime = getNearestFuture15MinInterval(now);

            // Set end time to 15 minutes after start time
            const endTime = new Date(startTime.getTime() + 15 * 60000);

            // Format times for the select inputs
            const formatTimeForSelect = (date) => {
                return date.toTimeString().substring(0, 5);
            };

            // Set the start and end time in the form
            document.getElementById('startTime').value = formatTimeForSelect(startTime);
            document.getElementById('endTime').value = formatTimeForSelect(endTime);
        }

        span.onclick = function () {
            modal.style.display = "none";
        }

        window.onclick = function (event) {
            if (event.target == modal) {
                modal.style.display = "none";
            }
        }

        // Show/hide recurrence options
        document.getElementById('recurring').addEventListener('change', function () {
            const isRecurring = this.value === 'true';
            document.getElementById('recurrenceOptions').style.display = isRecurring ? 'flex' : 'none';
            if (!isRecurring) {
                document.getElementById('RecurrenceTypeId').value = '';
                document.getElementById('recurrenceEndDate').value = '';
                document.getElementById('weeklyOptions').style.display = 'none';
                document.getElementById('day - selector').value = '';
            }
        });

        // Show/hide weekly and monthly options
        document.getElementById('RecurrenceTypeId').addEventListener('change', function () {
            const selectedType = this.options[this.selectedIndex].text;
            document.getElementById('weeklyOptions').style.display = selectedType === 'Weekly' ? 'block' : 'none';
        });

        // Day selection functionality
        document.querySelectorAll('.day-selector .day').forEach(function (day) {
            day.addEventListener('click', function () {
                this.classList.toggle('selected');
            });
        });

        // reset function
        document.querySelector('.reset-button').addEventListener('click', function () {
            document.getElementById('recurrenceOptions').style.display = 'none';
            document.getElementById('RecurrenceTypeId').value = '';
            document.getElementById('recurrenceEndDate').value = '';
            document.getElementById('weeklyOptions').style.display = 'none';
            document.querySelectorAll('.day-selector .day').forEach(function (day) {
                day.classList.remove('selected');
            });
        });

        // get current user ID (to be implemented)
        function getCurrentUserId() {
            return 1; // Placeholder value for now
        }
    });

    function searchFilterBookings() {
        var input, filter, table, tr, td, i, j, txtValue;
        input = document.getElementById("searchBookingsBar");
        filter = input.value.toUpperCase();
        table = document.getElementById("bookingsTable");
        tr = table.getElementsByTagName("tr");

        for (i = 1; i < tr.length; i++) { // Start from 1 to skip the header row
            let rowContainsFilter = false;
            for (j = 0; j < 4; j++) { // Check the first four columns
                td = tr[i].getElementsByTagName("td")[j];
                if (td) {
                    txtValue = (td.textContent || td.innerText).toUpperCase();
                    if (txtValue.indexOf(filter) > -1) {
                        rowContainsFilter = true;
                        break;
                    }
                }
            }
            if (rowContainsFilter) {
                tr[i].style.display = "";
            } else {
                tr[i].style.display = "none";
            }
        }
    }

    function toggleDropdownBookings() {
        document.getElementById('bookingsDropdown').classList.toggle('show');
        console.log("buttons pressed...");
    }

    function filterByRoom(bookingsRoom) {
        const filter = room[bookingsRoom];
        const table = document.getElementById('bookingsTable');
        const tr = table.getElementsByTagName('tr');
