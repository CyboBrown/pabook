<script>
    var roomTypes = ["Unassigned", "Board Room", "Conference Room", "Meeting Room", "Multipurpose Room", "Recruitment Room", "Training Room"];
    var locations = [];

    document.addEventListener("DOMContentLoaded", function () {
        function populateLocationsDropdown() {
            $.ajax({
                url: '/api/Room/locations',
                type: 'GET',
                success: function (data) {
                    console.log('Fetched locations data:', data); // Debugging statement
                    var dropdown = $('#location');
                    var roomDropdown = $('#roomDropdown');
                    dropdown.empty();
                    roomDropdown.empty();

                    dropdown.append($('<option></option>').val('').text('Select location'));
                    data.forEach((location, index) => {
                        console.log('Processing location:', location); // Debugging statement
                        if (location && typeof location.name === 'string' && location.name.trim() !== '' && typeof location.id === 'number' && location.id >= 0) {
                            locations.push(location.name);
                            dropdown.append($('<option></option>').val(location.id).text(location.name));
                            roomDropdown.append($('<a></a>').attr('onclick', `filterByLocation('${location.name}')`).text(location.name));
                        } else {
                            console.warn('Invalid location data:', location); // Warning for invalid data
                        }
                    });

                    roomDropdown.append($('<a></a>').attr('onclick', 'showAllLocations()').text('Show All'));
                },
                error: function (error) {
                    console.log('Error fetching locations:', error);
                }
            });
        }

        $(document).ready(function () {
            populateLocationsDropdown();
        });

        function validateForm() {
            const requiredFields = roomForm.querySelectorAll('[required]');
            let isValid = true;
            requiredFields.forEach(field => {
                if (!field.value.trim()) {
                    isValid = false;
                    field.classList.add('invalid');
                } else {
                    field.classList.remove('invalid');
                }
            });
            return isValid;
        }

        const roomForm = document.getElementById('roomForm');
        const submitButton = roomForm.querySelector('button[type="submit"]');

        let currentPage = 1;
        const itemsPerPage = 5;

        function loadRooms(page = 1) {
            fetch('/api/Room/rooms')
                .then(response => {
                    if (!response.ok) {
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }
                    return response.json();
                })
                .then(data => {
                    const totalItems = data.length;
                    const totalPages = Math.ceil(totalItems / itemsPerPage);
                    currentPage = page;

                    const startIndex = (currentPage - 1) * itemsPerPage;
                    const endIndex = startIndex + itemsPerPage;
                    const currentItems = data.slice(startIndex, endIndex);

                    const tableBody = document.getElementById('roomsTableBody');
                    tableBody.innerHTML = '';
                    currentItems.forEach(room => {
