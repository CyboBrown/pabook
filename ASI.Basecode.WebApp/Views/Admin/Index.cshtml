@model ASI.Basecode.Services.ServiceModels.AdminHomeViewModel
<link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
<link href="https://unpkg.com/flowbite@1.4.7/dist/flowbite.min.css" rel="stylesheet">
<link rel="stylesheet" href="~/css/admin.css" />
<link rel="stylesheet" href="~/css/admindark.css" />
@{
    ViewData["Title"] = "Admin Home Page";
}

@*Home Page*@
<div class="outer-container">
    <div class="main-content">
        <div class="header">
            <div id="bookingsTab" class="tab active" onclick="switchTab('bookings')">
                <i class="fas fa-calendar-alt"></i>
                <span>Bookings</span>
            </div>
            <div id="usersTab" class="tab" onclick="switchTab('users')">
                <i class="fas fa-users"></i>
                <span>Users</span>
            </div>
            <div id="roomsTab" class="tab" onclick="switchTab('rooms')">
                <i class="fas fa-door-open"></i>
                <span>Rooms</span>
            </div>
        </div>
        @*Bookings View*@
        <div id="bookingsContent" class="content flex">
           <div class="container mx-auto p-4 bg-gray-100" style="height: 79vh; display: flex; flex-direction: column; justify-content: space-between;">
                <h2 class="text-3xl font-bold mb-4 text-gray-800">B O O K I N G S</h2>
                <div class="flex flex-col sm:flex-row justify-between items-center mb-6 space-y-4 sm:space-y-0">
                    <input type="text" id="searchBookingsBar" class="w-full sm:w-2/3 p-2 mr-2 border border-gray-300 rounded-md shadow-sm focus:ring-2 focus:ring-blue-400 focus:border-blue-400" onkeyup="searchFilterBookings()" placeholder="Search bookings...">
                    <div class="flex space-x-2">
                        <input type="date" id="filterDate" name="date" class="w-50 px-4 py-2 text-sm text-black">
                        <button id="filterBookingsButton" class="w-20 px-4 py-2 text-sm text-white font-bold bg-blue-600 rounded-md flex items-center justify-center hover:bg-blue-700 transition duration-300 ease-in-out" onclick="toggleDropdownBookings()">
                            <i class="fas fa-filter mr-2"></i>
                            Filter
                        </button>
                        <div id="bookingsDropdown" class="dropdown-content">
                        </div>
                        <div class="book-now flex-grow">
                            <button id="addBookingButton" class="w-20 px-4 py-2 text-sm text-white font-bold rounded-md flex items-center justify-center hover:bg-red-700 transition duration-300 ease-in-out" style="background-color: #91DDCF;">
                                <i class="fas fa-plus mr-2"></i>
                                Add
                            </button>
                        </div>
                    
                    </div>
                </div>
                <div class="bg-white shadow-lg rounded-lg flex-grow" style="overflow-y: auto;">
                     <div class="table-container" style="overflow-x: auto;">
                        <table id="bookingsTable" class="min-w-full max-w-full divide-y divide-gray-200">
                            <thead class="bg-gray-50">
                                <tr>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Booking Name</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date & Time</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Room</th>
                                    <th class="px-2 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Recurring</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="bookingsTableBody" class="bg-white divide-y divide-gray-200">
                                <!-- Bookings will be displayed here -->
                            </tbody>
                        </table>
                    </div>
                </div>
                <div id="paginationContainer" class="flex justify-center items-center py-1" style="margin-top: 0.5rem;">
                    <div id="pagination" class="flex justify-center items-center">
                        <!-- Pagination will be dynamically generated here -->
                    </div>
                </div>
            </div>
        </div>
        @*User View*@
        <div id="usersContent" class="content hidden">
            <div class="container mx-auto p-4 bg-gray-100 flex flex-col" style="height: 79vh;">
                <h2 class="text-3xl font-bold mb-4 text-gray-800">U S E R S</h2>
                <div class="flex flex-col sm:flex-row justify-between items-center mb-6 space-y-4 sm:space-y-0">
                    <input type="text" id="searchUserBar" class="w-full sm:w-2/3 p-2 mr-2 border border-gray-300 rounded-md shadow-sm focus:ring-2 focus:ring-blue-400 focus:border-blue-400" onkeyup="searchFilterUser()" placeholder="Search users...">
                    <div id="dropdown" class="flex space-x-2">
                        <button id="filterUsersButton" class="w-20 px-4 py-2 text-sm text-white font-bold rounded-md flex items-center justify-center hover:bg-blue-700 transition duration-300 ease-in-out" style="background-color: #4D869C;" onclick="toggleDropdownUsers()">
                            <i class="fas fa-filter mr-2"></i>
                            Filter
                        </button>
                        <div id="roleDropdown" class="dropdown-content">
                            <a onclick="filterByRole(0)">Admins</a>
                            <a onclick="filterByRole(1)">Managers</a>
                            <a onclick="filterByRole(2)">Users</a>
                            <a onclick="showAllRoles()">Show All</a>
                        </div>
                        <button id="addUserButton" class="w-20 px-4 py-2 text-sm text-white font-bold rounded-md flex items-center justify-center hover:bg-red-700 transition duration-300 ease-in-out" style="background-color: #91DDCF;">
                                <i class="fas fa-plus mr-2"></i>
                                Add
                        </button>
                    </div>
                </div>
                <div class="bg-white shadow-lg rounded-lg flex-grow overflow-hidden">
                    <div class="table-container" style="overflow-x: auto; max-height: calc(79vh - 10rem);">
                        <table id="userTable" class="min-w-full max-w-full divide-y divide-gray-200">
                            <thead class="bg-gray-50">
                                <tr>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Username</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Last Name</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">First Name</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Email</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Role</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="usersTableBody" class="bg-white divide-y divide-gray-200">
                                <!-- User data goes here -->
                            </tbody>
                        </table>
                    </div>
                </div>
                <div id="userPaginationContainer" class="flex justify-center items-center py-1" style="margin-top: 0.5rem;">
                    <div id="userPagination" class="flex justify-center items-center">
                        <!-- Pagination will be dynamically generated here -->
                    </div>
                </div>
            </div>
        </div>
        @*Room View*@
        <div id="roomsContent" class="content hidden">
            <div class="container mx-auto p-4 bg-gray-100 flex flex-col" style="height: 79vh;">
                <h2 class="text-3xl font-bold mb-4 text-gray-800">R O O M S</h2>
                <div class="flex flex-col sm:flex-row justify-between items-center mb-6 space-y-4 sm:space-y-0">
                    <input type="text" id="searchRoomsBar" class="w-full sm:w-2/3 p-2 mr-2 border border-gray-300 rounded-md shadow-sm focus:ring-2 focus:ring-blue-400 focus:border-blue-400" onkeyup="searchFilterRooms()" placeholder="Search rooms...">
                    <div class="flex space-x-2">                    
                        <button id="filterRoomsButton" class="w-20 px-4 py-2 text-sm text-white font-bold rounded-md flex items-center justify-center hover:bg-blue-700 transition duration-300 ease-in-out" style="background-color: #4D869C;" onclick="toggleDropdownRoom()">
                            <i class="fas fa-filter mr-2"></i>
                            Filter
                        </button>
                        <div id="roomDropdown" class="dropdown-content">
                        </div>
                        <button id="addRoomButton" class="w-20 px-4 py-2 text-sm text-white font-bold rounded-md flex items-center justify-center hover:bg-red-700 transition duration-300 ease-in-out" style="background-color: #91DDCF;">
                                <i class="fas fa-plus mr-2"></i>
                                Add
                        </button>
                    </div>
                </div>
                <div class="bg-white shadow-lg rounded-lg flex-grow overflow-hidden">
                    <div class="table-container" style="overflow-x: auto; max-height: calc(79vh - 10rem);">
                        <table id="roomTable" class="min-w-full max-w-full divide-y divide-gray-200">
                            <thead class="bg-gray-50">
                                <tr>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Room Name</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Room Type</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Capacity</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Location</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Facilities</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="roomsTableBody" class="bg-white divide-y divide-gray-200">
                                <!-- Room data goes here -->
                            </tbody>
                        </table>
                    </div>
                </div>
                <div id="roomPaginationContainer" class="flex justify-center items-center py-1" style="margin-top: 0.5rem;">
                    <div id="roomPagination" class="flex justify-center items-center">
                        <!-- Pagination will be dynamically generated here -->
                    </div>
                </div>
            </div>
        </div>

@*Add Booking Modal*@
