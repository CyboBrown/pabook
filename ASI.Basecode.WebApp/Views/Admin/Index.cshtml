            $.ajax({
                url: '@Url.Action("GetRoomDetailsByFloor", "Admin")',
                type: 'GET',
                data: { floor: floor },
                success: function (result) {
                    $('#room-details-body').html(result);
                },
                error: function () {
                    alert('Failed to load room details.');
                }
            });
        }

